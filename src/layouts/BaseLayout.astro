---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/" or "/guides/complete-batch-workflow"
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, ogType = 'website', jsonLd = [] } = Astro.props;

const site = 'https://www.sublimepantry.com';
const canonicalPath = path === '/' ? '/' : `${path.replace(/\/$/, '')}/`;
const canonical = new URL(canonicalPath, site).href;
const pageUrl = canonical;
const pageTitle = `${title} | Sublime Pantry`;

const organizationGraph = [
  {
    '@type': 'Organization',
    '@id': `${site}/#organization`,
    name: 'Sublime Pantry',
    url: `${site}/`,
    logo: `${site}/favicon.svg`,
    description:
      'Sublime Pantry publishes evidence-based educational content and free tools for home freeze-drying: machine decisions, batch troubleshooting, storage that lasts, and the economics and rules of selling freeze-dried food from home.',
  },
  {
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    url: `${site}/`,
    name: 'Sublime Pantry',
    description: 'Home freeze-drying, batch by batch.',
    publisher: { '@id': `${site}/#organization` },
  },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Sublime Pantry" href={`${site}/rss.xml`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Sublime Pantry" />
    <link rel="stylesheet" href="/styles/base.css" />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sublime Pantry -- Home freeze-drying, batch by batch" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": organizationGraph })} />
    {jsonLd.map((block) => <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />)}
    <script is:inline defer data-domain="www.sublimepantry.com" src="https://plausible.io/js/script.outbound-links.js"></script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header transition:persist />
    <main id="main" transition:animate="fade">
      <slot />
    </main>
    <Footer transition:persist />
    <script is:inline src="/events.js" defer></script>
    <script is:inline src="/header-nav.js" defer></script>
  </body>
</html>
