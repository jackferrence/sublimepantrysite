---
import { BRAND } from '../lib/media';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ShopifyStore from '../components/ShopifyStore.astro';
import { ogImagePath } from '../lib/og';
import { SUPPORT_EMAIL } from '../lib/paths';

interface Props {
  title: string;
  /**
   * The <title> tag, when it should differ from the on-page headline.
   *
   * Headlines here are written as editorial titles ("Freeze-drying eggs."),
   * which is right for an H1 and wrong for a search result: Search Console
   * showed page-one impressions with no clicks on exactly those pages. This
   * states the question the page answers, in the words a searcher uses. The H1,
   * Open Graph title and structured data keep `title`.
   */
  seoTitle?: string;
  description: string;
  path: string; // e.g. "/" or "/guides/complete-batch-workflow"
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  /** True on pages that must paint live Shopify prices (shop, product page). */
  commerce?: boolean;
  /**
   * Keep the page out of the index. Set on pages that exist only as the far
   * side of an interaction — a form confirmation — where a searcher landing
   * cold is stranded rather than served. Robots.txt disallows these too; the
   * meta tag is what removes one already indexed, since a crawler that cannot
   * fetch the page cannot read a directive inside it.
   */
  noindex?: boolean;
}

const { title, seoTitle, description, path, ogType = 'website', jsonLd = [], commerce = false, noindex = false } = Astro.props;

const site = 'https://www.sublimepantry.com';
// No trailing slash. The site builds with `trailingSlash: 'never'`, the sitemap
// lists `/about`, and Google reports every indexed URL in that form. The
// canonical used to say `/about/`, so each page named a different URL from the
// one the sitemap and the index agreed on.
const canonicalPath = path === '/' ? '/' : path.replace(/\/$/, '');
const canonical = new URL(canonicalPath, site).href;
const pageUrl = canonical;
// The brand suffix is dropped when it would push the tag past what a result
// shows (about 60 characters); a truncated question is worth less than the
// brand name, which the result's site line already carries.
const baseTitle = seoTitle ?? title;
const suffixed = `${baseTitle} | Sublime Pantry`;
const pageTitle = suffixed.length <= 60 ? suffixed : baseTitle;
const ogImage = new URL(ogImagePath(path), site).href;

const organizationGraph = [
  {
    '@type': 'Organization',
    '@id': `${site}/#organization`,
    name: 'Sublime Pantry',
    url: `${site}/`,
    logo: `${site}${BRAND.wordmark}`,
    // One contact route, and it is the same address the contact, shipping and
    // terms pages give a reader. An Organization that publishes a support
    // address it does not answer is worse than one that publishes none.
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: SUPPORT_EMAIL,
        availableLanguage: 'en',
      },
    ],
    // Deliberately empty: sameAs is an identity claim, and listing a profile we
    // do not actively maintain points the knowledge graph at a dead end. Fill
    // it the day a profile is real.
    sameAs: [],
    description:
      'Sublime Pantry publishes evidence-based educational content and free tools for home freeze-drying: machine decisions, batch troubleshooting, storage decisions, and the economics and rules of selling freeze-dried food from home.',
  },
  {
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    url: `${site}/`,
    name: 'Sublime Pantry',
    description: 'Home freeze-drying, batch by batch.',
    publisher: { '@id': `${site}/#organization` },
  },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={BRAND.appIcon} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FAF8F4" />
    <link rel="alternate" type="application/rss+xml" title="Sublime Pantry" href={`${site}/rss.xml`} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Sublime Pantry" />
    <link rel="preload" href="/fonts/source-sans-3-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles/base.css" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — Sublime Pantry`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": organizationGraph })} />
    {jsonLd.map((block) => <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />)}
    <script is:inline defer data-domain="www.sublimepantry.com" src="https://plausible.io/js/script.outbound-links.js"></script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header transition:persist />
    <main id="main" data-pagefind-body transition:animate="fade">
      <slot />
    </main>
    <Footer transition:persist />
    <ShopifyStore eager={commerce} />
    <CartDrawer />
    <script is:inline src="/events.js" defer></script>
    <script is:inline src="/header-nav.js" defer></script>
  </body>
</html>
