---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Byline from '../components/Byline.astro';
import Img from '../components/Img.astro';
import EducationalNotice from '../components/EducationalNotice.astro';
import ToolsMentioned from '../components/ToolsMentioned.astro';
import AuthorBio from '../components/AuthorBio.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import Newsletter from '../components/Newsletter.astro';
import EditorialToolLink from '../components/EditorialToolLink.astro';
import { CATALOG } from '../lib/commerce';
import { PILLAR_LABEL, withToc, polishTables, expandGeneratedBlocks, verifiedDate, nextCheckDate, formatDate, heroImage, type Article } from '../lib/articles';
import { recipeJsonLd } from '../lib/schema';

interface Props {
  entry: Article;
  path: string;
}

const { entry, path } = Astro.props;
const d = entry.data;
const site = 'https://www.sublimepantry.com';

const publishedIso = `${d.publishedDate}T00:00:00.000Z`;
const updatedIso = d.updatedDate ? `${d.updatedDate}T00:00:00.000Z` : publishedIso;
const canonicalPath = `${path.replace(/\/$/, '')}/`;
const pageUrl = new URL(canonicalPath, site).href;

// The hero slot names the photograph it is waiting for; `heroImage` resolves
// it — through the asset library when the article names an `assetId`, against
// public/ for a legacy path. Rendering an <img> for a file that does not exist
// puts a broken-image glyph at the top of the page, so the slot stays dark
// until the photograph lands and then lights up with no code change.
const hero = heroImage(entry);


const { html: tocHtml, toc } = withToc(d.bodyHtml);
const bodyHtml = polishTables(expandGeneratedBlocks(tocHtml));

/**
 * Split the body at the first <h2> so the signup can sit after the first
 * answer rather than only at the bottom of the page.
 *
 * Newsletter is the site's declared primary action, and it currently appears
 * once, below Related articles, where a reader who got their answer in the
 * opening section has already left. This puts one invitation directly after
 * that opening section.
 *
 * It is a link to the checklist, not a second copy of the form: Newsletter
 * renders `id="newsletter-email"` in its full variant, so a second non-compact
 * instance on the same page would duplicate an element id and give the label a
 * second target. One form per page, one prompt pointing at it.
 */
const firstH2 = bodyHtml.search(/<h2[\s>]/);
const bodyOpening = firstH2 > 0 ? bodyHtml.slice(0, firstH2) : bodyHtml;
const bodyRest = firstH2 > 0 ? bodyHtml.slice(firstH2) : '';

// Ownership disclosure is generated, not typed. If the article references a
// product we sell, the disclosure says so first — in the article, next to the
// mention, rather than only on a policy page.
const mentionedProducts = CATALOG.filter(
  (p) =>
    (d.products ?? []).includes(p.handle) ||
    bodyHtml.includes(p.handle) ||
    (p.detailsHref ? bodyHtml.includes(p.detailsHref) : false)
);
const ownership = mentionedProducts.length
  ? `Sold by Sublime Pantry: ${mentionedProducts.map((p) => p.title).join('; ')}. `
  : '';

const TOOL_PLACEMENTS: ReadonlyArray<{ match: RegExp; href: string; context: string }> = [
  { match: /(oxygen-absorbers-cc|mylar-absorber-myths|storage-containers|storage-failure)/, href: '/tools/absorber-calculator', context: 'Size the absorber from the published container guidance, with disagreements and missing figures left visible.' },
  { match: /(first-five-batches|complete-batch-workflow|which-freeze-dryer|home-freeze-dryers)/, href: '/tools/batch-planner', context: 'Turn a fresh load into published yield, tray and machine-capacity ranges without filling the gaps with estimates.' },
  { match: /(what-it-costs-to-run-a-freeze-dryer|which-freeze-dryer|home-freeze-dryers|cottage-economics)/, href: '/tools/running-cost', context: 'Use the checkable kilowatt-hour figure and your electricity rate to see the arithmetic for a cycle.' },
  { match: /(three-day-trail-menu|week-of-trail-meals-cost|backpack-food-survival|trail-meal-water)/, href: '/tools/trail-meal-cost', context: 'Compare your meal cost and calories with dated commercial pouch prices; measured yield stays your input.' },
];
const featuredTools = TOOL_PLACEMENTS.filter((placement) => placement.match.test(path)).slice(0, 2);

const crumbs = [
  { label: 'Home', href: '/' },
  { label: PILLAR_LABEL[d.pillar], href: `/${d.pillar}` },
  { label: d.title, href: path },
];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    author: { '@type': 'Person', name: d.author, url: `${site}/about/` },
    publisher: { '@id': `${site}/#organization` },
    datePublished: publishedIso,
    dateModified: updatedIso,
    mainEntityOfPage: pageUrl,
    ...(hero ? { image: [new URL(hero.src, site).href] } : {}),
  },
];

// A recipe's steps belong to the Recipe as recipeInstructions. Emitting a
// second, standalone HowTo for the same steps describes one procedure twice
// under two types, which is duplicative markup rather than richer markup.
if (d.pillar !== 'recipes' && d.howTo && d.howTo.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: d.title,
    description: d.description,
    mainEntityOfPage: pageUrl,
    step: d.howTo.map((s) => ({ '@type': 'HowToStep', name: s.name, text: s.text })),
  });
}

if (d.faq && d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}

if (d.pillar === 'recipes') {
  const recipe = recipeJsonLd({ ...d, image: hero ? { src: hero.src } : undefined }, { site, pageUrl, publishedIso });
  if (recipe) jsonLd.push(recipe);
}

if (d.pillar === 'compare' && d.comparisonCriteria) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: d.title,
    description: d.description,
    url: pageUrl,
    isPartOf: { '@id': `${site}/#website` },
  });
}
---
<BaseLayout title={d.title} description={d.description} path={path} ogType="article" jsonLd={jsonLd}>
  <article class="article">
    <div class="wrap"><div class="article-head">
      <Breadcrumbs items={crumbs} />
      <span class="kicker">{d.section ?? d.kicker}</span>
      <h1 transition:name={`sp-title-${entry.id}`}>{d.title}</h1>
      <Byline author={d.author} publishedDate={d.publishedDate} updatedDate={d.updatedDate} />
    </div></div>

    {hero && (
      <figure class="article-hero wrap">
        <Img
          src={hero.src}
          srcset={hero.srcSet}
          alt={hero.alt}
          width={hero.width}
          height={hero.height}
          sizes="(min-width: 1200px) 72rem, 100vw"
          loading="eager"
          fetchpriority="high"
          class="article-hero-img"
        />
        {hero.credit && <figcaption>{hero.credit}</figcaption>}
      </figure>
    )}

    <div class="wrap article-columns">
      <div class="article-main">
        {/* "Figures verified", not "Prices verified": the badge appears on every
            comparison, and the food-group comparison quotes cycle times and water
            activity without a single price. The promise is that the article's
            figures were re-checked against their sources on that date — which is
            true of a price, a cycle time, and a cost per unit alike. */}
        {d.pillar === 'compare' && verifiedDate(entry) && (
          <p class="verified-badge">
            Figures verified {formatDate(verifiedDate(entry)!)} · Next check {formatDate(nextCheckDate(entry)!)}
          </p>
        )}

        {d.riskClass === 'elevated' && <EducationalNotice />}

        <div class="article-body" set:html={bodyOpening} />

        {featuredTools.map((placement) => (
          <EditorialToolLink href={placement.href} context={placement.context} />
        ))}

        {bodyRest && (
          <aside class="inline-signup" aria-labelledby="inline-signup-heading">
            <p id="inline-signup-heading" class="inline-signup-title">Keep this beside the machine.</p>
            <p>The free Starter Checklist covers the checks above in one printable page, and
            <strong>The Dry Batch</strong> sends one of these answers a week.</p>
            <a class="btn btn-secondary" href="/freeze-drying-starter-checklist" data-sp-event="article_inline_signup_click">Get the free checklist</a>
          </aside>
        )}

        <div class="article-body" set:html={bodyRest} />

        <ToolsMentioned bodyHtml={bodyHtml} />

        <p class="disclosure-line">{ownership}{d.disclosure}</p>

        {d.faq && d.faq.length > 0 && (
          <section class="article-faq" aria-labelledby="faq-heading">
            <h2 id="faq-heading">Common questions</h2>
            {d.faq.map((f) => (
              <details>
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </section>
        )}

        <section class="sources" aria-labelledby="sources-heading">
          <h2 id="sources-heading">Sources</h2>
          <ol>
            {d.sources.map((s) => (
              <li>
                <a href={s.url} rel="nofollow noopener">{s.title}</a> — {s.publisher} <span class="tier-tag">{s.tier}</span> · accessed {s.accessDate}
              </li>
            ))}
          </ol>
        </section>

        <AuthorBio author={d.author} />
      </div>

      {toc.length > 1 && (
        <aside class="article-toc" aria-labelledby="toc-heading">
          <nav aria-labelledby="toc-heading">
            <h2 id="toc-heading" class="toc-heading">On this page</h2>
            <ol>
              {toc.map((item) => (
                <li><a href={`#${item.id}`}>{item.text}</a></li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>

    <div class="wrap">
      <RelatedArticles entry={entry} />
    </div>

    <div class="wrap"><div class="article-measure">
      <Newsletter />
    </div></div>
  </article>
</BaseLayout>

<script>
  /*
   * Reveal the "Scrolls sideways." cue only where a region actually scrolls.
   *
   * `polishTables` ships every cue `hidden`, because whether a table overflows
   * depends on the viewport and on the reader's text size — the buying guide's
   * eleven columns always overflow, the two-row cost table never does, and the
   * card-bearing tables are not in the document at all below 44rem. A cue
   * printed unconditionally would be wrong on some page at some width, which is
   * the same class of unverifiable claim the rest of this work is removing.
   *
   * Re-run on resize and on zoom, both of which change the answer.
   */
  const cued = () => {
    for (const cue of document.querySelectorAll<HTMLElement>('.table-cue')) {
      const region = cue.previousElementSibling;
      // A region replaced by cards is `display: none`, so both widths are 0
      // and the same comparison hides its cue.
      cue.hidden = !(region instanceof HTMLElement)
        || region.scrollWidth <= region.clientWidth + 1;
    }
  };
  cued();
  addEventListener('resize', cued, { passive: true });
</script>


<style>
  .article { padding-top: var(--s4); }
  /* The head, the body column and the newsletter all share one left edge and
     one measure, so nothing shifts as the reader scrolls down the page. */
  .article-head, .article-measure { max-width: var(--measure); }
  .article-head h1 { margin-bottom: 0; }

  .article-hero { margin: 0 auto var(--s4); }
  .article-hero :global(.article-hero-img) {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
    border-radius: var(--radius); display: block;
  }

  .article-columns { display: block; }
  .article-main { max-width: var(--measure); }

  @media (min-width: 960px) {
    .article-columns {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) minmax(14rem, 1fr);
      gap: var(--s6);
      align-items: start;
    }
  }

  .article-toc { display: none; }
  @media (min-width: 960px) {
    .article-toc { display: block; position: sticky; top: var(--s7); }
  }
  .toc-heading {
    font-family: var(--font-body); font-size: var(--kicker); font-weight: 600;
    text-transform: uppercase; letter-spacing: .08em; color: var(--brand);
    margin: 0 0 var(--s1);
  }
  .article-toc ol { list-style: none; margin: 0; padding: 0; }
  .article-toc li { margin: 0; border-top: 1px solid var(--mist); }
  .article-toc a {
    display: block; padding: .45rem 0;
    font-size: .9rem; color: var(--ink-soft); text-decoration: none;
  }
  .article-toc a:hover { color: var(--brand); text-decoration: underline; }

  .verified-badge {
    display: inline-block;
    padding: .35rem .7rem;
    border-radius: var(--radius);
    background: var(--brand-tint);
    color: var(--ink);
    font-size: var(--kicker); font-weight: 600;
  }

  .article-faq details {
    border-top: 1px solid var(--mist);
    padding: var(--s2) 0;
  }
  .article-faq details:last-of-type { border-bottom: 1px solid var(--mist); }
  .article-faq summary {
    cursor: pointer; font-weight: 600;
    font-family: var(--font-display); font-size: 1.1rem;
  }
  .article-faq details p { margin: var(--s1) 0 0; color: var(--ink-soft); }

  /* The mid-article invitation. Quiet enough to read past: it interrupts the
     article once, so it earns its place by being skimmable, not loud. */
  .inline-signup {
    margin: var(--s4) 0;
    padding: var(--s3);
    border-left: 3px solid var(--brand);
    background: var(--brand-tint);
    border-radius: var(--radius);
    max-width: var(--measure);
  }
  .inline-signup-title { font-weight: 700; margin: 0 0 var(--s1); }
  .inline-signup p { margin: 0 0 var(--s2); }
  .inline-signup > :last-child { margin-bottom: 0; }

  .sources ol { font-size: .92rem; color: var(--ink-soft); }
  .tier-tag {
    display: inline-block; padding: .05rem .4rem; border-radius: var(--radius);
    background: var(--brand-tint); color: var(--ink);
    font-size: .72rem; text-transform: uppercase; letter-spacing: .06em;
  }
</style>
