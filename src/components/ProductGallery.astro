---
import type { ProductImage } from '../lib/commerce';
interface Props { images: ProductImage[]; productName: string; }
const { images, productName } = Astro.props;
---
{images.length ? (
  <section class="gallery" aria-label={`${productName} product images`} data-product-gallery>
    <div class="gallery-stage">
      {images.map((image, index) => (
        <figure id={`product-image-${index}`} class:list={['gallery-frame', { active: index === 0 }]}>
          <img src={image.src} alt={image.alt} width="800" height="800" loading={index ? 'lazy' : 'eager'} />
          {image.source === 'manufacturer' && <figcaption>Exact product media · Photo: manufacturer</figcaption>}
        </figure>
      ))}
    </div>
    {images.length > 1 && (
      <div class="gallery-thumbs" role="tablist" aria-label="Choose a product image">
        {images.map((image, index) => (
          <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={`product-image-${index}`} data-gallery-index={index}>
            <img src={image.src} alt="" width="72" height="72" loading="lazy" />
            <span class="sr-only">Show {image.kind} view</span>
          </button>
        ))}
      </div>
    )}
  </section>
) : (
  <div class="gallery-missing" role="note"><span class="kicker">Exact media pending</span><p>A verified image for this exact product is not available yet. We will not substitute a generic product photograph.</p></div>
)}
<script>
  document.querySelectorAll('[data-product-gallery]').forEach((gallery) => {
    const tabs = [...gallery.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const frames = [...gallery.querySelectorAll<HTMLElement>('.gallery-frame')];
    tabs.forEach((tab, index) => tab.addEventListener('click', () => {
      tabs.forEach((item, i) => item.setAttribute('aria-selected', String(i === index)));
      frames.forEach((frame, i) => frame.classList.toggle('active', i === index));
    }));
  });
</script>
<style>
  .gallery-stage { background: var(--color-semantic-warm); border-top: 1px solid var(--ink); }
  .gallery-frame { display: none; margin: 0; }
  .gallery-frame.active { display: block; }
  .gallery-frame img { display: block; width: 100%; aspect-ratio: 1; object-fit: contain; background: var(--surface); }
  figcaption { padding: .5rem 0; }
  .gallery-thumbs { display: flex; gap: var(--s1); margin-top: var(--s2); }
  .gallery-thumbs button { width: 72px; height: 72px; padding: 0; background: var(--surface); border: 1px solid var(--mist); border-radius: var(--radius-control); cursor: pointer; }
  .gallery-thumbs button[aria-selected="true"] { border: 2px solid var(--brand); }
  .gallery-thumbs img { width: 100%; height: 100%; object-fit: cover; }
  .gallery-missing { min-height: 24rem; display: grid; align-content: center; padding: var(--s4); background: var(--color-semantic-warm); border-block: 1px solid var(--ink); }
  .gallery-missing p { max-width: 34ch; color: var(--ink-soft); }
</style>
