---
/**
 * Inline Lucide icon. Always decorative unless `label` is given — an icon that
 * carries meaning gets an accessible name, one that repeats adjacent text does
 * not.
 */
import { iconBody, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
const body = iconBody(name);
---
<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>

<style>
  .icon { display: inline-block; vertical-align: -0.15em; flex: none; }
</style>
