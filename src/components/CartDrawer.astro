---
/**
 * The cart, on every page.
 *
 * Shopify's <shopify-cart> is a native <dialog>, so `showModal()` already gives
 * us a focus trap, Escape-to-close and inertness for the rest of the page —
 * reimplementing any of that would be strictly worse. What we add is the
 * presentation: `::part(dialog)` is restyled from a centred modal into a
 * right-hand drawer (a bottom sheet under 640px), and the `extension` slot
 * carries the two facts a buyer needs before they click through to checkout.
 *
 * The header trigger lives here too, so the count badge and the drawer stay in
 * one file.
 */
import Icon from './Icon.astro';
import { LAUNCH_OFFER, SHIPPING } from '../lib/commerce';

// The attribute is `discount-codes` (kebab-case). HTML lowercases attribute
// names, so a camelCase `discountCodes` renders as `discountcodes` and the
// component silently ignores it — the cart then opens at full price.
const cartDiscountCodes = LAUNCH_OFFER.enabled ? LAUNCH_OFFER.code : undefined;
---
<aside aria-label="Cart">
<shopify-cart id="sublime-cart" target="_top" discount-codes={cartDiscountCodes}>
  <div slot="empty">
    <p>Your cart is empty.</p>
    <p><a href="/shop">See the packaging catalog</a></p>
  </div>
  <div slot="extension" class="cart-extension">
    <p><Icon name="package" size={15} /> {SHIPPING.shortNote}</p>
    {LAUNCH_OFFER.enabled && (
      <p><Icon name="check-circle" size={15} /> Code {LAUNCH_OFFER.code} applied at checkout</p>
    )}
  </div>
</shopify-cart>
</aside>

<style is:global>
  /* The cart dialog, restyled from centred modal to edge drawer. */
  shopify-cart::part(dialog) {
    margin: 0 0 0 auto;
    max-width: min(26rem, 100%);
    width: 100%;
    height: 100%;
    max-height: 100%;
    border: 0;
    border-left: 1px solid var(--mist);
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    padding: var(--s3);
  }
  shopify-cart::part(primary-button) {
    background: var(--brand);
    color: var(--surface);
    border: 2px solid transparent;
    border-radius: var(--radius);
    min-height: 44px;
    font: 600 1rem var(--font-body);
    text-transform: none;
  }
  shopify-cart::part(secondary-button),
  shopify-cart::part(tertiary-button) {
    background: transparent;
    color: var(--ink);
    fill: var(--ink);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    min-height: 44px;
  }
  shopify-cart::part(discount-code) {
    border: 1px solid var(--mist);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
  }

  @media (max-width: 639px) {
    shopify-cart::part(dialog) {
      margin: auto 0 0;
      max-width: 100%;
      /* Not `height: auto`: the dialog is `position: fixed` with `top: 0` and
         an implicit `bottom: 0` from the UA's top-layer default, and a box
         positioned between two set insets stretches to fill the gap under
         `auto` regardless of content. `fit-content` forces intrinsic sizing
         instead, so a short cart gets a short sheet rather than a mostly
         empty one capped at max-height. */
      height: fit-content;
      max-height: 85dvh;
      border-left: 0;
      border-top: 1px solid var(--mist);
      border-radius: var(--radius) var(--radius) 0 0;
      padding-bottom: calc(var(--s3) + env(safe-area-inset-bottom));
    }
  }

  .cart-extension {
    margin-top: var(--s2);
    padding-top: var(--s2);
    border-top: 1px solid var(--mist);
    font-size: .9rem;
    color: var(--ink-soft);
  }
  .cart-extension p { display: flex; align-items: center; gap: .45rem; margin: 0 0 var(--s1); }
  .cart-extension p:last-child { margin-bottom: 0; }
</style>

<script>
  /**
   * Cart line count for the header badge.
   *
   * The Storefront components expose no count property, so we read the number
   * of line rows the cart renders. Where the component's shadow root is open we
   * can observe it directly; where it is not, we fall back to counting adds in
   * this tab. The badge is hidden whenever the count is zero or unknown, so it
   * never shows a number we cannot stand behind.
   */
  const KEY = 'sp-cart-count';

  function readFallback(): number {
    try {
      return Number(sessionStorage.getItem(KEY)) || 0;
    } catch {
      return 0;
    }
  }

  function writeFallback(n: number) {
    try {
      sessionStorage.setItem(KEY, String(n));
    } catch {
      /* private mode — the badge just stays hidden */
    }
  }

  const CART_BUTTON_NAME = 'Open shopping cart';

  function paint(count: number) {
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((el) => {
      el.textContent = String(count);
      el.hidden = count <= 0;
    });
    // The badge is aria-hidden, so the count reaches a screen reader through the
    // button's name or not at all. A count we cannot stand behind is left off
    // rather than guessed at, the same rule the badge itself follows.
    document.querySelectorAll<HTMLElement>('[data-sp-cart-open]').forEach((button) => {
      button.setAttribute(
        'aria-label',
        count > 0 ? `${CART_BUTTON_NAME}, ${count} ${count === 1 ? 'item' : 'items'}` : CART_BUTTON_NAME,
      );
    });
  }

  /**
   * The component exposes no `part` for the line row itself — only for pieces
   * inside it (`line-image`, `line-heading`, `line-price`, `line-options`).
   * Observed shadow DOM, September 10 2026: the row is an internal
   * `div.line-item`, not a `part`. Try selectors in order of how much of a
   * public contract they are — a real `part` first, should Shopify ever add
   * one; the internal class next, since it is what actually renders today;
   * `line-heading` (a genuine `part`, one per line) as a fallback that
   * survives the class being renamed; a bare `li` last. Each candidate is
   * tried alone so a match can never be double-counted against another tier.
   */
  function countLines(cart: Element): number | null {
    const root = (cart as any).shadowRoot as ShadowRoot | null;
    if (!root) return null;
    const candidates = [
      '[part~="line-item"]',
      '[part~="cart-line"]',
      '.line-item',
      '[part~="line-heading"]',
      'li',
    ];
    for (const selector of candidates) {
      const n = root.querySelectorAll(selector).length;
      if (n > 0) return n;
    }
    return null;
  }

  /**
   * U08: the controls Shopify's cart leaves unnamed.
   *
   * Observed in the live drawer with a line in it, September 8 2026. The
   * component names some of its own controls and not others: "Close cart
   * dialog" and "Remove item from cart" arrive with `aria-label`, while the
   * quantity stepper is two buttons with no text and no label, the discount
   * toggle's entire accessible name is "+", and the `<dialog>` has no name at
   * all — there is no heading element in the shadow root to point
   * `aria-labelledby` at, so the name has to be given directly.
   *
   * This is Shopify's DOM, not ours, and reaching into another component's
   * shadow root is the kind of thing that breaks quietly when the vendor ships
   * a change. Two properties keep it safe. It only ever *adds* a name to a
   * control that has none, so the day Shopify labels these itself this code
   * stops doing anything rather than fighting it; and it is driven by the
   * MutationObserver already running below, so a re-render cannot leave a new
   * unnamed button behind. If a selector stops matching, the result is the
   * accessibility Shopify shipped, which is where we started.
   *
   * The names match what the buttons visibly do. "Shopping cart" is the cart's
   * own visible title, reused rather than a second wording invented.
   */
  const CART_CONTROL_NAMES: ReadonlyArray<readonly [string, string]> = [
    ['.decrement', 'Decrease quantity'],
    ['.increment', 'Increase quantity'],
    ['.discount-toggle-button', 'Add a discount code'],
  ];

  function nameControls(root: ShadowRoot) {
    const dialog = root.querySelector('dialog');
    if (dialog && !dialog.getAttribute('aria-label') && !dialog.getAttribute('aria-labelledby')) {
      dialog.setAttribute('aria-label', 'Shopping cart');
    }
    for (const [selector, name] of CART_CONTROL_NAMES) {
      for (const el of root.querySelectorAll(selector)) {
        // Anything the component already names, in text or in a label, is left
        // exactly as the component named it.
        if (el.getAttribute('aria-label') || el.getAttribute('aria-labelledby')) continue;
        if ((el.textContent ?? '').trim() && !el.matches('.discount-toggle-button')) continue;
        el.setAttribute('aria-label', name);
      }
    }
    // Same rule as above, for a different gap: when a product's Shopify image
    // has no alt text set in Admin, the component stringifies the missing
    // value instead of omitting the attribute, so the image ships the literal
    // word "null" to a screen reader. Only that exact broken value is
    // replaced, with the line's own heading text (already shown alongside the
    // image, so this doesn't invent a description) — a real alt from Shopify
    // is never touched.
    for (const line of root.querySelectorAll('[part~="line-image"]')) {
      const img = line.querySelector('img');
      const heading = line.parentElement?.querySelector('[part~="line-heading"]');
      const name = heading?.textContent?.trim();
      if (img && name && (img.getAttribute('alt') === 'null' || !img.getAttribute('alt'))) {
        img.setAttribute('alt', name);
      }
    }
    // The checkout button's label is "CHECKOUT" as literal text, not a CSS
    // text-transform — so it is the one visible control on the site that
    // does not match the sentence-case voice everywhere else (Add to cart,
    // Get the checklist). Rewritten only when the text is exactly that
    // default, so a future copy change from Shopify is never fought.
    const checkoutButton = root.querySelector('[part~="primary-button"]');
    if (checkoutButton && checkoutButton.textContent?.trim() === 'CHECKOUT') {
      checkoutButton.textContent = 'Checkout';
    }
  }

  function sync() {
    const cart = document.getElementById('sublime-cart');
    if (!cart) return;
    const root = (cart as any).shadowRoot as ShadowRoot | null;
    if (root) nameControls(root);
    const live = countLines(cart);
    if (live !== null) {
      writeFallback(live);
      paint(live);
    } else {
      paint(readFallback());
    }
  }

  function init() {
    const cart = document.getElementById('sublime-cart');
    if (!cart) return;

    paint(readFallback());

    // The custom element upgrades asynchronously, so on a cold load the shadow
    // root is not there yet and both the badge and the control names would be
    // skipped for the life of the page. Poll briefly for it, then give up: the
    // fallback is the accessibility and the count Shopify ships on its own.
    if (!(cart as any).__spObserved) {
      (cart as any).__spObserved = true;
      let attempts = 0;
      const attach = () => {
        const root = (cart as any).shadowRoot as ShadowRoot | null;
        if (root) {
          nameControls(root);
          new MutationObserver(sync).observe(root, { childList: true, subtree: true });
          sync();
          return;
        }
        if (++attempts < 20) setTimeout(attach, 250);
      };
      attach();
    }

    // Delegated on `document`, not bound per-button: the shop hub and product
    // page render their buy buttons inside a `<shopify-context><template>`,
    // which Shopify clones into the live DOM asynchronously after fetching
    // product data. A one-time querySelectorAll here ran before that clone
    // existed, so `data-sp-cart-add` buttons on /shop never received a
    // listener and the fallback counter silently stopped incrementing for
    // them. Delegation only needs the button to exist at click time, which it
    // always does by the time someone can click it.
    if (!(document as any).__spCartDelegated) {
      (document as any).__spCartDelegated = true;
      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('[data-sp-cart-open]')) {
          (document.getElementById('sublime-cart') as any)?.showModal?.();
        }
        if (target.closest('[data-sp-cart-add]')) {
          writeFallback(readFallback() + 1);
          setTimeout(sync, 400);
        }
      });
    }
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
