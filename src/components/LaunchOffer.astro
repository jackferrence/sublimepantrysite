---
/**
 * Launch promotion notice.
 *
 * Renders nothing unless LAUNCH_OFFER.enabled is true, so the site cannot
 * advertise a discount code that does not exist in Shopify. No countdowns, no
 * scarcity, no modals — a chip, placed where the price is, on the product page
 * and in the cart. It appears nowhere else.
 */
import { LAUNCH_OFFER } from '../lib/commerce';

interface Props {
  /** Where this instance sits, for analytics attribution. */
  placement: string;
}

const { placement } = Astro.props;
const props = JSON.stringify({ placement, promo_code: LAUNCH_OFFER.code });
---
{LAUNCH_OFFER.enabled && (
  <p class="offer-chip" data-sp-view="promo_view" data-sp-props={props}>
    Code <strong data-sp-event="promo_click" data-sp-props={props}>{LAUNCH_OFFER.code}</strong>
    {' '}— {LAUNCH_OFFER.percentOff}% off, applied at checkout
  </p>
)}

<style>
  .offer-chip {
    display: inline-block;
    margin: 0 0 var(--s3);
    padding: .35rem .7rem;
    border-radius: var(--radius);
    background: var(--brand-tint);
    color: var(--ink);
    font-size: .9rem;
  }
</style>
