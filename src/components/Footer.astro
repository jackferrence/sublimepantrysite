---
/**
 * Site footer. Four link columns plus the newsletter, mirroring the header's
 * information architecture so the two never drift: both read from
 * `src/lib/nav.ts`.
 */
import Mark from './Mark.astro';
import Newsletter from './Newsletter.astro';
import { FOOTER_SHOP, FOOTER_LEARN, FOOTER_COMPANY, NEWSLETTER_ARCHIVE, live } from '../lib/nav';
import { PREFERENCE_CENTER_URL } from '../lib/paths';

const columns = [
  { id: 'shop', heading: 'Shop', items: live(FOOTER_SHOP) },
  { id: 'learn', heading: 'Learn', items: live(FOOTER_LEARN) },
  { id: 'company', heading: 'Company', items: live(FOOTER_COMPANY) },
];

const archive = NEWSLETTER_ARCHIVE.pending ? null : NEWSLETTER_ARCHIVE;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <a href="/" class="footer-brand">
        <Mark height={40} />
        <span>Sublime Pantry</span>
      </a>
      <p class="footer-line">Run by Jack Ferrence — <a href="/about">About →</a></p>
    </div>

    <div class="footer-columns">
      {columns.map((column) => (
        <nav aria-labelledby={`footer-${column.id}`}>
          <h2 id={`footer-${column.id}`} class="footer-heading">{column.heading}</h2>
          <ul>{column.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
        </nav>
      ))}

      <section class="footer-newsletter" aria-labelledby="footer-newsletter-heading">
        <h2 id="footer-newsletter-heading" class="footer-heading">The Dry Batch</h2>
        <p class="footer-line footer-pitch">One drying answer, one storage finding and one cottage-selling insight, weekly.</p>
        <Newsletter compact />
        <p class="footer-consent">
          Every issue carries an unsubscribe link.{' '}
          {PREFERENCE_CENTER_URL && <a href={PREFERENCE_CENTER_URL} rel="noopener">Manage email preferences</a>}
        </p>
        {archive && (
          <ul class="footer-newsletter-links">
            <li><a href={archive.href}>{archive.label}</a></li>
          </ul>
        )}
      </section>
    </div>

    <p class="footer-fine">Sublime Pantry publishes educational information about home freeze-drying and cottage food businesses. It is not medical, legal, or regulatory advice. Food safety and cottage food rules vary by jurisdiction. Always confirm with your state or local authority.</p>
    <p class="footer-fine">&copy; 2026 Sublime Pantry. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s6);
    padding-block: var(--s5);
    background: var(--surface);
    border-top: 1px solid var(--mist);
  }

  .footer-top { margin-bottom: var(--s4); }

  .footer-columns { display: grid; gap: var(--s4); }
  @media (min-width: 760px) { .footer-columns { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .footer-columns { grid-template-columns: repeat(3, minmax(0, 1fr)) 1.6fr; } }

  .footer-brand {
    display: flex; align-items: center; gap: .6rem; min-height: 44px;
    font-family: var(--font-display); font-size: 1.35rem; font-weight: 600;
    color: var(--ink); text-decoration: none;
  }
  .footer-line { margin: var(--s2) 0 0; color: var(--ink-soft); font-size: .92rem; }
  .footer-pitch { margin-top: .35rem; max-width: 34ch; }

  .footer-heading {
    font-family: var(--font-body); font-size: var(--kicker); font-weight: 600;
    text-transform: uppercase; letter-spacing: .08em; color: var(--brand);
    margin: 0 0 var(--s1);
  }
  .site-footer ul { list-style: none; margin: 0; padding: 0; }
  .site-footer li { margin: 0; }
  .site-footer li a {
    display: inline-flex; align-items: center; min-height: 32px;
    color: var(--ink-soft); text-decoration: none; font-size: .92rem;
  }
  .site-footer li a:hover { color: var(--brand); text-decoration: underline; }

  .footer-newsletter-links { margin-top: var(--s1); }
  /* Sits directly under the consent checkbox, which is where someone looks
     when they want out. */
  .footer-consent { margin: var(--s2) 0 0; font-size: .82rem; color: var(--ink-soft); max-width: 34ch; }
  .footer-consent a { color: var(--ink-soft); text-decoration: underline; }
  .footer-consent a:hover { color: var(--brand); }

  .footer-fine {
    margin: var(--s3) 0 0; max-width: 70ch;
    font-size: .85rem; color: var(--ink-soft);
  }
</style>
