---
/**
 * Products from our own catalog that this article actually mentions.
 *
 * Nothing is inserted editorially: the body HTML is scanned for a catalog
 * handle or a link into /shop/, and only what is genuinely referenced appears.
 * If the article mentions none, this renders nothing at all.
 *
 * That was the intent and it was not the behaviour. A `declared` list in front
 * matter bypassed the scan, and three troubleshooting articles used it to show
 * the packaging kit while mentioning it nowhere in their text — under a heading
 * reading "Tools mentioned in this guide", which was false on the page. The
 * escape hatch is gone; the only way a product appears here is that the article
 * refers to it.
 */
import Card from './Card.astro';
import { CATALOG, SHIPPING } from '../lib/commerce';

interface Props {
  bodyHtml: string;
}

const { bodyHtml } = Astro.props;

const mentioned = CATALOG.filter(
  (product) =>
    bodyHtml.includes(product.handle) ||
    Boolean(product.detailsHref && bodyHtml.includes(product.detailsHref)),
).slice(0, 3);
---
{mentioned.length > 0 && (
  <section class="tools-mentioned" aria-labelledby="tools-mentioned-heading">
    <h2 id="tools-mentioned-heading">Tools mentioned in this guide</h2>
    <div class="card-grid">
      {mentioned.map((product) => (
        <Card
          href={product.detailsHref ?? `/shop`}
          title={product.title}
          dek={product.note}
          kicker="Sold by Sublime Pantry"
          image={product.image}
          imageAlt={product.imageAlt}
          ratio="4/5"
          fit="contain"
          price={product.displayPrice}
          meta={SHIPPING.shortNote}
        />
      ))}
    </div>
  </section>
)}

<style>
  .tools-mentioned { margin: var(--s5) 0; }
</style>
