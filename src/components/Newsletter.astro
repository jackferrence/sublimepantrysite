---
/**
 * Lead capture. Email and consent, nothing else.
 *
 * The qualifying question ("where are you right now?") used to sit here and
 * cost a field on the highest-intent moment on the page. It now lives on
 * /thanks, after the address is already captured, posting to the same Netlify
 * form.
 */
import { normalizePath } from '../lib/paths';

const sourcePath = normalizePath(Astro.url.pathname);
const viewProps = JSON.stringify({
  lead_magnet: 'freeze-drying-starter-checklist',
  source_path: sourcePath,
});
---
<section class="newsletter card" aria-labelledby="newsletter-heading" data-sp-view="lead_magnet_view" data-sp-props={viewProps}>
  <span class="kicker">Free starter checklist</span>
  <h2 id="newsletter-heading">Run cleaner batches from day one.</h2>
  <p class="newsletter-lede">Get the printable Starter Checklist and 10% off + free shipping on your first order, then <strong>The Dry Batch</strong> twice a month.</p>

  <form
    name="freeze-drying-checklist"
    method="POST"
    action="/thanks"
    data-netlify="true"
    netlify-honeypot="bot-field"
    data-astro-reload
  >
    <input type="hidden" name="form-name" value="freeze-drying-checklist" />
    <input type="hidden" name="lead_magnet" value="freeze-drying-starter-checklist" />
    <input type="hidden" name="source_path" value={sourcePath} />
    <p hidden aria-hidden="true"><label>Don't fill this out: <input name="bot-field" /></label></p>

    <div class="newsletter-field">
      <label for="newsletter-email">Email address</label>
      <input id="newsletter-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
    </div>

    <label class="consent">
      <input type="checkbox" name="marketing_consent" value="yes" required />
      <span>Yes, send me The Dry Batch and relevant freeze-drying resources. I can unsubscribe anytime.</span>
    </label>

    <button class="btn btn-primary" type="submit">Get the checklist</button>
  </form>

  <p class="meta newsletter-fine">We use your email only for the content described above. See our <a href="/privacy">privacy policy</a>.</p>
</section>

<!--
  Lead capture bridge (progressive enhancement).

  The form's own POST to Netlify Forms is untouched and remains the system of
  record until the Shopify sync is proven in production. This listener
  additionally mirrors the submission to a serverless function that upserts the
  Shopify customer. It uses sendBeacon so the request survives the navigation
  that the native form POST triggers, and it never blocks or intercepts that
  POST — if this fails, or JS is off, the Netlify submission still succeeds.

  It also stashes the address for /thanks, so the follow-up question there can
  post to the same Netlify form and stay attached to the same subscriber.
-->
<script is:inline>
  (function () {
    if (window.__spLeadBridge) return;
    window.__spLeadBridge = true;
    document.addEventListener('submit', function (e) {
      var form = e.target instanceof Element ? e.target.closest('form[name="freeze-drying-checklist"]') : null;
      if (!form) return;
      var data = new FormData(form);
      if (data.get('bot-field')) return;
      if (data.get('marketing_consent') !== 'yes') return;

      var email = data.get('email');
      try {
        if (email) sessionStorage.setItem('sp-lead-email', String(email));
      } catch (err) {
        /* private mode — /thanks will simply ask for the address again */
      }

      if (!navigator.sendBeacon) return;
      var payload = JSON.stringify({
        email: email,
        stage: data.get('stage'),
        source_path: data.get('source_path'),
        lead_magnet: data.get('lead_magnet'),
        marketing_consent: true,
      });
      try {
        navigator.sendBeacon('/.netlify/functions/lead-capture', new Blob([payload], { type: 'application/json' }));
      } catch (err) {
        /* Netlify Forms remains the fallback; never block the submission. */
      }
    });
  })();
</script>

<style>
  .newsletter { margin: var(--s5) 0; padding: var(--s4); }
  .newsletter h2 { margin: 0 0 var(--s1); }
  .newsletter-lede { color: var(--ink-soft); max-width: 58ch; }
  .newsletter-field { margin: var(--s3) 0 var(--s2); max-width: 26rem; }
  .newsletter-field label { display: block; margin-bottom: .35rem; font-size: .9rem; }
  .consent {
    display: flex; gap: .6rem; align-items: flex-start;
    margin: 0 0 var(--s3); font-size: .9rem; font-weight: 400; line-height: 1.45;
    max-width: 56ch;
  }
  .consent input { margin-top: .2rem; }
  .newsletter-fine { margin-top: var(--s2); }
</style>
