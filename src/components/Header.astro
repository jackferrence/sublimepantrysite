---
const navItems = [
  { href: '/guides', label: 'Guides' },
  { href: '/troubleshooting', label: 'Troubleshooting' },
  { href: '/compare', label: 'Comparisons' },
  { href: '/tools/batch-log', label: 'Batch Log' },
  { href: '/start-selling', label: 'Start Selling' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header" transition:name="site-header">
  <div class="wrap">
    <a href="/" class="brand">
      <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="7" y="8" width="18" height="20" rx="3" stroke="#1d3f56" stroke-width="2" fill="#e7eef3"></rect>
        <rect x="9" y="4" width="14" height="4" rx="1.5" fill="#9a6115"></rect>
        <g stroke="#2c5d7c" stroke-width="1.6" stroke-linecap="round">
          <line x1="16" y1="12" x2="16" y2="24"></line>
          <line x1="10.8" y1="15" x2="21.2" y2="21"></line>
          <line x1="21.2" y1="15" x2="10.8" y2="21"></line>
        </g>
      </svg>Sublime Pantry
    </a>
    <nav class="site-nav" aria-label="Main">
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav-list" hidden>
        <span class="sr-only">Menu</span>
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
        <span class="bar" aria-hidden="true"></span>
      </button>
      <ul id="site-nav-list">
        {navItems.map((item) => (
          <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
