---
/**
 * The one image element on the site.
 *
 * Astro's <Image> optimises what it can reach: remote images on an authorised
 * domain (Shopify's CDN) go through the image service. Photography that lives
 * in `public/` is served as-is — but it still goes through here, so that
 * `width`, `height`, `loading` and `sizes` are never optional and layout shift
 * cannot creep back in.
 */
import { Image } from 'astro:assets';
import { ASSETS, srcSet as assetSrcSet } from '../lib/assets';

interface Props {
  src: string;
  /** Responsive candidates. Usually left off — a library `src` fills this in
   *  automatically below. Pass it only for candidates the library cannot know. */
  srcset?: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto' | 'low';
  class?: string;
}

const {
  src,
  srcset,
  alt,
  width,
  height,
  sizes,
  loading = 'lazy',
  fetchpriority,
  class: className,
} = Astro.props;

const optimisable = src.startsWith('https://cdn.shopify.com/');

// An asset-library `src` names one derivative; the library knows the rest of
// the ladder, so fill the srcset in here rather than at each call site. Seven
// templates render article heroes into cards, and the one that forgot to pass
// candidates would quietly ship a 1600px file into a 350px card — no error, no
// visible defect, just a slow page on the screens nobody profiles.
const libraryMatch = /^(\/images\/library\/[^/]+)\/(\d+)x(\d+)-\d+\.webp$/.exec(src);
const libraryAsset = libraryMatch ? ASSETS.find((a) => a.src === libraryMatch[1]) : undefined;
const libraryRatio = libraryMatch ? `${libraryMatch[2]}:${libraryMatch[3]}` : undefined;
const candidates =
  srcset ||
  (libraryAsset && libraryRatio ? assetSrcSet(libraryAsset, libraryRatio as never) : '');
---
{optimisable ? (
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={className}
  />
) : (
  <img
    src={src}
    srcset={candidates || undefined}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={className}
  />
)}
