---
/**
 * The one image element on the site.
 *
 * Astro's <Image> optimises what it can reach: remote images on an authorised
 * domain (Shopify's CDN) go through the image service. Photography that lives
 * in `public/` is served as-is — but it still goes through here, so that
 * `width`, `height`, `loading` and `sizes` are never optional and layout shift
 * cannot creep back in.
 */
import { Image } from 'astro:assets';
import { ASSETS, srcSet as assetSrcSet } from '../lib/assets';

/** The four fixed ratios per docs/design-research.md §2 — one CI-checkable
 *  aspect-ratio per usage context, not a per-template convention. `pack` is
 *  the packshot/product-card slot (1:1); `inline` is new with this rebuild
 *  (3:2, in-article photography) and has no caller yet. */
const SLOT_ASPECT_RATIO = {
  hero: '16 / 9',
  card: '4 / 5',
  inline: '3 / 2',
  pack: '1 / 1',
} as const;
type ImgSlot = keyof typeof SLOT_ASPECT_RATIO;

interface Props {
  src: string;
  /** Responsive candidates. Usually left off — a library `src` fills this in
   *  automatically below. Pass it only for candidates the library cannot know. */
  srcset?: string;
  alt: string;
  width: number;
  height: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto' | 'low';
  class?: string;
  /** Optional. When set, pins aspect-ratio + object-fit: cover to the
   *  docs/design-research.md §2 slot ratio and gives the element a solid
   *  --sp-color-surface-inset ground so a broken or still-loading image
   *  reads as a tinted panel, never a layout hole. Existing callers that
   *  don't pass this keep their current sizing exactly as-is. */
  slot?: ImgSlot;
}

const {
  src,
  srcset,
  alt,
  width,
  height,
  sizes,
  loading = 'lazy',
  fetchpriority,
  class: className,
  slot,
} = Astro.props;

const slotStyle = slot
  ? `aspect-ratio:${SLOT_ASPECT_RATIO[slot]};object-fit:cover;width:100%;height:auto;background:var(--sp-color-surface-inset)`
  : undefined;

const optimisable = src.startsWith('https://cdn.shopify.com/');

// An asset-library `src` names one derivative; the library knows the rest of
// the ladder, so fill the srcset in here rather than at each call site. Seven
// templates render article heroes into cards, and the one that forgot to pass
// candidates would quietly ship a 1600px file into a 350px card — no error, no
// visible defect, just a slow page on the screens nobody profiles.
const libraryMatch = /^(\/images\/library\/[^/]+)\/(\d+)x(\d+)-\d+\.webp$/.exec(src);
const libraryAsset = libraryMatch ? ASSETS.find((a) => a.src === libraryMatch[1]) : undefined;
const libraryRatio = libraryMatch ? `${libraryMatch[2]}:${libraryMatch[3]}` : undefined;
const candidates =
  srcset ||
  (libraryAsset && libraryRatio ? assetSrcSet(libraryAsset, libraryRatio as never) : '');
---
{optimisable ? (
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={className}
    style={slotStyle}
  />
) : (
  <img
    src={src}
    srcset={candidates || undefined}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={className}
    style={slotStyle}
  />
)}
