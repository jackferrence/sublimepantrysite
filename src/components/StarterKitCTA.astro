---
interface Props {
  compact?: boolean;
  source?: string;
}

const { compact = false, source = 'article' } = Astro.props;
const href = `/shop/freeze-dryer-packaging-starter-kit?utm_source=sublimepantry&utm_medium=internal&utm_campaign=starter-kit&utm_content=${encodeURIComponent(source)}`;
---
<section class:list={["starter-kit-cta", compact && "starter-kit-cta--compact"]} aria-label="Freeze-dryer packaging starter kit">
  <div>
    <span class="kicker">Packaging made simple</span>
    <h2>Have your first serious batches ready to store.</h2>
    <p>100 assorted 7 mil Mylar bags, 100 matched oxygen absorbers, 100 labels, and a storage guide in one verified kit. The validation launch is priced at current source cost.</p>
    <div class="cta-actions">
      <a class="btn btn-primary" href={href} data-sp-event="starter_kit_cta">See the $59.99 starter kit</a>
      <a class="text-link" href="/freeze-drying-starter-checklist">Use the free starter checklist →</a>
    </div>
  </div>
</section>

<style>
  .starter-kit-cta { margin: 2.5rem 0; padding: 1.65rem; border: 1px solid var(--line); border-radius: 14px; background: var(--paper, #fff); }
  .starter-kit-cta h2 { margin: .35rem 0 .65rem; font-size: clamp(1.45rem, 2.5vw, 2rem); }
  .starter-kit-cta p { margin: 0; max-width: 68ch; color: var(--ink-soft); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: .85rem 1rem; align-items: center; margin-top: 1.15rem; }
  .text-link { font-weight: 700; }
  .starter-kit-cta--compact { margin: 1.6rem 0; padding: 1.25rem; }
  .starter-kit-cta--compact h2 { font-size: 1.35rem; }
</style>
