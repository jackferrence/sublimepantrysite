---
/**
 * docs/CLAUDE-CODE-PROMPT.md T3.5. Required on every guide that has a
 * `limitations` field (src/content.config.ts). Inset ground, 2px left
 * border in status-warn — which BRAND.md/tokens/semantic.*.tokens.json
 * deliberately alias to rust rather than a separate yellow: "never yellow,
 * never an exclamation icon" per the spec, and rust is already the one
 * accent tied to "a verdict, a limitation, a warning" (Appendix A).
 *
 * Eyebrow reads "What we haven't verified", not "...tested" — per Jack's
 * 2026-09-10 methodology decision (docs/DECISIONS.md): Sublime Pantry does
 * no physical product testing at all, so "haven't tested" would wrongly
 * imply some subset of products IS physically tested. "Verified" covers
 * the site's real method (comparing specs, certifications, vendor data)
 * without claiming any of it.
 */
interface Props {
  limitations: string;
}
const { limitations } = Astro.props;
---
<aside class="limitations-callout">
  <p class="label">What we haven't verified</p>
  <p>{limitations}</p>
</aside>

<style>
  .limitations-callout {
    background: var(--sp-color-surface-inset);
    border-inline-start: 2px solid var(--sp-color-status-warn);
    padding: var(--s3);
    margin-block: var(--s4);
  }
  .limitations-callout p:last-child { margin-bottom: 0; }
</style>
