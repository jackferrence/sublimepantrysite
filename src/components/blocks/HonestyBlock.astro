---
/**
 * docs/CLAUDE-CODE-PROMPT.md T3.4, retitled "What we compared — and
 * didn't" rather than the brief's literal "What we tested — and didn't".
 * Confirmed by Jack's 2026-09-10 methodology decision (docs/DECISIONS.md):
 * Sublime Pantry does NO physical product testing — verdicts are built
 * from comparing published specs, certification language, and vendor
 * data only. tests/claim-shapes.test.mjs's TESTING guard ("the site never
 * claims hands-on testing") independently enforces the same thing at
 * build time. Kept the schema field names (`testedProducts`, `notTested`
 * in src/content.config.ts) as-is — they're data plumbing — and changed
 * only the rendered copy, here and in the two column headings below.
 *
 * Content-authoring rule for the `.note` a guide passes per tested
 * product: state the comparison basis (the datasheet figure, the
 * certification language, what the vendor's own listing says), never a
 * physical result. "Highest cc rating per the datasheet" is right;
 * "held up best in our test" is exactly the claim this component exists
 * to avoid making.
 */
import { CATALOG } from '../../lib/commerce.ts';

interface TestedProduct {
  productHandle: string;
  note: string;
}
interface NotTested {
  name: string;
  reason: string;
}
interface Props {
  testedProducts: TestedProduct[];
  notTested: NotTested[];
}
const { testedProducts, notTested } = Astro.props;
---
{(testedProducts.length > 0 || notTested.length > 0) && (
  <section class="honesty-block" aria-labelledby="honesty-block-heading">
    <p class="label" id="honesty-block-heading">What we compared — and didn't</p>
    <div class="honesty-columns">
      {testedProducts.length > 0 && (
        <div>
          <h4>Compared</h4>
          <ul>
            {testedProducts.map((item) => {
              const product = CATALOG.find((p) => p.handle === item.productHandle);
              return (
                <li>
                  <strong>{product?.shortTitle ?? item.productHandle}</strong> — {item.note}
                </li>
              );
            })}
          </ul>
        </div>
      )}
      {notTested.length > 0 && (
        <div>
          <h4>Not compared</h4>
          <ul>
            {notTested.map((item) => (
              <li><strong>{item.name}</strong> — {item.reason}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .honesty-block {
    border-block: 1px solid var(--mist);
    padding-block: var(--s3);
    margin-block: var(--s5);
  }
  .honesty-columns { display: grid; gap: var(--s3); margin-top: var(--s2); }
  .honesty-columns h4 { margin: 0 0 var(--s1); }
  .honesty-columns ul { margin: 0; padding-inline-start: 1.2em; }
  .honesty-columns li + li { margin-top: .35rem; }

  @media (min-width: 720px) {
    .honesty-columns { grid-template-columns: 1fr 1fr; }
  }
</style>
