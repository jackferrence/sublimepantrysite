---
/**
 * docs/CLAUDE-CODE-PROMPT.md T3.4, retitled "What we compared — and
 * didn't" rather than the brief's literal "What we tested — and didn't".
 * tests/claim-shapes.test.mjs's TESTING guard ("the site never claims
 * hands-on testing") fails the build on the exact phrase "we ... tested"
 * within a few words — a real, deliberate rule: this site's disclosed
 * position is that it has not bench-tested any machine or product, and
 * publishes specification comparisons instead (see /review-methodology).
 * docs/CLAUDE-CODE-PROMPT.md's "who tests and fulfils everything himself"
 * framing assumes a persona this specific site does not claim. Kept the
 * schema field names (`testedProducts`, `notTested` in src/content.config.ts)
 * as-is — they're just data plumbing — and changed only the rendered copy,
 * here and in the two column headings below, to match what the site can
 * actually stand behind. Flagged in docs/DECISIONS.md.
 */
import { CATALOG } from '../../lib/commerce.ts';

interface TestedProduct {
  productHandle: string;
  note: string;
}
interface NotTested {
  name: string;
  reason: string;
}
interface Props {
  testedProducts: TestedProduct[];
  notTested: NotTested[];
}
const { testedProducts, notTested } = Astro.props;
---
{(testedProducts.length > 0 || notTested.length > 0) && (
  <section class="honesty-block" aria-labelledby="honesty-block-heading">
    <p class="label" id="honesty-block-heading">What we compared — and didn't</p>
    <div class="honesty-columns">
      {testedProducts.length > 0 && (
        <div>
          <h4>Compared</h4>
          <ul>
            {testedProducts.map((item) => {
              const product = CATALOG.find((p) => p.handle === item.productHandle);
              return (
                <li>
                  <strong>{product?.shortTitle ?? item.productHandle}</strong> — {item.note}
                </li>
              );
            })}
          </ul>
        </div>
      )}
      {notTested.length > 0 && (
        <div>
          <h4>Not compared</h4>
          <ul>
            {notTested.map((item) => (
              <li><strong>{item.name}</strong> — {item.reason}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .honesty-block {
    border-block: 1px solid var(--mist);
    padding-block: var(--s3);
    margin-block: var(--s5);
  }
  .honesty-columns { display: grid; gap: var(--s3); margin-top: var(--s2); }
  .honesty-columns h4 { margin: 0 0 var(--s1); }
  .honesty-columns ul { margin: 0; padding-inline-start: 1.2em; }
  .honesty-columns li + li { margin-top: .35rem; }

  @media (min-width: 720px) {
    .honesty-columns { grid-template-columns: 1fr 1fr; }
  }
</style>
