---
/**
 * Loads the Shopify Storefront Web Components runtime and declares the store.
 *
 * Included once per commerce page. Everything SEO-critical is server-rendered
 * by the calling page; these components supply only live price, availability,
 * cart, and the checkout handoff.
 */
import { SHOPIFY_STORE_DOMAIN } from '../lib/commerce';
---
<script type="module" src="https://cdn.shopify.com/storefront/web-components.js"></script>
<shopify-store store-domain={SHOPIFY_STORE_DOMAIN} country="US" language="en"></shopify-store>
<script is:inline src="/commerce-fallback.js" defer></script>

<style is:global>
  /*
    The Storefront components render their own diagnostic text into the page
    when the Storefront API is unreachable (e.g. "shopify-context: GraphQL
    Client:" when the Online Store channel is locked). That is developer
    output, not customer copy. Hide it at parse time so there is no window in
    which a customer can see it; commerce-fallback.js then reveals a written
    fallback in its place.
  */
  shopify-context .shopify-error,
  shopify-store .shopify-error {
    display: none !important;
  }
</style>
