---
/**
 * Flat vector packshots for the 8 SKUs, per docs/design-research.md §2 and
 * docs/CLAUDE-CODE-PROMPT.md T2.4: 2px ink stroke, ice-100 as the single
 * fill, at most one rust accent, 1:1 viewBox, patent-drawing flatness — not
 * a photograph standing in for one. These exist because the site has no
 * original product photography yet (see docs/DECISIONS.md's fold-forward
 * note from the retired ART-DIRECTION.md): a packshot here can be replaced
 * later by a real photograph or 3D render without touching any consumer,
 * since callers only ever pass a `sku` handle.
 *
 * Stroke colour is `currentColor` so it follows text colour (and therefore
 * dark mode) automatically; fill is the ice surface token directly, which
 * is the one place besides the logo and .sp-ghost this file's own BRAND.md
 * rule allows ice to be used as more than a hairline — see the note by
 * `--logo-frost` in public/styles/base.css and BRAND.md § Palette: a
 * packshot's ground IS the artwork, the same exception the header brand
 * block already relies on, not a section background we chose.
 */
export type PackshotKind = 'bag' | 'absorber' | 'sealer' | 'bundle';

/** Every SKU in src/lib/commerce.ts's CATALOG_RECORDS, mapped to the shape
 *  it renders. Kept as an explicit map (not inferred from the handle text)
 *  so a renamed or added SKU fails loudly here instead of silently
 *  rendering the wrong packshot. */
const SKU_KIND: Record<string, PackshotKind> = {
  'snack-bags-6x6-50-pack-absorbers': 'bag',
  'snack-bags-6x6-100-pack-absorbers': 'bag',
  'quart-bags-8x12-50-pack-300cc-absorbers': 'bag',
  '100cc-oxygen-absorber-refill-100-count': 'absorber',
  '300cc-oxygen-absorber-refill-100-count': 'absorber',
  'mini-heat-sealer-for-mylar-bags': 'sealer',
  'starter-set-50-bags-50-absorbers-sealer': 'bundle',
  'season-set-100-bags-100-absorbers-sealer': 'bundle',
};

interface Props {
  /** A handle from src/lib/commerce.ts's CATALOG_RECORDS. */
  sku: string;
  /** Accessible name. Defaults to a generic description of the shape;
   *  pass the product's actual title for a real accessible name wherever
   *  this isn't purely decorative (ProductCard, VerdictBox, SpecSheet). */
  title?: string;
  class?: string;
}

const { sku, title, class: className } = Astro.props;
const kind = SKU_KIND[sku];

if (!kind) {
  throw new Error(
    `Packshot: no shape mapped for sku "${sku}" — add it to SKU_KIND in src/components/figures/Packshot.astro`,
  );
}

const accessibleTitle =
  title ??
  { bag: 'Mylar bag, illustrated', absorber: 'Oxygen absorber sachet, illustrated', sealer: 'Heat sealer, illustrated', bundle: 'Packaging bundle, illustrated' }[kind];
---
<svg
  class={className}
  viewBox="0 0 120 120"
  role="img"
  aria-label={accessibleTitle}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linejoin="round"
  stroke-linecap="round"
>
  <title set:text={accessibleTitle} />

  {kind === 'bag' && (
    <g>
      {/* Rounded-rectangle bag body */}
      <rect x="22" y="30" width="76" height="78" rx="6" fill="var(--sp-color-surface-ice)" />
      {/* Tear notch */}
      <path d="M22 44 L30 40 L30 48 Z" fill="var(--sp-color-surface-page)" stroke="none" />
      {/* Seal band across the top — the one rust accent */}
      <rect x="22" y="30" width="76" height="10" fill="none" stroke="var(--sp-color-action-primary)" />
      {/* Fold lines */}
      <line x1="22" y1="70" x2="98" y2="70" opacity="0.35" />
    </g>
  )}

  {kind === 'absorber' && (
    <g>
      {/* Sachet: a slightly puffed rounded rectangle with a heat-seal border */}
      <rect x="28" y="34" width="64" height="52" rx="10" fill="var(--sp-color-surface-ice)" />
      <rect x="34" y="40" width="52" height="40" rx="6" fill="none" opacity="0.5" />
      {/* Label rust accent */}
      <rect x="46" y="52" width="28" height="16" rx="2" fill="var(--sp-color-action-primary)" stroke="none" />
    </g>
  )}

  {kind === 'sealer' && (
    <g>
      {/* A bar with a hinge — the impulse sealer, side profile */}
      <rect x="18" y="66" width="84" height="14" rx="3" fill="var(--sp-color-surface-ice)" />
      <rect x="18" y="46" width="84" height="12" rx="3" fill="var(--sp-color-surface-ice)" />
      {/* Hinge */}
      <circle cx="22" cy="63" r="4" fill="var(--sp-color-action-primary)" stroke="none" />
      {/* Heating element line — the one rust accent */}
      <line x1="28" y1="52" x2="96" y2="52" stroke="var(--sp-color-action-primary)" />
    </g>
  )}

  {kind === 'bundle' && (
    <g>
      {/* A small bag and a small sachet side by side, composed from the
          same two shapes above at reduced scale, plus the sealer bar
          behind — "who this kit is for" is in prose, not in the icon. */}
      <rect x="14" y="70" width="14" height="10" rx="2" fill="var(--sp-color-surface-ice)" />
      <rect x="30" y="66" width="60" height="14" rx="3" fill="var(--sp-color-surface-ice)" />
      <line x1="34" y1="70" x2="86" y2="70" stroke="var(--sp-color-action-primary)" />
      <rect x="40" y="20" width="40" height="46" rx="6" fill="var(--sp-color-surface-ice)" />
      <rect x="40" y="20" width="40" height="8" fill="none" stroke="var(--sp-color-action-primary)" />
      <rect x="56" y="40" width="16" height="12" rx="3" fill="var(--sp-color-surface-ice)" opacity="0.85" />
    </g>
  )}
</svg>
