---
/**
 * docs/CLAUDE-CODE-PROMPT.md T2.4. Four steps for sealing a mylar bag,
 * reader-facing instructional content — how the reader closes their own
 * bag, using the site's own catalog vocabulary and hardware (a heat sealer;
 * see src/lib/commerce.ts's SEALER_REQUIRED / "Mini Heat Sealer" copy).
 * Same spec: 2px stroke, ice-100 single fill, one rust accent (the seal
 * line itself, step 3). Teaches technique; makes no claim that Sublime
 * Pantry ran this on a specific batch — see the methodology decision in
 * docs/DECISIONS.md and the same distinction OxygenIndicator/PuffyBagTest
 * draw.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const STEPS = [
  'Fill the bag, leaving a clear inch of film at the top for the seal.',
  'Press the absorber packet to the bottom, away from where the seal will run.',
  'Flatten the film at the mouth and run the sealer bar across it in one pass.',
  'Run a finger along the cooled seam and gently pull — a good seal will not separate.',
];
---
<figure class={className}>
  <svg viewBox="0 0 400 120" role="img" aria-labelledby="seal-steps-title" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
    <title id="seal-steps-title">Four steps to seal a mylar bag</title>

    {[0, 1, 2, 3].map((i) => {
      const x = 10 + i * 100;
      return (
        <g transform={`translate(${x},10)`}>
          <rect x="20" y="10" width="55" height="80" rx="6" fill="var(--sp-color-surface-ice)" />
          {i === 0 && <line x1="20" y1="30" x2="75" y2="30" opacity="0.4" />}
          {i >= 1 && <rect x="30" y="55" width="35" height="16" rx="3" fill="var(--sp-color-surface-page)" />}
          {i >= 2 && <line x1="20" y1="22" x2="75" y2="22" stroke="var(--sp-color-action-primary)" stroke-width="3" />}
          {i === 3 && <path d="M28 22 L34 30" stroke="var(--sp-color-action-primary)" />}
          <circle cx="47" cy="98" r="9" fill="none" />
          <text x="47" y="102" font-size="10" text-anchor="middle" stroke="none" fill="currentColor">{i + 1}</text>
        </g>
      );
    })}
  </svg>
  <figcaption>
    <ol class="seal-steps-list">
      {STEPS.map((step) => <li>{step}</li>)}
    </ol>
  </figcaption>
</figure>

<style>
  figure { margin: 0; max-width: 40rem; }
  svg { width: 100%; height: auto; }
  figcaption { margin-top: var(--s2); }
  .seal-steps-list { margin: 0; padding-inline-start: 1.3em; }
  .seal-steps-list li + li { margin-top: .35rem; }
</style>
