---
/**
 * docs/CLAUDE-CODE-PROMPT.md T2.4. A side-view cutaway of a home freeze
 * dryer: sealed door, stacked trays, condenser coil, vacuum pump. Same
 * spec: 2px stroke, ice-100 single fill, one rust accent (the vacuum line),
 * patent-drawing flatness. Generic equipment education — what the machine's
 * parts are and do — not a claim about a specific machine Sublime Pantry
 * owns or has run; the site's disclosed position (see /review-methodology
 * and the methodology decision in docs/DECISIONS.md) is that it has not
 * bench-tested any machine, and this diagram doesn't imply otherwise — it's
 * the same category of generic-mechanism drawing as SublimationCurve.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<figure class={className}>
  <svg viewBox="0 0 360 220" role="img" aria-labelledby="chamber-cutaway-title" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
    <title id="chamber-cutaway-title">Cutaway of a home freeze dryer's chamber, condenser and pump</title>

    <!-- Chamber body -->
    <rect x="20" y="30" width="180" height="140" rx="10" fill="var(--sp-color-surface-ice)" />
    <!-- Door, sealed -->
    <circle cx="20" cy="100" r="32" fill="var(--sp-color-surface-page)" />
    <circle cx="20" cy="100" r="32" />

    <!-- Stacked trays -->
    <line x1="55" y1="55" x2="185" y2="55" />
    <line x1="55" y1="80" x2="185" y2="80" />
    <line x1="55" y1="105" x2="185" y2="105" />
    <line x1="55" y1="130" x2="185" y2="130" />
    <line x1="55" y1="155" x2="185" y2="155" />

    <!-- Condenser coil, behind the chamber -->
    <path d="M210 50 Q230 60 210 70 Q230 80 210 90 Q230 100 210 110 Q230 120 210 130 Q230 140 210 150" />
    <text x="205" y="40" font-size="10" stroke="none" fill="currentColor">Condenser</text>

    <!-- Vacuum line to the pump — the one rust accent -->
    <path d="M250 100 L320 100" stroke="var(--sp-color-action-primary)" />
    <rect x="320" y="80" width="30" height="40" rx="4" fill="var(--sp-color-surface-ice)" stroke="var(--sp-color-action-primary)" />
    <text x="315" y="135" font-size="10" stroke="none" fill="currentColor">Pump</text>

    <text x="70" y="195" font-size="10" stroke="none" fill="currentColor">Sealed chamber, trays inside</text>
  </svg>
  <figcaption class="label">
    The chamber holds a vacuum while the condenser collects the water vapor as ice, and the pump maintains the low pressure the whole run depends on.
  </figcaption>
</figure>

<style>
  figure { margin: 0; max-width: 40rem; }
  svg { width: 100%; height: auto; }
  figcaption { margin-top: var(--s2); }
</style>
