---
/**
 * The oxygen-indicator colour chart: pink = absorbed, blue = oxygen present.
 * One of five diagrams docs/CLAUDE-CODE-PROMPT.md T2.4 asks for
 * (SublimationCurve, ChamberCutaway, SealSteps, PuffyBagTest are the other
 * four — not built this session; see docs/DECISIONS.md). Built first because
 * it's the one that needed new tokens (status.indicatorPink/indicatorBlue,
 * added in T1.2) and so is the clearest proof that the semantic-exception
 * pattern docs/design-research.md §2 asks for actually works end to end.
 *
 * Same spec as Packshot: 2px stroke, patent-drawing flatness, currentColor
 * for line work. The two indicator colours are the one deliberate exception
 * to "colour comes from the semantic tier, one accent" — they're a literal
 * physical color code the reader has to match against their own bag, not a
 * design choice, which is exactly why docs/CLAUDE-CODE-PROMPT.md T2.4 calls
 * them out as a named semantic exception rather than folding them into
 * status.warn/status.danger.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<figure class={className}>
  <svg viewBox="0 0 320 140" role="img" aria-labelledby="oxygen-indicator-title" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
    <title id="oxygen-indicator-title">Oxygen indicator pill colour chart</title>

    <!-- Absorbed: pink -->
    <g transform="translate(40,20)">
      <rect x="0" y="0" width="100" height="70" rx="8" fill="none" />
      <circle cx="50" cy="30" r="16" fill="var(--sp-color-status-indicatorPink)" stroke="none" />
      <text x="50" y="60" text-anchor="middle" font-size="11" stroke="none" fill="currentColor">Absorbed</text>
    </g>

    <!-- Oxygen present: blue -->
    <g transform="translate(180,20)">
      <rect x="0" y="0" width="100" height="70" rx="8" fill="none" />
      <circle cx="50" cy="30" r="16" fill="var(--sp-color-status-indicatorBlue)" stroke="none" />
      <text x="50" y="60" text-anchor="middle" font-size="11" stroke="none" fill="currentColor">Oxygen present</text>
    </g>
  </svg>
  <figcaption class="label">
    Pink means the absorber did its job — no free oxygen left in the bag. Blue means oxygen is still present: check the seal before you trust the batch.
  </figcaption>
</figure>

<style>
  figure { margin: 0; max-width: 40rem; }
  svg { width: 100%; height: auto; }
  figcaption { margin-top: var(--s2); }
</style>
