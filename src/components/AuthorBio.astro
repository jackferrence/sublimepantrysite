---
import { getAuthor, hasPortrait } from '../lib/authors';

interface Props {
  author: string;
}

const { author } = Astro.props;
const person = getAuthor(author);
const portrait = hasPortrait(person);
---
<aside class="author-bio card" aria-label={`About ${person.name}`}>
  {portrait ? (
    <img class="author-portrait" src={person.portrait} alt="" width="72" height="72" loading="lazy" decoding="async" />
  ) : (
    <span class="author-portrait author-initials" aria-hidden="true">{person.initials}</span>
  )}
  <div>
    <p class="author-name"><a href={person.url}>{person.name}</a></p>
    <p class="meta author-role">{person.role}</p>
    <p class="author-text">{person.bio}</p>
    <a class="btn-text" href="/review-methodology">How we review</a>
  </div>
</aside>

<style>
  .author-bio { display: flex; gap: var(--s3); padding: var(--s3); margin: var(--s5) 0; }
  .author-portrait {
    width: 72px; height: 72px; border-radius: 50%; flex: none;
    object-fit: cover; background: var(--brand-tint);
  }
  .author-initials {
    display: grid; place-items: center;
    font-family: var(--font-display); font-size: 1.6rem; color: var(--brand);
  }
  .author-name { margin: 0; font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; }
  .author-name a { color: var(--ink); text-decoration: none; }
  .author-name a:hover { color: var(--brand); text-decoration: underline; }
  .author-role { margin: 0 0 var(--s1); }
  .author-text { margin: 0 0 var(--s1); color: var(--ink-soft); }
</style>
