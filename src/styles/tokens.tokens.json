{
  "$description": "Sublime Pantry design tokens. DTCG-compatible token groups and aliases.",
  "color": {
    "brand": {
      "ink": { "$type": "color", "$value": "#000000" },
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "paper": { "$type": "color", "$value": "#FAF8F4" },
      "ice": { "$type": "color", "$value": "#B4D9EC" },
      "deepIce": { "$type": "color", "$value": "#7FB6D2" },
      "rust": { "$type": "color", "$value": "#8B4A21" }
    },
    "semantic": {
      "text": { "$type": "color", "$value": "#191713" },
      "muted": { "$type": "color", "$value": "#5D554D" },
      "surface": { "$type": "color", "$value": "{color.brand.paper}" },
      "raised": { "$type": "color", "$value": "{color.brand.white}" },
      "warm": { "$type": "color", "$value": "#F2ECE3" },
      "rustSoft": { "$type": "color", "$value": "#F1E2D6" },
      "border": { "$type": "color", "$value": "#D9D1C6" },
      "action": { "$type": "color", "$value": "{color.brand.rust}" },
      "actionHover": { "$type": "color", "$value": "#6F3517" },
      "info": { "$type": "color", "$value": "#315F73" },
      "success": { "$type": "color", "$value": "#2F694D" },
      "danger": { "$type": "color", "$value": "#96362F" }
    }
  },
  "font": { "family": {
    "display": { "$type": "fontFamily", "$value": ["Bodoni Moda", "Didot", "serif"] },
    "body": { "$type": "fontFamily", "$value": ["Source Sans 3", "system-ui", "sans-serif"] }
  }},
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "5": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 72, "unit": "px" } },
    "7": { "$type": "dimension", "$value": { "value": 96, "unit": "px" } }
  },
  "size": {
    "content": { "$type": "dimension", "$value": { "value": 72, "unit": "rem" } },
    "measure": { "$type": "dimension", "$value": { "value": 68, "unit": "ch" } },
    "control": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
    "panel": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 140, "unit": "ms" } },
    "normal": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } }
  }
}
