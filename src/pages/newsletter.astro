---
/**
 * The Dry Batch — what it is, before you are asked to subscribe to it.
 *
 * Every other signup on the site is a form beside an offer. This is the page
 * for the reader who wants to know what arrives before giving an address, so
 * it describes the email and then asks, in that order.
 *
 * It does not promise what each issue contains — M15 retired a per-issue
 * format nobody had confirmed we could meet.
 *
 * Issues are shown from the `issues` collection, and the page says only what
 * that collection supports. An issue with a `sentDate` is listed as a past
 * issue. One without is shown as a sample and labelled as not yet sent. Until
 * something has been sent, the page still says there are no back issues,
 * because there are none.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { allIssues, issueHref, issueLabel, longDate } from '../lib/issues';

const issues = await allIssues();
const sent = issues.filter((issue) => issue.data.sentDate);
const samples = issues.filter((issue) => !issue.data.sentDate);
---
<PageLayout
  title="The Dry Batch — a weekly freeze-drying email"
  description="A weekly email on batch decisions, troubleshooting and storage, with the sources to follow. Subscribers get the printable Starter Checklist."
  path="/newsletter"
  breadcrumbs={[{ label: 'Newsletter', href: '/newsletter' }]}
>
  <span class="kicker">Newsletter</span>
  <h1>The Dry Batch</h1>
  <p class="lede">A weekly email on batch decisions, troubleshooting and storage, with the sources to follow.</p>

  <p>It goes out once a week and covers the same ground as the site: what to change when a batch comes out wrong, how to decide between machines or containers, and what the published guidance actually says. Where a claim rests on a source, the email names it and links it, so you can disagree with us from the same page we read.</p>

  <h2>What you get when you subscribe</h2>
  <p>The printable <a href="/freeze-drying-starter-checklist">Starter Checklist</a> — one page of the checks worth running on every batch, from tray prep to a labelled sealed bag. It is free to open whether or not you subscribe; subscribing sends it to you so it is in your inbox when you need it.</p>
  <h2>What we hold it to</h2>
  <p>The same standard as everything published here. No shelf-life promises, no invented test results, and no advice we cannot point at a source for. Where the evidence runs out, the email says so rather than filling the gap with something that sounds right.</p>
  {sent.length > 0 ? (
    <>
      <h2>Past issues</h2>
      <p>Each issue is posted here a week after it goes to subscribers, as it was written.</p>
      <ul class="issue-list">
        {sent.map((issue) => (
          <li><a href={issueHref(issue)}>{issue.data.subject}</a> <span class="meta">{longDate(issue.data.date)}</span></li>
        ))}
      </ul>
    </>
  ) : (
    <p class="meta">There are no back issues to read yet. Once issues have gone out, each one is posted here a week after it goes to subscribers.</p>
  )}
  {samples.length > 0 && (
    <>
      <h2>Read a sample</h2>
      <ul class="issue-list">
        {samples.map((issue) => (
          <li><a href={issueHref(issue)}>{issue.data.subject}</a> <span class="meta">{issueLabel(issue)}</span></li>
        ))}
      </ul>
    </>
  )}

  <section class="signup" aria-labelledby="newsletter-signup-heading">
    <h2 id="newsletter-signup-heading" class="sr-only">Subscribe to The Dry Batch</h2>
    <Newsletter heading="Get the checklist and the weekly email" />
  </section>

  <p class="meta">Every issue carries an unsubscribe link, and we use your address only for the content described above. See our <a href="/privacy">privacy policy</a>.</p>
</PageLayout>

<style>
  .signup { margin: var(--s5) 0 var(--s4); }
  .issue-list { padding-left: 1.1rem; }
  .issue-list li { margin: 0 0 var(--s2); }
</style>
