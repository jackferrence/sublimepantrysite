---
import PageLayout from '../layouts/PageLayout.astro';
import Packshot from '../components/figures/Packshot.astro';
import OxygenIndicator from '../components/figures/OxygenIndicator.astro';
import SublimationCurve from '../components/figures/SublimationCurve.astro';
import ChamberCutaway from '../components/figures/ChamberCutaway.astro';
import SealSteps from '../components/figures/SealSteps.astro';
import PuffyBagTest from '../components/figures/PuffyBagTest.astro';
import VerdictBox from '../components/blocks/VerdictBox.astro';
import WhoFor from '../components/blocks/WhoFor.astro';
import LimitationsCallout from '../components/blocks/LimitationsCallout.astro';
import HonestyBlock from '../components/blocks/HonestyBlock.astro';
import ComparisonTable from '../components/blocks/ComparisonTable.astro';
import SpecSheet from '../components/blocks/SpecSheet.astro';
import PullQuote from '../components/blocks/PullQuote.astro';
import Aside from '../components/blocks/Aside.astro';
import { CATALOG } from '../lib/commerce.ts';

// Sample data for the Phase 3 guide blocks below — real SKU handles from
// CATALOG, invented "why"/spec text clearly scoped to this QA page. None of
// this is published guide content; it exists only to prove the components
// render against the real schema shape from src/content.config.ts.
// pricePerUnit deliberately omitted here (renders "—"): src/lib/commerce.ts
// is the one place a Sublime Pantry price is allowed to live
// (tests/claim-shapes.test.mjs enforces this), and per-unit math derived
// from it belongs in the real component/guide, not invented for this QA page.
const sampleTestedProducts = [
  { productHandle: 'quart-bags-8x12-50-pack-300cc-absorbers', mil: '7', capacityCc: '300cc', sealType: 'Heat seal', foodSafeCert: 'FDA-compliant film', note: 'QA sample row — not a published verdict.' },
  { productHandle: 'snack-bags-6x6-50-pack-absorbers', mil: '4.3', capacityCc: '100cc', sealType: 'Heat seal', foodSafeCert: 'FDA-compliant film', note: 'QA sample row — not a published verdict.' },
];
---
<PageLayout title="Design system" description="Internal visual quality-assurance reference." path="/design-system" width="wrap" breadcrumbs={[{ label: 'Design system', href: '/design-system' }]} noindex>
  <span class="kicker">Internal reference · noindex</span>
  <h1>Technical field guide, pantry warmth.</h1>
  <p class="lede">A durable visual QA page for the primitives and states used across editorial, tools, and commerce.</p>

  <section aria-labelledby="ds-color"><h2 id="ds-color">Color</h2><div class="swatches">
    <div class="ink">Ink</div><div class="paper">Paper</div><div class="ice">Ice · ink text</div><div class="deep-ice">Deep ice · ink text</div><div class="rust">Rust · white text</div><div class="warm">Warm surface</div>
  </div></section>

  <section aria-labelledby="ds-type"><h2 id="ds-type">Type</h2><p class="kicker">Source checked · 09 September 2026</p><h3>An editorial display</h3><p class="lede">Leads stay within a readable 45–60 character measure.</p><p>This body copy uses Source Sans 3 at a fluid size and a generous reading line-height. Article measures remain close to 62–72 characters.</p></section>

  <section aria-labelledby="ds-controls"><h2 id="ds-controls">Controls</h2><div class="control-row"><a class="btn btn-primary" href="#states">Primary action</a><a class="btn btn-secondary" href="#states">Secondary action</a><a href="#states">Inline link</a></div><label>Email address <input type="email" placeholder="you@example.com" /></label></section>

  <section id="states" aria-labelledby="ds-states"><h2 id="ds-states">Evidence and states</h2><div class="notice"><strong>What we could verify.</strong> The source and date are visible beside the decision.</div><div class="state-grid"><div class="field-note"><span class="kicker">Field note 04</span><h3>Fits this job</h3><p>Specific operational guidance lives directly on the paper field, bounded by a rule rather than another floating card.</p></div><div class="error" role="alert"><strong>Could not calculate.</strong><p>Check the labeled fields; the previous values remain available.</p></div></div></section>

  <section aria-labelledby="ds-table"><h2 id="ds-table">Data</h2><div class="table-scroll" tabindex="0" role="region" aria-label="Sample absorber data"><table><thead><tr><th scope="col">Container</th><th scope="col">Known capacity</th><th scope="col">Source state</th></tr></thead><tbody><tr><th scope="row">Pint bag</th><td>100cc</td><td>Published</td></tr><tr><th scope="row">Unknown vessel</th><td>—</td><td>Not published</td></tr></tbody></table></div></section>

  <section aria-labelledby="ds-figures">
    <h2 id="ds-figures">Figures</h2>
    <p class="kicker">docs/CLAUDE-CODE-PROMPT.md T2.4 · no original photography yet</p>
    <p>Flat vector packshots for the 8 SKUs, and the first of five technical diagrams. See docs/DECISIONS.md for which four diagrams remain.</p>
    <div class="packshot-grid">
      {CATALOG.map((product) => (
        <figure class="packshot-cell">
          <Packshot sku={product.handle} title={product.shortTitle} />
          <figcaption class="label">{product.shortTitle}</figcaption>
        </figure>
      ))}
    </div>
    <OxygenIndicator />
    <SublimationCurve />
    <ChamberCutaway />
    <SealSteps />
    <PuffyBagTest />
  </section>

  <section aria-labelledby="ds-guide-blocks">
    <h2 id="ds-guide-blocks">Guide blocks (Phase 3)</h2>
    <p class="kicker">docs/CLAUDE-CODE-PROMPT.md T3.2, T3.3, T3.4, T3.5, T3.6 · sample data, not published content</p>
    <p>Sold by Sublime Pantry. VerdictBox below renders a real CATALOG price — this line is the disclosure tests/claim-shapes.test.mjs requires on any page that does.</p>

    <h3>VerdictBox</h3>
    <VerdictBox label="Our pick" productHandle="quart-bags-8x12-50-pack-300cc-absorbers" why="QA sample — not a published verdict. Matched 300cc absorbers, no sizing math to do." />

    <h3>WhoFor</h3>
    <WhoFor whoFor={['You already own a freeze dryer and are packaging your first batches', 'You want bags matched to absorbers, not a sizing calculation']} whoNotFor={['You need bulk pricing above 100 units', 'You are packaging for commercial resale (see /start-selling)']} />

    <h3>ComparisonTable</h3>
    <ComparisonTable testedProducts={sampleTestedProducts} whyItMatters="Mil and cc rating are the two numbers that actually predict seal life — QA sample row." />

    <h3>HonestyBlock</h3>
    <HonestyBlock
      testedProducts={sampleTestedProducts}
      notTested={[{ name: 'Gallon-size bags', reason: 'Source quantity/spec mismatch not yet resolved — see docs/COMMERCE-ARCHITECTURE.md' }]}
    />

    <h3>LimitationsCallout</h3>
    <LimitationsCallout limitations="QA sample text. This callout is required on every published guide that compares products — see docs/CLAUDE-CODE-PROMPT.md T4.2." />

    <h3>SpecSheet</h3>
    <p>Real per-SKU facts, not sample data — every value here is copied from CATALOG. "—" means the catalog genuinely does not state that fact (see foodSafeCert).</p>
    <SpecSheet productHandle="quart-bags-8x12-50-pack-300cc-absorbers" />

    <h3>PullQuote</h3>
    <PullQuote text="Absorber size follows the air left in the bag, not the weight of the food." />

    <h3>Aside (marginalia)</h3>
    <p>Body copy runs alongside an Aside at 1100px+; below that it becomes an indented block. <Aside>A moisture meter is the only way to confirm "dry enough" — texture alone reads dry well before it is.</Aside> The rest of this paragraph keeps going so there is something for the float to sit beside.</p>
  </section>
</PageLayout>
<style>
  section { margin-block: var(--s6); }
  .swatches { display: grid; grid-template-columns: repeat(auto-fit,minmax(9rem,1fr)); }
  .swatches div { min-height: 8rem; padding: var(--s2); border: 1px solid var(--ink); }
  /* Swatches now reference the live tokens they're demonstrating (not a
     second, hand-typed copy of the hex values that could silently drift
     from the real palette) — also closes the one raw-hex stylelint
     violation this QA page carried since T1.1. */
  .ink { background: var(--sp-color-ink); color: var(--sp-color-white); }
  .paper { background: var(--sp-color-paper); }
  .ice { background: var(--sp-color-ice); }
  .deep-ice { background: var(--sp-color-iceDeep); }
  .rust { background: var(--sp-color-rust); color: var(--sp-color-white); }
  .warm { background: var(--sp-color-warm); }
  .control-row { display:flex;align-items:center;flex-wrap:wrap;gap:var(--s2);margin-bottom:var(--s3) }
  label { display:block;max-width:28rem }
  .state-grid { display:grid;gap:var(--s4);grid-template-columns:repeat(auto-fit,minmax(18rem,1fr));margin-top:var(--s4) }
  .field-note,.error { border-top:1px solid var(--ink);padding-top:var(--s2) }.error{border-color:var(--color-semantic-danger)}
  .packshot-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(9rem,1fr)); gap:var(--s3); margin-block:var(--s4); }
  .packshot-cell { margin:0; border:1px solid var(--mist); padding:var(--s2); text-align:center; }
  .packshot-cell svg { width:100%; height:auto; aspect-ratio:1/1; }
  .packshot-cell figcaption { margin-top:var(--s1); }
</style>
