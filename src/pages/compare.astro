---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const order = ['home-freeze-dryers', 'storage-containers'];
const listingKicker: Record<string, string> = { 'home-freeze-dryers': 'machines', 'storage-containers': 'storage' };
// The listing page uses shorter curated blurbs, distinct from each article's
// full meta description.
const listingDescription: Record<string, string> = {
  'home-freeze-dryers': 'Price, capacity, power, pump, and warranty. Every figure comes from manufacturer documentation, with access dates.',
  'storage-containers': 'The three legitimate storage systems for freeze-dried food, compared on barrier quality, cost per unit, resealability, and fitness for selling vs. pantry use.',
};
const entries = (await getCollection('articles', ({ data }) => data.pillar === 'compare')).sort(
  (a, b) => order.indexOf(a.id) - order.indexOf(b.id),
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Comparisons with stated criteria',
    description: "Every comparison declares its criteria and its evidence, and is explicit about what we have and haven't tested ourselves.",
    url: 'https://www.sublimepantry.com/compare.html',
    isPartOf: { '@id': 'https://www.sublimepantry.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: entries.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://www.sublimepantry.com/compare/${e.id}`,
        name: e.data.title,
      })),
    },
  },
];
---
<PageLayout title="Comparisons" description="Evidence-based freeze-drying comparisons with stated criteria: machines, packaging, and storage options, with every figure sourced." path="/compare" jsonLd={jsonLd}>
  <span class="kicker">Comparisons</span>
  <h1>Comparisons with stated criteria</h1>
  <p style="max-width:60ch;color:var(--ink-soft);">Every comparison declares its criteria and its evidence, and is explicit about what we have and haven't tested ourselves.</p>

  {entries.map((entry) => (
    <a class="card" style="display:flex;gap:1.5rem;align-items:baseline;flex-wrap:wrap;margin:1.4rem 0;padding:1.5rem 1.7rem;text-decoration:none;" href={`/compare/${entry.id}`}>
      <span class="kicker" style="flex:0 0 auto;">{listingKicker[entry.id]}</span>
      <div style="flex:1 1 24rem;">
        <h2 style="margin:.1rem 0 .5rem;color:var(--frost-deep);">{entry.data.title}</h2>
        <p style="color:var(--ink-soft);margin-bottom:0;">{listingDescription[entry.id]}</p>
      </div>
    </a>
  ))}
</PageLayout>
