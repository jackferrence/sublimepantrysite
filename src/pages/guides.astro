---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import EditorialListing from '../components/EditorialListing.astro';
import { newestFirst } from '../lib/articles';

const entries = (await getCollection('articles', ({ data }) => data.pillar === 'guides')).sort(newestFirst);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Freeze-drying guides',
    description: 'Long-form, source-cited guides that define how we think about machines, batches, and the cottage business behind them.',
    url: 'https://www.sublimepantry.com/guides/',
    isPartOf: { '@id': 'https://www.sublimepantry.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: entries.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://www.sublimepantry.com/guides/${e.id}`,
        name: e.data.title,
      })),
    },
  },
];
---
<PageLayout
  title="Find the next step for your freeze-drying project"
  description="Flagship guides for home freeze-drying: choosing a machine, running clean batches, and turning your freeze dryer into a cottage business."
  path="/guides"
  breadcrumbs={[{ label: 'Guides', href: '/guides' }]}
  width="wrap"
  jsonLd={jsonLd}
>
  <span class="kicker">Guides</span>
  <h1>Find the next step for your freeze-drying project.</h1>
  <p class="lede">Practical, source-cited guidance for choosing a machine, running a batch and evaluating a small food business.</p>

  <EditorialListing entries={entries} leadId="complete-batch-workflow" />

  <section class="hub-next" aria-labelledby="specific-problem">
    <h2 id="specific-problem">Have a specific problem?</h2>
    <p>Start with the symptom if a batch, package or machine is not behaving as expected. The troubleshooting pages take one symptom at a time.</p>
    <a class="btn btn-secondary" href="/troubleshooting">Find a troubleshooting guide</a>
  </section>
</PageLayout>

<style>
  .hub-grid { margin-top: var(--s4); }
  .hub-next { margin-top: var(--s5); padding: var(--s4) 0; border-top: 1px solid var(--ink); }
  .hub-next h2 { margin: 0 0 var(--s2); font-size: var(--h3); }
  .hub-next p { color: var(--ink-soft); max-width: 62ch; }
</style>
