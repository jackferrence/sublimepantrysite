---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Card from '../components/Card.astro';
import { articleHref, newestFirst } from '../lib/articles';

const entries = (await getCollection('articles', ({ data }) => data.pillar === 'guides')).sort(newestFirst);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Freeze-drying guides',
    description: 'Long-form, source-cited guides that define how we think about machines, batches, and the cottage business behind them.',
    url: 'https://www.sublimepantry.com/guides/',
    isPartOf: { '@id': 'https://www.sublimepantry.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: entries.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://www.sublimepantry.com/guides/${e.id}`,
        name: e.data.title,
      })),
    },
  },
];
---
<PageLayout
  title="Freeze-Drying Guides"
  description="Flagship guides for home freeze-drying: choosing a machine, running clean batches, and turning your freeze dryer into a cottage business."
  path="/guides"
  breadcrumbs={[{ label: 'Guides', href: '/guides' }]}
  width="wrap"
  jsonLd={jsonLd}
>
  <span class="kicker">Guides</span>
  <h1>Freeze-drying guides</h1>
  <p class="lede">Long-form, source-cited guides that define how we think about machines, batches, and the cottage business behind them.</p>

  <div class="card-grid hub-grid">
    {entries.map((entry) => (
      <Card
        href={articleHref(entry)}
        title={entry.data.title}
        dek={entry.data.description}
        headingLevel={2}
        kicker={entry.data.section ?? entry.data.kicker}
        image={entry.data.image?.src}
        imageAlt={entry.data.image?.alt}
        transitionName={`sp-title-${entry.id}`}
      />
    ))}
  </div>
</PageLayout>

<style>
  .hub-grid { margin-top: var(--s4); }
</style>
