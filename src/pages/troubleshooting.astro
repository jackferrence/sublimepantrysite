---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Card from '../components/Card.astro';
import { heroImage, articleHref, newestFirst } from '../lib/articles';

// Listing copy leads with the symptom a reader searches for; each article's own
// title leads with the diagnosis. Both are deliberate, so the hub keeps its own.
const listing: Record<string, { title: string; description: string }> = {
  'batch-not-dry': {
    title: "Food isn't fully dry, especially on the center trays",
    description: 'Why center-tray food comes out cool, flexible, or dark in the middle, and the checks that fix it, in the order to try them.',
  },
  'chewy-candy': {
    title: "Candy is chewy, melted, or didn't puff",
    description: "Chewy centers, melted puddles, or candy that never puffed: each failure has a distinct cause, whether that's spacing, settings, or a candy that fundamentally won't work.",
  },
  'vacuum-error': {
    title: "Machine shows a vacuum error or won't pull down",
    description: "A vacuum error means the chamber can't reach or hold pressure. Here's the leak hunt in order of likelihood: door gasket, drain valve, hose, then pump.",
  },
  'rehydration-problems': {
    title: 'Rehydrated food is tough, mushy, or tastes flat',
    description: "Rehydration failures trace back to three places: how the food was dried, how it's being rehydrated, and what that food can ever be again, plus the food-safety rule that applies.",
  },
  'storage-failure': {
    title: 'Stored food went soft, stale, or off',
    description: 'Freeze-dried food that went soft, stale, or off in storage failed at one of five points: dryness, packaging, absorber, seal, or environment. Find yours.',
  },
};

const entries = (await getCollection('articles', ({ data }) => data.pillar === 'troubleshooting')).sort(newestFirst);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Fix this batch',
    description: 'One symptom per page, with the likely causes in order and the fix for each.',
    url: 'https://www.sublimepantry.com/troubleshooting/',
    isPartOf: { '@id': 'https://www.sublimepantry.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: entries.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://www.sublimepantry.com/troubleshooting/${e.id}`,
        name: listing[e.id]?.title ?? e.data.title,
      })),
    },
  },
];
---
<PageLayout
  title="Freeze Dryer Troubleshooting"
  description="Narrow, specific fixes for common home freeze-drying failures: batches that aren't dry, vacuum errors, chewy candy, rehydration problems, and storage failures."
  path="/troubleshooting"
  breadcrumbs={[{ label: 'Troubleshooting', href: '/troubleshooting' }]}
  width="wrap"
  jsonLd={jsonLd}
>
  <span class="kicker">Troubleshooting</span>
  <h1>Fix this batch</h1>
  <p class="lede">One symptom per page, with the likely causes in order and the fix for each.</p>

  <div class="card-grid hub-grid">
    {entries.map((entry) => (
      <Card
        href={articleHref(entry)}
        title={listing[entry.id]?.title ?? entry.data.title}
        dek={listing[entry.id]?.description ?? entry.data.description}
        headingLevel={2}
        kicker="Symptom"
        image={heroImage(entry)?.src}
        imageAlt={heroImage(entry)?.alt}
        badge={entry.data.riskClass === 'elevated' ? 'Food-safety check' : undefined}
        transitionName={`sp-title-${entry.id}`}
      />
    ))}
  </div>
</PageLayout>

<style>
  .hub-grid { margin-top: var(--s4); }
</style>
