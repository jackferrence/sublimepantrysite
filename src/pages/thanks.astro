---
/**
 * Post-submission page for the lead form.
 *
 * The qualifying question lives here rather than on the form itself: the email
 * is already captured, so asking costs nothing. It posts to the same Netlify
 * form, keyed to the address the previous step stored in this tab.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
---
<PageLayout
  title="Thanks"
  description="Your checklist is ready."
  path="/thanks"
  breadcrumbs={[{ label: 'Thanks', href: '/thanks' }]}
  noindex
>
  <!--
    Two states, and the served HTML is the cold one.

    This page said "Confirmed" and "your first issue arrives within a week" to
    anyone who opened the URL, including someone who had never submitted
    anything — the same defect class as a buy box asserting "In stock" before
    any inventory is fetched. The success state is now revealed only on evidence
    that this tab actually submitted the signup form.

    Rendering the cold state by default is the safe direction: a real subscriber
    with JavaScript off sees a page that gives them the checklist without
    claiming anything about their subscription, rather than a stranger being
    told they subscribed.
  -->
  <div data-signup-confirmed hidden>
    <span class="kicker"><Icon name="check-circle" size={14} /> Confirmed</span>
    <h1>Got it — your checklist is ready.</h1>
    <p>The printable Freeze-Drying Starter Checklist is below. Your first issue of <strong>The Dry Batch</strong> arrives within a week.</p>
    <p><a class="btn btn-primary" href="/freeze-drying-starter-checklist">Open the Starter Checklist</a></p>
  </div>

  <div data-signup-cold>
    <span class="kicker">Starter checklist</span>
    <h1>The Freeze-Drying Starter Checklist</h1>
    <p>One printable page of the checks worth running on every batch. It is free to open whether or not you subscribe.</p>
    <p><a class="btn btn-primary" href="/freeze-drying-starter-checklist">Open the Starter Checklist</a></p>
    <p class="meta">This page normally confirms a newsletter signup. If you have landed here directly, nothing has been submitted — the signup form is at the bottom of any page.</p>
  </div>

  <section class="stage card" aria-labelledby="stage-heading" data-signup-confirmed hidden>
    <h2 id="stage-heading">One quick question.</h2>
    <p>It decides what we send you first. Skip it if you'd rather not say.</p>

    <form name="freeze-drying-checklist" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="bot-field" data-astro-reload>
      <input type="hidden" name="form-name" value="freeze-drying-checklist" />
      <input type="hidden" name="lead_magnet" value="freeze-drying-starter-checklist" />
      <input type="hidden" name="source_path" value="/thanks" />
      <!--
        What this submission IS, declared by the form rather than inferred from
        the page it was rendered on. The backends used to classify a follow-up by
        source_path === "/thanks", but the footer newsletter form is on this page
        too and reports the same path — so a real, consented signup made from the
        footer here was classified as a preference update and silently dropped by
        both Klaviyo and Shopify while returning success.

        marketing_consent is deliberately NOT sent. A preference update must never
        create consent; the person either already consented at signup or they did
        not, and answering a survey is not an opt-in.
      -->
      <input type="hidden" name="submission_type" value="lifecycle_preference" />
      <p hidden aria-hidden="true"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <div class="stage-field" data-email-field hidden>
        <label for="stage-email">Email address</label>
        <input id="stage-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" />
      </div>

      <div class="stage-field">
        <label for="freeze-dryer-stage">Where are you right now?</label>
        <select id="freeze-dryer-stage" name="stage" required>
          <option value="" selected disabled>Select one</option>
          <option value="considering">Considering a freeze dryer</option>
          <option value="new-owner">New owner / first batches</option>
          <option value="active-owner">Already freeze-drying regularly</option>
          <option value="cottage-seller">Selling or planning to sell</option>
        </select>
      </div>

      <!--
        U07: "Send" names the mechanism, not the outcome. The button now says
        what the submission does, and the skip is a control rather than a
        sentence — "skip it if you'd rather not say" is only an offer if there
        is something to press.
      -->
      <div class="stage-actions">
        <button class="btn btn-primary" type="submit">Save my preference</button>
        <button class="stage-skip" type="button" data-stage-skip>Skip this question</button>
      </div>
    </form>

    <p class="stage-skipped" data-stage-skipped hidden>Skipped. Nothing was sent.</p>
  </section>
</PageLayout>

<script is:inline>
  (function () {
    // Reveal the success state only when this tab submitted the signup form.
    var submitted = null;
    try {
      submitted = sessionStorage.getItem('sp-signup-submitted');
    } catch (err) {
      /* private mode: the cold state stands, which is the safe direction */
    }
    if (submitted) {
      document.querySelectorAll('[data-signup-confirmed]').forEach(function (el) { el.hidden = false; });
      var cold = document.querySelector('[data-signup-cold]');
      if (cold) cold.hidden = true;
    }

    // The skip is a real dismissal: the question goes away and nothing is sent.
    var skip = document.querySelector('[data-stage-skip]');
    if (skip) {
      skip.addEventListener('click', function () {
        var form = document.querySelector('.stage form');
        if (form) form.hidden = true;
        var note = document.querySelector('[data-stage-skipped]');
        if (note) note.hidden = false;
      });
    }

    var form = document.querySelector('.stage form');
    if (!form) return;
    var stored = null;
    try {
      stored = sessionStorage.getItem('sp-lead-email');
    } catch (err) {
      /* private mode */
    }
    var field = form.querySelector('[data-email-field]');
    var input = form.querySelector('#stage-email');
    if (stored && input) {
      input.value = stored;
    } else if (field && input) {
      // No address in this tab — ask for it rather than filing an orphan row.
      field.hidden = false;
      input.required = true;
    }
  })();
</script>

<style>
  .stage { margin: var(--s5) 0; padding: var(--s4); }
  .stage h2 { margin: 0 0 var(--s1); }
  .stage p { color: var(--ink-soft); }
  .stage-field { margin: var(--s2) 0; max-width: 26rem; }
  .stage-field label { display: block; margin-bottom: .35rem; font-size: .9rem; }
  .stage-actions { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; }
  /* Quieter than the submit, but still a real control with a real target. */
  .stage-skip {
    background: none; border: 0; padding: .5rem 0; min-height: 44px;
    color: var(--brand); font: inherit; text-decoration: underline; cursor: pointer;
  }
  .stage-skip:hover { color: var(--brand-hover); }
  .stage-skipped { margin: 0; }
</style>
