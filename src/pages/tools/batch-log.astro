---
import PageLayout from '../../layouts/PageLayout.astro';
import Newsletter from '../../components/Newsletter.astro';
---
<PageLayout
  title="Batch Log & Cost Tracker"
  description="Free freeze-drying batch log: record food, load, cycle hours, costs, and water-activity readings. See your real cost per batch and per bag. Data stays in your browser; export CSV anytime."
  path="/tools/batch-log"
  breadcrumbs={[{ label: 'Batch Log', href: '/tools/batch-log' }]}
  width="wrap"
>
  <div class="batch-log">
    <span class="kicker">Free tool</span>
    <h1>Batch Log &amp; Cost Tracker</h1>
    <p class="lede">Every batch you log makes your machine more predictable and your pricing more honest. Data is stored <strong>only in this browser</strong> — we never see it. Export to CSV for backup or your cottage-food records.</p>

    <div class="card tool-panel">
      <form id="batch-form" novalidate data-astro-reload>
        <fieldset>
          <legend>The batch</legend>
          <div class="field-grid">
            <div><label for="f-date">Date</label><input type="date" id="f-date" required aria-describedby="f-date-error" /><p class="field-error" id="f-date-error" hidden>Enter the date this batch ran.</p></div>
            <div><label for="f-food">Food</label><input type="text" id="f-food" placeholder="e.g. Skittles, strawberries" required aria-describedby="f-food-error" /><p class="field-error" id="f-food-error" hidden>Enter what you dried.</p></div>
            <div><label for="f-load">Load (lb fresh)</label><input type="number" id="f-load" min="0" step="0.1" placeholder="12" /></div>
            <div><label for="f-hours">Total cycle hours</label><input type="number" id="f-hours" min="0" step="0.5" placeholder="28" /></div>
          </div>
        </fieldset>
        <fieldset>
          <legend>Costs &amp; output</legend>
          <div class="field-grid">
            <div><label for="f-ingcost">Ingredient cost ($)</label><input type="number" id="f-ingcost" min="0" step="0.01" placeholder="15.00" /></div>
            <div><label for="f-eleccost">Electricity ($)</label><input type="number" id="f-eleccost" min="0" step="0.01" placeholder="1.50" /></div>
            <div><label for="f-packcost">Packaging ($)</label><input type="number" id="f-packcost" min="0" step="0.01" placeholder="10.50" /></div>
            <div><label for="f-bags">Bags/jars produced</label><input type="number" id="f-bags" min="0" step="1" placeholder="30" /></div>
          </div>
        </fieldset>
        <fieldset>
          <legend>Quality record (for sellers)</legend>
          <div class="field-grid">
            <div><label for="f-aw">Water activity (aw)</label><input type="number" id="f-aw" min="0" max="1" step="0.001" placeholder="0.28" /></div>
            <div>
              <label for="f-check">24-hour seal check</label>
              <select id="f-check">
                <option value="">Not checked</option>
                <option value="pass">Pass</option>
                <option value="fail">Fail</option>
              </select>
            </div>
            <div class="field-wide">
              <label for="f-notes">Notes (settings, spacing, what you'd change)</label>
              <input type="text" id="f-notes" placeholder="Extra 2h dry time; center tray marginal" />
            </div>
          </div>
        </fieldset>
        <button class="btn btn-primary" type="submit" data-sp-event="tool_batch_logged">Log this batch</button>
      </form>
    </div>

    <h2>Your numbers</h2>
    <div class="stat-row" id="stats" aria-live="polite">
      <div class="stat"><div class="label">Batches logged</div><div class="value" id="s-count">0</div></div>
      <div class="stat"><div class="label">Avg cycle hours</div><div class="value" id="s-hours">–</div></div>
      <div class="stat"><div class="label">Avg cost / batch</div><div class="value" id="s-batchcost">–</div></div>
      <div class="stat"><div class="label">Avg cost / bag</div><div class="value" id="s-bagcost">–</div></div>
    </div>

    <h2>Log</h2>
    <div class="table-scroll">
      <table id="log-table" class="tool-table">
        <thead>
          <tr>
            <th scope="col">Date</th><th scope="col">Food</th><th scope="col">Load lb</th><th scope="col">Hours</th><th scope="col">Cost $</th><th scope="col">Bags</th><th scope="col">$/bag</th><th scope="col">aw</th><th scope="col">24h</th><th scope="col">Notes</th><th scope="col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody id="log-body"></tbody>
      </table>
    </div>
    <p id="empty-note" class="meta empty-note">No batches yet. Log your first one above.</p>
    <p class="tool-actions">
      <button class="btn btn-secondary" id="export-btn" type="button" data-sp-event="tool_csv_export">Export CSV</button>
      <button class="btn btn-secondary" id="clear-btn" type="button">Delete all data</button>
    </p>

    <div class="notice" role="note">
      <strong>Want this as a real app?</strong> We're exploring a cross-device batch-log app with cloud backup, per-food cycle predictions, and printable cottage-food records. <a href="/contact">Tell us</a> if you'd use it — reader interest decides whether we build it.
    </div>

    <Newsletter />
  </div>

  <style is:global>
    .batch-log { padding-bottom: var(--s6); }
    .tool-panel { padding: var(--s4); margin: var(--s4) 0; }
    .tool-panel fieldset { border: 0; padding: 0; margin: 0 0 var(--s4); }
    .tool-panel legend {
      padding: 0; margin-bottom: var(--s2);
      font-family: var(--font-body); font-size: var(--kicker); font-weight: 600;
      text-transform: uppercase; letter-spacing: .08em; color: var(--brand);
    }
    .field-grid { display: grid; gap: var(--s3); grid-template-columns: 1fr; }
    @media (min-width: 620px) { .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .field-grid label { display: block; margin-bottom: .35rem; font-size: .9rem; }
    .field-wide { grid-column: 1 / -1; }

    .stat-row { display: grid; gap: var(--s2); grid-template-columns: repeat(2, 1fr); margin: var(--s3) 0; }
    @media (min-width: 720px) { .stat-row { grid-template-columns: repeat(4, 1fr); } }
    .stat {
      background: var(--surface); border: 1px solid var(--mist);
      border-radius: var(--radius); padding: var(--s2);
    }
    .stat .label { font-size: var(--kicker); text-transform: uppercase; letter-spacing: .08em; color: var(--ink-soft); }
    .stat .value {
      font-family: var(--font-display); font-size: 1.6rem; line-height: 1.2;
      font-variant-numeric: tabular-nums; color: var(--ink);
    }

    .tool-table { min-width: 44rem; font-size: .9rem; }
    .del-btn {
      background: none; border: 0; padding: .4rem .3rem; margin: -.4rem -.3rem;
      color: var(--brand); font: inherit; font-size: .85rem;
      text-decoration: underline; cursor: pointer; min-height: 24px;
    }
    .empty-note[hidden] { display: none; }
    .tool-actions { display: flex; flex-wrap: wrap; gap: var(--s2); margin-top: var(--s3); }

    .field-error { color: var(--brand); margin: .3rem 0 0; font-size: .82rem; font-weight: 600; }
    .field-grid input.has-error { border-color: var(--brand); }

    /*
      Under 640px the ten-column log stops being a table and becomes one card
      per batch. Each cell keeps its column name in `data-label`, written by the
      render function, and prints it as the row label.
    */
    @media (max-width: 639px) {
      .table-scroll { overflow-x: visible; box-shadow: none; }
      .tool-table { min-width: 0; }
      .tool-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
      .tool-table tbody, .tool-table tr, .tool-table td { display: block; width: 100%; }
      .tool-table tr {
        background: var(--surface); border: 1px solid var(--mist);
        border-radius: var(--radius); padding: var(--s2); margin-bottom: var(--s2);
      }
      .tool-table td {
        border: 0; border-bottom: 1px solid var(--mist);
        display: flex; justify-content: space-between; gap: var(--s2);
        padding: .35rem 0; text-align: right;
      }
      .tool-table td:last-child { border-bottom: 0; }
      .tool-table td::before {
        content: attr(data-label);
        font-size: var(--kicker); text-transform: uppercase; letter-spacing: .06em;
        color: var(--ink-soft); text-align: left; flex: none;
      }
      .tool-table td:empty { display: none; }
    }
  </style>

  <script>
    (function () {
      'use strict';
      const KEY = 'sp-batch-log-v1';

      interface BatchRow {
        date: string;
        food: string;
        load: number | null;
        hours: number | null;
        ingCost: number | null;
        elecCost: number | null;
        packCost: number | null;
        bags: number | null;
        aw: number | null;
        check: string;
        notes: string;
      }

      function load(): BatchRow[] {
        try {
          return JSON.parse(localStorage.getItem(KEY) || '[]');
        } catch {
          return [];
        }
      }
      function save(rows: BatchRow[]) {
        try {
          localStorage.setItem(KEY, JSON.stringify(rows));
        } catch {
          /* storage unavailable */
        }
      }
      function num(id: string): number | null {
        const el = document.getElementById(id) as HTMLInputElement | null;
        const v = parseFloat(el?.value ?? '');
        return isNaN(v) ? null : v;
      }
      function money(v: number | null) {
        return v == null ? '–' : '$' + v.toFixed(2);
      }

      function withTransition(fn: () => void) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const doc = document as Document & { startViewTransition?: (cb: () => void) => void };
        if (!reduceMotion && typeof doc.startViewTransition === 'function') {
          doc.startViewTransition(fn);
        } else {
          fn();
        }
      }

      function totalCost(r: BatchRow) {
        let t = 0;
        let any = false;
        [r.ingCost, r.elecCost, r.packCost].forEach((c) => {
          if (c != null) {
            t += c;
            any = true;
          }
        });
        return any ? t : null;
      }

      function render() {
        const rows = load();
        const body = document.getElementById('log-body')!;
        body.textContent = '';
        (document.getElementById('empty-note') as HTMLElement).hidden = rows.length > 0;

        rows.forEach((r, i) => {
          const tr = document.createElement('tr');
          const cost = totalCost(r);
          const perBag = cost != null && r.bags ? cost / r.bags : null;
          const cells = [
            r.date || '',
            r.food || '',
            r.load != null ? r.load : '',
            r.hours != null ? r.hours : '',
            cost != null ? cost.toFixed(2) : '',
            r.bags != null ? r.bags : '',
            perBag != null ? perBag.toFixed(2) : '',
            r.aw != null ? r.aw : '',
            r.check || '',
            r.notes || '',
          ];
          const labels = ['Date', 'Food', 'Load lb', 'Hours', 'Cost $', 'Bags', '$/bag', 'aw', '24h', 'Notes'];
          cells.forEach((c, ci) => {
            const td = document.createElement('td');
            // Read by the <640px stacked-card layout, which hides the header row.
            td.dataset.label = labels[ci];
            td.textContent = String(c);
            tr.appendChild(td);
          });
          const tdDel = document.createElement('td');
          tdDel.dataset.label = '';
          const btn = document.createElement('button');
          btn.className = 'del-btn';
          btn.type = 'button';
          btn.textContent = 'delete';
          btn.setAttribute('aria-label', 'Delete batch from ' + (r.date || 'unknown date'));
          btn.addEventListener('click', () => {
            const all = load();
            all.splice(i, 1);
            save(all);
            withTransition(render);
          });
          tdDel.appendChild(btn);
          tr.appendChild(tdDel);
          body.appendChild(tr);
        });

        document.getElementById('s-count')!.textContent = String(rows.length);
        const hrs = rows.map((r) => r.hours).filter((v): v is number => v != null);
        const costs = rows.map(totalCost).filter((v): v is number => v != null);
        const perBags = rows
          .map((r) => {
            const c = totalCost(r);
            return c != null && r.bags ? c / r.bags : null;
          })
          .filter((v): v is number => v != null);
        function avg(a: number[]) {
          return a.length ? a.reduce((x, y) => x + y, 0) / a.length : null;
        }
        const ah = avg(hrs);
        const ac = avg(costs);
        const ab = avg(perBags);
        document.getElementById('s-hours')!.textContent = ah == null ? '–' : ah.toFixed(1);
        document.getElementById('s-batchcost')!.textContent = money(ac);
        document.getElementById('s-bagcost')!.textContent = money(ab);
      }

      document.getElementById('batch-form')!.addEventListener('submit', (e) => {
        e.preventDefault();
        const foodEl = document.getElementById('f-food') as HTMLInputElement;
        const dateEl = document.getElementById('f-date') as HTMLInputElement;
        const foodError = document.getElementById('f-food-error') as HTMLElement;
        const dateError = document.getElementById('f-date-error') as HTMLElement;
        const food = foodEl.value.trim();
        const date = dateEl.value;
        dateError.hidden = Boolean(date);
        foodError.hidden = Boolean(food);
        dateEl.classList.toggle('has-error', !date);
        foodEl.classList.toggle('has-error', !food);
        if (!food || !date) {
          if (!date) dateEl.focus();
          else foodEl.focus();
          return;
        }
        const rows = load();
        rows.unshift({
          date,
          food,
          load: num('f-load'),
          hours: num('f-hours'),
          ingCost: num('f-ingcost'),
          elecCost: num('f-eleccost'),
          packCost: num('f-packcost'),
          bags: num('f-bags'),
          aw: num('f-aw'),
          check: (document.getElementById('f-check') as HTMLSelectElement).value,
          notes: (document.getElementById('f-notes') as HTMLInputElement).value.trim(),
        });
        save(rows);
        (e.target as HTMLFormElement).reset();
        withTransition(render);
      });

      document.getElementById('export-btn')!.addEventListener('click', () => {
        const rows = load();
        const header = [
          'date', 'food', 'load_lb', 'total_hours', 'ingredient_cost', 'electricity_cost',
          'packaging_cost', 'total_cost', 'bags', 'cost_per_bag', 'water_activity', 'seal_check_24h', 'notes',
        ];
        function esc(v: unknown) {
          const s = v == null ? '' : String(v);
          return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
        }
        const lines = [header.join(',')].concat(
          rows.map((r) => {
            const cost = totalCost(r);
            const perBag = cost != null && r.bags ? (cost / r.bags).toFixed(4) : '';
            return [
              r.date, r.food, r.load, r.hours, r.ingCost, r.elecCost, r.packCost,
              cost != null ? cost.toFixed(2) : '', r.bags, perBag, r.aw, r.check, r.notes,
            ].map(esc).join(',');
          }),
        );
        const blob = new Blob([lines.join('\n')], { type: 'text/csv' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'sublime-pantry-batch-log.csv';
        document.body.appendChild(a);
        a.click();
        a.remove();
      });

      document.getElementById('clear-btn')!.addEventListener('click', () => {
        if (confirm('Delete all logged batches from this browser? Export a CSV first if you want a backup.')) {
          try {
            localStorage.removeItem(KEY);
          } catch {
            /* ignore */
          }
          withTransition(render);
        }
      });

      document.getElementById('f-date')!.addEventListener('input', (e) => {
        (document.getElementById('f-date-error') as HTMLElement).hidden = true;
        (e.target as HTMLElement).classList.remove('has-error');
      });
      document.getElementById('f-food')!.addEventListener('input', (e) => {
        (document.getElementById('f-food-error') as HTMLElement).hidden = true;
        (e.target as HTMLElement).classList.remove('has-error');
      });

      render();
    })();
  </script>
</PageLayout>
