    width: 100%; min-height: 44px; padding: 0.5rem 0.6rem;
    font-size: 1rem; border: 1px solid currentColor; border-radius: var(--radius-control); background: transparent;
  }
  .help { font-size: 0.875rem; line-height: 1.5; opacity: 0.85; margin: 0.4rem 0 0; }
  .caveat { font-size: 0.875rem; line-height: 1.5; opacity: 0.85; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .chip {
