  .flag {
    font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em;
    border: 1px solid currentColor; border-radius: var(--radius-control); padding: 0.1rem 0.35rem; opacity: 0.8;
  }
  .results { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1.5rem; }
  .result { border-top: 2px solid currentColor; padding-top: 0.75rem; }
  .result h3 { margin: 0 0 0.4rem; font-size: 0.95rem; }
  .big { font-size: 1.75rem; font-weight: 700; margin: 0 0 0.3rem; line-height: 1.2; }
  /* A missing figure is a result, not an error: same weight, no alarm colour. */
  .notpub { font-size: 1.05rem; font-weight: 600; opacity: 0.9; }
  .formula { font-size: 0.875rem; margin: 0 0 0.3rem; opacity: 0.85; }
  .attribution { margin-top: 1.25rem; font-size: 0.875rem; }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  th, td { text-align: left; padding: 0.55rem 0.6rem; border-bottom: 1px solid currentColor; vertical-align: top; }
  tr.you th, tr.you td { font-weight: 700; }

  @media (max-width: 719px) {
    .grid, .results { grid-template-columns: minmax(0, 1fr); }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    tr { display: block; border: 1px solid currentColor; border-radius: var(--radius-panel); margin-bottom: 0.75rem; padding: 0.25rem 0.5rem; }
    th, td { display: block; border: 0; padding: 0.35rem 0; }
    th[data-label]::before, td[data-label]::before {
      content: attr(data-label); display: block; font-size: 0.75rem;
      text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.7;
    }
  }

  :global(html[data-embed='1']) [data-embed-hide] { display: none !important; }
  :global(html[data-embed='1']) .tmc { padding: 0.75rem; }
  :global(html[data-embed='1']) .panel { margin: 0; }
</style>
