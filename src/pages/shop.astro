---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopifyStore from '../components/ShopifyStore.astro';
import LaunchOffer from '../components/LaunchOffer.astro';
import { CATALOG, LAUNCH_OFFER, SHOPIFY_PUBLIC_DOMAIN } from '../lib/commerce';

// Every card's title, image and copy is server-rendered. Shopify supplies only
// live price, availability and the cart — so the page is complete and indexable
// before (and without) the Storefront JS.
const cartDiscountCodes = LAUNCH_OFFER.enabled ? LAUNCH_OFFER.code : undefined;
---
<BaseLayout
  title="Freeze-drying supplies"
  description="Shop Sublime Pantry freeze-drying packaging supplies. Product pricing and availability come directly from Shopify; checkout is securely handled by Shopify."
  path="/shop"
>
  <ShopifyStore />

  <div class="wrap shop-page">
    <header class="shop-hero">
      <span class="kicker">Sublime Pantry Shop</span>
      <h1>Freeze-drying supplies, without the junk drawer.</h1>
      <p class="lede">A deliberately small catalog for packaging and storing freeze-dried food. Our starter kit is currently being sold at its retail source cost while we validate the product and fulfillment workflow.</p>
    </header>

    <LaunchOffer placement="shop-hero" />

    <section class="validation-note card" aria-label="Validation launch details">
      <span class="kicker">Early validation</span>
      <strong>No markup on the starter kit right now.</strong>
      <p>The starter kit is sourced directly from PackFreshUSA at its current retail price and manually ordered to the customer after purchase. This lets us validate demand before moving to bulk inventory and branded fulfillment.</p>
    </section>

    <section aria-labelledby="available-now">
      <div class="section-head">
        <div>
          <span class="kicker">Available now</span>
          <h2 id="available-now">Packaging essentials</h2>
        </div>
        <button
          class="btn btn-ghost"
          type="button"
          data-sp-event="cart_open"
          data-sp-props={JSON.stringify({ placement: 'shop-header' })}
          onclick="document.getElementById('sublime-cart').showModal()"
        >View cart</button>
      </div>

      <div class="shop-grid">
        {CATALOG.map((product) => (
          <article class="shop-card">
            <div class="shop-card-media">
              <img
                src={product.image}
                alt={product.imageAlt}
                width="640"
                height="640"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="shop-card-body">
              <span class="kicker">{product.eyebrow}</span>
              <h3>{product.title}</h3>
              <p>{product.note}</p>

              <shopify-context type="product" handle={product.handle}>
                <template>
                  <div data-commerce-ready>
                  <div class="shop-price">
                    <shopify-money query="product.selectedOrFirstAvailableVariant.price" format="money_with_currency"></shopify-money>
                  </div>
                  <div class="shop-actions">
                    <button
                      class="btn btn-primary"
                      type="button"
                      onclick="document.getElementById('sublime-cart').addLine(event).showModal();"
                      shopify-attr--disabled="!product.selectedOrFirstAvailableVariant.availableForSale"
                      data-sp-event="shop_add_to_cart"
                      data-sp-props={JSON.stringify({ product_handle: product.handle, sku: product.sku })}
                    >Add to cart</button>
                  </div>
                  </div>
                </template>
                <div shopify-loading-placeholder>
                  <div class="shop-price shop-price--pending">{product.displayPrice}</div>
                  <p class="shop-pending">Confirming current price and availability with Shopify…</p>
                </div>
              </shopify-context>

              <div class="commerce-fallback" data-commerce-fallback hidden>
                <p>Live pricing is temporarily unavailable.</p>
                <a class="btn btn-ghost" href={`https://${SHOPIFY_PUBLIC_DOMAIN}/products/${product.handle}`} rel="noopener">View this product on our Shopify store</a>
              </div>

              {product.detailsHref && (
                <p class="shop-details-link">
                  <a
                    class="text-link"
                    href={product.detailsHref}
                    data-sp-event="product_card_click"
                    data-sp-props={JSON.stringify({ product_handle: product.handle })}
                  >See what's included →</a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="shop-coming card" aria-labelledby="coming-next">
      <span class="kicker">Next after validation</span>
      <h2 id="coming-next">Refills and expanded packaging.</h2>
      <p>Additional oxygen absorber refills, quart and gallon packaging, and candy pouches are already staged in Shopify. They stay unlisted until each source configuration and fulfillment detail is verified.</p>
      <a class="btn btn-ghost" href="/guides/complete-batch-workflow">Read the packaging workflow</a>
    </section>
  </div>

  <shopify-cart id="sublime-cart" target="_top" discountCodes={cartDiscountCodes}></shopify-cart>

  <style>
    .shop-page { padding-top: 3.5rem; padding-bottom: 4rem; }
    .shop-hero { max-width: 760px; margin-bottom: 1.5rem; }
    .shop-hero h1 { margin: .35rem 0 .8rem; }
    .validation-note { margin-bottom: 3rem; padding: 1.2rem 1.35rem; max-width: 760px; }
    .validation-note strong { display: block; margin: .35rem 0 .4rem; }
    .validation-note p { margin: 0; color: var(--ink-soft); }
    .shop-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 420px)); gap: 1.25rem; }
    .shop-card { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--paper, #fff); }
    .shop-card-media { aspect-ratio: 1; background: #f4f6f7; }
    .shop-card-media img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .shop-card-body { padding: 1.35rem; }
    .shop-card-body h3 { margin: .35rem 0 .65rem; font-size: 1.3rem; line-height: 1.25; }
    .shop-card-body p { color: var(--ink-soft); }
    .shop-price { font-weight: 700; font-size: 1.15rem; margin: 1rem 0 .85rem; }
    .shop-price--pending { opacity: .6; }
    .shop-pending { font-size: .85rem; color: var(--ink-soft); margin: 0; }
    .shop-actions { display: flex; gap: .65rem; flex-wrap: wrap; }
    .shop-details-link { margin: 1rem 0 0; }
    .commerce-fallback { margin: 1rem 0 0; }
    .commerce-fallback p { margin: 0 0 .7rem; color: var(--ink-soft); font-size: .92rem; }
    .text-link { font-weight: 700; }
    .shop-coming { margin-top: 2.5rem; padding: 1.6rem; }
    .shop-coming h2 { margin: .35rem 0 .7rem; }
    .shop-coming p { max-width: 70ch; color: var(--ink-soft); }
    shopify-cart::part(primary-button) { border-radius: 4px; }
  </style>
</BaseLayout>
