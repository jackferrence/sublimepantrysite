---
/**
 * The shop.
 *
 * Every card's title, image, price and copy is server-rendered. Shopify's web
 * components hydrate the live price and the add-to-cart button on top of that,
 * so the page is complete, indexable and purchasable-by-link before (and
 * without) the Storefront JS — and no customer ever sees a loading string.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import { CATALOG, CATEGORY_ORDER, SHOPIFY_PUBLIC_DOMAIN } from '../lib/commerce';

const groups = CATEGORY_ORDER.map((category) => ({
  category,
  products: CATALOG.filter((p) => p.category === category),
})).filter((group) => group.products.length > 0);
---
<PageLayout
  title="Freeze-drying supplies"
  description="Shop Sublime Pantry freeze-drying packaging supplies. Product pricing and availability come directly from Shopify; checkout is securely handled by Shopify."
  path="/shop"
  breadcrumbs={[{ label: 'Shop', href: '/shop' }]}
  width="wrap"
  commerce
>
  <span class="kicker">Sublime Pantry Shop</span>
  <h1>Freeze-drying supplies, without the junk drawer.</h1>
  <p class="lede">A deliberately small catalog for packaging and storing freeze-dried food. We stock the things that actually get used after a batch comes out of the dryer, and nothing else.</p>

  <div class="notice">
    <p><strong>Validation launch.</strong> The starter kit is sourced from PackFreshUSA and ordered to you directly after purchase, so it arrives in the manufacturer's own packaging. We are validating demand before moving to held inventory and branded fulfillment.</p>
  </div>

  {groups.map((group) => (
    <section class="shop-group" aria-labelledby={`group-${group.category.toLowerCase()}`}>
      <h2 id={`group-${group.category.toLowerCase()}`}>{group.category}</h2>
      <div class="card-grid">
        {group.products.map((product) => (
          <article class="card product-card">
            <div class="product-card-media">
              <Img
                src={product.image}
                alt={product.imageAlt}
                width={640}
                height={800}
                sizes="(min-width: 900px) 22rem, 100vw"
                class="product-card-img"
              />
            </div>

            <div class="product-card-body">
              <span class="kicker">{product.eyebrow}</span>
              <h3><a href={product.detailsHref ?? `https://${SHOPIFY_PUBLIC_DOMAIN}/products/${product.handle}`}>{product.title}</a></h3>
              <p class="product-card-note">{product.note}</p>

              <shopify-context type="product" handle={product.handle}>
                <template>
                  <div class="product-card-buy" data-commerce-ready>
                    <p class="product-price">
                      <shopify-money query="product.selectedOrFirstAvailableVariant.price" format="money_with_currency"></shopify-money>
                    </p>
                    <button
                      class="btn btn-primary"
                      type="button"
                      onclick="document.getElementById('sublime-cart').addLine(event).showModal();"
                      shopify-attr--disabled="!product.selectedOrFirstAvailableVariant.availableForSale"
                      data-sp-cart-add
                      data-sp-event="shop_add_to_cart"
                      data-sp-props={JSON.stringify({ product_handle: product.handle, sku: product.sku })}
                    >Add to cart</button>
                  </div>
                </template>

                <div class="product-card-buy" shopify-loading-placeholder>
                  <p class="product-price">{product.displayPrice}</p>
                </div>
              </shopify-context>

              <p class="product-ships"><Icon name="package" size={15} /> Ships free · US</p>

              <div class="commerce-fallback" data-commerce-fallback hidden>
                <p>Live pricing is temporarily unavailable.</p>
                <a class="btn btn-secondary" href={`https://${SHOPIFY_PUBLIC_DOMAIN}/products/${product.handle}`} rel="noopener">View this product on our Shopify store</a>
              </div>

              {product.detailsHref && (
                <p class="product-details">
                  <a
                    class="btn-text"
                    href={product.detailsHref}
                    data-sp-event="product_card_click"
                    data-sp-props={JSON.stringify({ product_handle: product.handle })}
                  >Details</a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="card shop-coming" aria-labelledby="coming-next">
    <span class="kicker">Next after validation</span>
    <h2 id="coming-next">Refills and expanded packaging.</h2>
    <p>Additional oxygen absorber refills, quart and gallon packaging, and candy pouches are already staged in Shopify. They stay unlisted until each source configuration and fulfillment detail is verified.</p>
    <a class="btn btn-secondary" href="/guides/complete-batch-workflow">Read the packaging workflow</a>
  </section>
</PageLayout>

<style>
  .shop-group { margin-top: var(--s5); }
  .shop-group h2 { margin-top: 0; }

  .product-card { display: flex; flex-direction: column; }
  .product-card-media { aspect-ratio: 4 / 5; background: var(--brand-tint); }
  .product-card-media :global(.product-card-img) { width: 100%; height: 100%; object-fit: contain; display: block; }

  .product-card-body { padding: var(--s3); display: flex; flex-direction: column; gap: var(--s1); flex: 1; }
  .product-card-body h3 { margin: 0; font-size: var(--h3); }
  .product-card-body h3 a { color: var(--ink); text-decoration: none; }
  .product-card-body h3 a:hover { color: var(--brand); text-decoration: underline; }
  .product-card-note { margin: 0; color: var(--ink-soft); }

  .product-card-buy { margin-top: var(--s2); display: flex; flex-direction: column; gap: var(--s2); align-items: flex-start; }
  .product-price {
    margin: 0; font-family: var(--font-display); font-size: var(--price);
    font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .product-ships {
    margin: 0; display: flex; align-items: center; gap: .4rem;
    font-size: .9rem; color: var(--ink-soft);
  }
  .product-details { margin: auto 0 0; padding-top: var(--s2); }

  .shop-coming { margin-top: var(--s6); padding: var(--s4); }
  .shop-coming h2 { margin: 0 0 var(--s2); }
  .shop-coming p { color: var(--ink-soft); max-width: 70ch; }
</style>
