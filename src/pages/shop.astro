---
/**
 * The shop.
 *
 * Every card's title, image, price and availability is server-rendered.
 * Shopify's web components hydrate the live price and the add-to-cart button on
 * top of that, so the page is complete, indexable and purchasable-by-link
 * before (and without) the Storefront JS — and no customer ever sees a loading
 * string.
 *
 * Availability is the part that cannot be left to hydration. `stockedCatalog()`
 * resolves it at build from Shopify and fails closed, so a card that offers to
 * sell you something is a card Shopify confirmed we can sell. See lib/stock.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import Newsletter from '../components/Newsletter.astro';
import {
  LINE_ORDER,
  LINE_LABEL,
  SHIPPING,
  SHOPIFY_PUBLIC_DOMAIN,
  ownedEyebrow,
} from '../lib/commerce';
import { stockedCatalog, NOT_STOCKED_LABEL, stockNoteFor } from '../lib/stock';

const catalog = await stockedCatalog();

const groups = LINE_ORDER.map((line) => ({
  line,
  label: LINE_LABEL[line],
  products: catalog.filter((p) => p.line === line),
})).filter((group) => group.products.length > 0);
---
<PageLayout
  title="Freeze-drying supplies"
  description="Shop Sublime Pantry freeze-drying packaging supplies: mylar snack bags, oxygen absorbers, a bag sealer, and complete sets. Pricing and availability come from Shopify; checkout is handled by Shopify."
  path="/shop"
  breadcrumbs={[{ label: 'Shop', href: '/shop' }]}
  width="wrap"
  commerce
>
  <span class="kicker">Sublime Pantry Shop</span>
  <h1>Freeze-drying supplies, without the junk drawer.</h1>
  <p class="lede">A deliberately small catalog for packaging and storing freeze-dried food. We stock the things that actually get used after a batch comes out of the dryer, and nothing else.</p>

  <div class="notice">
    <p><strong>How these ship.</strong> Everything on this page is held here and packed by us. <a href="/shipping-returns">Shipping and returns</a> covers handling times and the returns window.</p>
    <p>For the bag packs and the absorber refills a heat sealer is required and is not included — the two sets on this page are the ones that come with it.</p>
  </div>

  {groups.map((group) => (
    <section class="shop-group" aria-labelledby={`group-${group.line}`}>
      <h2 id={`group-${group.line}`}>{group.label}</h2>
      <div class="supply-shelf">
        {group.products.map((product) => (
          <article class:list={['product-card', { 'product-card--bundle': product.line === 'bundle' }] }>
            {product.image && (
              <div class="product-card-media">
                <Img
                  src={product.image}
                  alt={product.imageAlt}
                  width={640}
                  height={800}
                  sizes="(min-width: 900px) 22rem, 100vw"
                  class="product-card-img"
                />
              </div>
            )}

            <div class="product-card-body">
              <span class="kicker">{ownedEyebrow(product)}</span>
              <h3><a href={product.detailsHref ?? `https://${SHOPIFY_PUBLIC_DOMAIN}/products/${product.handle}`}>{product.title}</a></h3>
              <p class="product-card-note">{product.note}</p>

              {product.inStock ? (
                <div class="product-card-purchase">
                  <shopify-context type="product" handle={product.handle}>
                    <template>
                      <div class="product-card-buy" data-commerce-ready>
                        <p class="product-price">
                          <shopify-money query="product.selectedOrFirstAvailableVariant.price" format="money_with_currency"></shopify-money>
                        </p>
                        <button
                          class="btn btn-primary"
                          type="button"
                          onclick="document.getElementById('sublime-cart').addLine(event).showModal();"
                          shopify-attr--disabled="!product.selectedOrFirstAvailableVariant.availableForSale"
                          data-sp-cart-add
                          data-sp-event="shop_add_to_cart"
                          data-sp-props={JSON.stringify({ product_handle: product.handle, sku: product.sku })}
                        >Add to cart</button>
                      </div>
                    </template>

                    <div class="product-card-buy" shopify-loading-placeholder>
                      <p class="product-price">{product.displayPrice}</p>
                    </div>
                  </shopify-context>

                  <p class="product-ships"><Icon name="package" size={15} /> {SHIPPING.shortNote}</p>

                  <div class="commerce-fallback" data-commerce-fallback hidden>
                    <p>Live pricing is temporarily unavailable.</p>
                    <a class="btn btn-secondary" href={`https://${SHOPIFY_PUBLIC_DOMAIN}/products/${product.handle}`} rel="noopener">View this product on our Shopify store</a>
                  </div>
                </div>
              ) : (
                <div class="product-card-buy">
                  <p class="product-price">{product.displayPrice}</p>
                  <p class="product-unstocked"><Icon name="package" size={15} /> {NOT_STOCKED_LABEL}</p>
                  <p class="product-stock-note">{stockNoteFor(product)} <a href="#newsletter-heading">Join the newsletter</a>.</p>
                </div>
              )}

              {product.detailsHref && (
                <p class="product-details">
                  <a
                    class="btn-text"
                    href={product.detailsHref}
                    data-sp-event="product_card_click"
                    data-sp-props={JSON.stringify({ product_handle: product.handle })}
                  >Details</a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <Newsletter heading="Hear when the quart line lands" />
</PageLayout>

<style>
  .shop-group { margin-top: var(--s5); }
  .shop-group h2 { margin: 0; padding-bottom: var(--s2); border-bottom: 2px solid var(--ink); }

  .supply-shelf { display: grid; }
  .product-card { display: grid; grid-template-columns: minmax(9rem, .55fr) minmax(0, 1.45fr); gap: var(--s4); padding: var(--s4) 0; border-bottom: 1px solid var(--mist); }
  .product-card--bundle { grid-template-columns: minmax(12rem, .85fr) minmax(0, 1.15fr); background: var(--color-semantic-warm); padding-inline: var(--s3); }
  .product-card-media { aspect-ratio: 4 / 5; background: var(--surface); }
  .product-card-media :global(.product-card-img) { width: 100%; height: 100%; object-fit: contain; display: block; }

  .product-card-body { padding: var(--s2) var(--s3) var(--s2) 0; display: flex; flex-direction: column; gap: var(--s1); }
  .product-card-body h3 { margin: 0; font-size: var(--h3); }
  .product-card-body h3 a { color: var(--ink); text-decoration: none; }
  .product-card-body h3 a:hover { color: var(--brand); text-decoration: underline; }
  .product-card-note { margin: 0; color: var(--ink-soft); }

  .product-card-buy { margin-top: var(--s2); display: flex; flex-direction: column; gap: var(--s2); align-items: flex-start; }
  .product-price {
    margin: 0; font-family: var(--font-display); font-size: var(--price);
    font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .product-ships {
    margin: 0; display: flex; align-items: center; gap: .4rem;
    font-size: .9rem; color: var(--ink-soft);
  }
  .product-unstocked {
    margin: 0; display: flex; align-items: center; gap: .4rem;
    font-size: .9rem; font-weight: 600; color: var(--ink-soft);
  }
  .product-stock-note { margin: 0; font-size: .9rem; color: var(--ink-soft); }
  .product-details { margin: auto 0 0; padding-top: var(--s2); }
  @media (max-width: 639px) {
    .product-card, .product-card--bundle { grid-template-columns: 7.5rem minmax(0, 1fr); gap: var(--s2); padding-inline: 0; }
    .product-card-body { padding: 0; }
    .product-card-note { font-size: .92rem; }
  }
</style>
