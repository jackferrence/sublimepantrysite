---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Card from '../components/Card.astro';
import { articleHref, newestFirst } from '../lib/articles';

const entries = (await getCollection('articles', ({ data }) => data.pillar === 'recipes')).sort(newestFirst);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Freeze-drying recipes',
    description: 'Tested freeze-drying recipes with prep, cycle notes, and packaging guidance.',
    url: 'https://www.sublimepantry.com/recipes/',
    isPartOf: { '@id': 'https://www.sublimepantry.com/#website' },
  },
];
---
<PageLayout
  title="Freeze-Drying Recipes"
  description="Freeze-drying recipes with prep, cycle notes, dryness checks, and packaging guidance. Coming soon."
  path="/recipes"
  breadcrumbs={[{ label: 'Recipes', href: '/recipes' }]}
  width="wrap"
  jsonLd={jsonLd}
>
  <span class="kicker">Recipes</span>
  <h1>Freeze-drying recipes</h1>
  <p class="lede">Food-by-food prep, cycle notes, dryness checks, and packaging — written the same way as everything else here, or not published at all.</p>

  {entries.length > 0 ? (
    <div class="card-grid hub-grid">
      {entries.map((entry) => (
        <Card
          href={articleHref(entry)}
          title={entry.data.title}
          dek={entry.data.description}
          headingLevel={2}
        kicker={entry.data.section ?? entry.data.kicker}
          image={entry.data.image?.src}
          imageAlt={entry.data.image?.alt}
          transitionName={`sp-title-${entry.id}`}
        />
      ))}
    </div>
  ) : (
    <div class="empty card">
      <h2>No recipes are published yet.</h2>
      <p>A recipe earns a page here only when it carries the whole run: prep and slice thickness, how the trays were loaded, the cycle it took, the dryness check that decides it is finished, and how it was packaged afterwards. Anything short of that is a photograph with a list underneath it, and there are enough of those already.</p>
      <p class="empty-next">Until then, the two pages that do the same job:</p>
      <ul>
        <li><a href="/guides/complete-batch-workflow">The complete batch workflow</a> — tray prep through sealed mylar, in order</li>
        <li><a href="/troubleshooting">Troubleshooting</a> — what to change when a batch comes out wrong</li>
      </ul>
    </div>
  )}
</PageLayout>

<style>
  .hub-grid { margin-top: var(--s4); }
  .empty { margin-top: var(--s4); padding: var(--s4); max-width: var(--measure); }
  .empty h2 { margin: 0 0 var(--s2); }
  .empty p { color: var(--ink-soft); }
  .empty-next { margin-bottom: var(--s1); }
  .empty ul { margin: 0; padding-inline-start: 1.1rem; color: var(--ink-soft); }
  .empty li { margin: 0 0 .35rem; }
</style>
