---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopifyStore from '../../components/ShopifyStore.astro';
import LaunchOffer from '../../components/LaunchOffer.astro';
import ProductReviews from '../../components/ProductReviews.astro';
import { STARTER_KIT, LAUNCH_OFFER } from '../../lib/commerce';
import { getProductReviews } from '../../lib/reviews';

const reviews = await getProductReviews(STARTER_KIT);

// Product structured data deliberately omits `offers`. This is a static build:
// a price or availability baked in here would go stale the moment it changes in
// Shopify, and Shopify is the source of truth. See docs/COMMERCE-ARCHITECTURE.md
// for the build-hook prerequisite before adding offers.
const productSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: STARTER_KIT.title,
  description:
    'A first-batch packaging kit with 100 assorted 7 mil Mylar bags, 100 matched oxygen absorbers, 100 labels, and a food-storage guide.',
  image: [STARTER_KIT.image],
  sku: STARTER_KIT.sku,
  brand: { '@type': 'Brand', name: 'PackFreshUSA' },
};

// AggregateRating is emitted only when real, published reviews exist.
if (reviews.aggregate) {
  productSchema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: reviews.aggregate.ratingValue,
    reviewCount: reviews.aggregate.reviewCount,
  };
}

const cartDiscountCodes = LAUNCH_OFFER.enabled ? LAUNCH_OFFER.code : undefined;
const trackProps = JSON.stringify({
  product_handle: STARTER_KIT.handle,
  sku: STARTER_KIT.sku,
});
---
<BaseLayout
  title="Freeze-Dryer Packaging Starter Kit — 100 Bags"
  description="A simple first-batch packaging kit with 100 assorted 7 mil Mylar bags, 100 matched oxygen absorbers, 100 labels, and a storage guide."
  path="/shop/freeze-dryer-packaging-starter-kit"
  jsonLd={[productSchema]}
>
  <ShopifyStore />

  <div class="wrap product-page" data-sp-view="product_view" data-sp-props={trackProps}>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/shop">Shop</a> <span aria-hidden="true">/</span> Starter kit</nav>

    <section class="product-hero">
      <div class="product-media">
        <img
          src={STARTER_KIT.image}
          width="900"
          height="900"
          alt={STARTER_KIT.imageAlt}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="product-copy">
        <span class="kicker">Validation launch · current source-cost pricing</span>
        <h1>Freeze-Drying Packaging Starter Kit</h1>
        <p class="lede">Stop piecing together bags, absorber sizes, and labels one order at a time. This kit covers the packaging step for your first serious run of freeze-dried food with one matched set.</p>

        <shopify-context type="product" handle={STARTER_KIT.handle}>
          <template>
            <div class="commerce-block">
              <div class="price"><shopify-money query="product.selectedOrFirstAvailableVariant.price" format="money_with_currency"></shopify-money></div>
              <button
                class="btn btn-primary buy-button"
                type="button"
                onclick="document.getElementById('starter-cart').addLine(event).showModal();"
                shopify-attr--disabled="!product.selectedOrFirstAvailableVariant.availableForSale"
                data-sp-event="starter_kit_add_to_cart"
                data-sp-props={trackProps}
              >Add starter kit to cart</button>
              <p class="stock-note" shopify-attr--hidden="product.selectedOrFirstAvailableVariant.availableForSale">
                Currently out of stock. Shopify will reopen purchasing as soon as inventory is available.
              </p>
            </div>
          </template>
          <div class="commerce-loading" shopify-loading-placeholder>
            <span class="price">{STARTER_KIT.displayPrice}</span>
            <span class="btn btn-primary buy-button disabled" aria-disabled="true">Confirming availability…</span>
          </div>
        </shopify-context>

        <LaunchOffer placement="product-page" variant="slim" />

        <ul class="included">
          <li><strong>100 heavy-duty 7 mil Mylar bags</strong>: 30 pint, 40 quart, 30 gallon</li>
          <li><strong>100 matched oxygen absorbers</strong>: 30 × 100cc, 40 × 300cc, 30 × 500cc</li>
          <li><strong>100 adhesive labels</strong> for batch/date identification</li>
          <li><strong>PackFreshUSA food-storage guide</strong></li>
        </ul>
        <p class="fine">Checkout, taxes, payment, and order confirmation are handled securely by Shopify. Product availability is confirmed by Shopify before purchase. <button type="button" class="link-button" data-sp-event="cart_open" data-sp-props={JSON.stringify({ placement: 'product-page' })} onclick="document.getElementById('starter-cart').showModal()">View your cart</button>.</p>
      </div>
    </section>

    <ProductReviews reviews={reviews} />

    <section class="proof-grid" aria-label="Why this kit exists">
      <article class="card"><span class="kicker">Matched sizes</span><h2>No absorber-size guessing.</h2><p>The bag mix is paired with 100cc, 300cc, and 500cc absorbers so the common sizes arrive together instead of as disconnected supplies.</p></article>
      <article class="card"><span class="kicker">Built for batches</span><h2>Enough to learn your workflow.</h2><p>One hundred packages gives a new owner room to run multiple foods, label batches, and discover which bag sizes they actually use before buying bulk.</p></article>
      <article class="card"><span class="kicker">Validation price</span><h2>Priced at source cost while we validate.</h2><p>The launch price matches the current PackFreshUSA retail merchandise cost. We are testing demand and fulfillment before moving to bulk inventory and a branded supply line.</p></article>
    </section>

    <section class="how card">
      <span class="kicker">The storage step</span>
      <h2>Dry → verify → package → seal → label → store.</h2>
      <p>Packaging cannot rescue food that is still wet. Confirm the batch is fully dry first, then move efficiently into moisture- and oxygen-resistant storage. Mylar bags must be heat sealed after filling.</p>
      <div class="links">
        <a class="btn btn-ghost" href="/guides/complete-batch-workflow">Read the complete batch workflow</a>
        <a class="text-link" href="/freeze-drying-starter-checklist">Open the free starter checklist →</a>
      </div>
    </section>

    <section class="fit">
      <div>
        <span class="kicker">Good fit</span>
        <h2>This kit is for you if…</h2>
        <p>You already own a home freeze dryer, are about to run your first batches, or want one consolidated packaging restock rather than sourcing every component separately.</p>
        <ul class="fit-links">
          <li><a href="/troubleshooting/batch-not-dry">Check dryness before you package →</a></li>
          <li><a href="/compare/storage-containers">Mylar vs. jars vs. PETE →</a></li>
          <li><a href="/troubleshooting/storage-failure">Why sealed bags lose their crunch →</a></li>
        </ul>
      </div>
      <div>
        <span class="kicker">Not the point</span>
        <h2>This is not a freeze dryer.</h2>
        <p>It is the packaging and labeling system that comes after drying. If you are still choosing a machine, start with our buyer guide before buying supplies.</p>
        <ul class="fit-links">
          <li><a href="/guides/which-freeze-dryer">Choose a freeze dryer →</a></li>
          <li><a href="/compare/home-freeze-dryers">Compare the main brands →</a></li>
        </ul>
      </div>
    </section>
  </div>

  <shopify-cart id="starter-cart" target="_top" discountCodes={cartDiscountCodes}></shopify-cart>

  <style>
    .product-page { padding-top: 2rem; padding-bottom: 4rem; }
    .crumbs { margin-bottom: 1.4rem; color: var(--ink-soft); font-size: .92rem; }
    .crumbs span { margin: 0 .45rem; }
    .product-hero { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
    .product-media { aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: #f4f6f7; display: grid; place-items: center; }
    .product-media img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .product-copy h1 { margin: .45rem 0 .85rem; }
    .product-copy .lede { color: var(--ink-soft); font-size: 1.1rem; max-width: 58ch; }
    .commerce-block, .commerce-loading { margin: 1.2rem 0 1.4rem; }
    .price { display: block; font-weight: 800; font-size: 1.55rem; margin-bottom: .75rem; }
    .stock-note { margin: .7rem 0 0; color: var(--ink-soft); font-size: .9rem; max-width: 46ch; }
    .included { padding-left: 1.25rem; }
    .included li { margin: .65rem 0; }
    .buy-button { min-width: 230px; }
    .disabled { opacity: .65; pointer-events: none; }
    .fine { color: var(--ink-soft); font-size: .85rem; }
    .link-button { background: none; border: 0; padding: 0; font: inherit; color: inherit; text-decoration: underline; cursor: pointer; }
    .proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 4rem 0 1rem; }
    .proof-grid .card, .how { padding: 1.4rem; }
    .proof-grid h2, .how h2, .fit h2 { margin: .35rem 0 .65rem; font-size: 1.35rem; }
    .proof-grid p, .how p, .fit p { color: var(--ink-soft); }
    .how { margin: 1rem 0; }
    .links { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin-top: 1rem; }
    .text-link { font-weight: 700; }
    .fit { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 3rem; }
    .fit-links { list-style: none; padding: 0; margin: 1rem 0 0; }
    .fit-links li { margin: .5rem 0; }
    .fit-links a { font-weight: 600; }
    @media (max-width: 800px) { .product-hero, .fit { grid-template-columns: 1fr; } .proof-grid { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
