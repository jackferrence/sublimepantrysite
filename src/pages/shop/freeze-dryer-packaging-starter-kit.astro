---
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Card from '../../components/Card.astro';
import Icon from '../../components/Icon.astro';
import Img from '../../components/Img.astro';
import ProductReviews from '../../components/ProductReviews.astro';
import StickyBuyBar from '../../components/StickyBuyBar.astro';
import LaunchOffer from '../../components/LaunchOffer.astro';
import { STARTER_KIT, SHOPIFY_PUBLIC_DOMAIN } from '../../lib/commerce';
import { SUPPORT_EMAIL } from '../../lib/paths';
import { getProductReviews } from '../../lib/reviews';
import { articleHref } from '../../lib/articles';

const reviews = await getProductReviews(STARTER_KIT);
const workflow = await getEntry('articles', 'complete-batch-workflow');
const howTo = workflow?.data.howTo ?? [];

const relatedIds = ['complete-batch-workflow', 'storage-containers', 'storage-failure'];
const relatedGuides = (await getCollection('articles'))
  .filter((entry) => relatedIds.includes(entry.id))
  .sort((a, b) => relatedIds.indexOf(a.id) - relatedIds.indexOf(b.id));

const gallery = STARTER_KIT.images.length
  ? STARTER_KIT.images
  : [{ src: STARTER_KIT.image, alt: STARTER_KIT.imageAlt, kind: 'studio' as const, source: 'manufacturer' as const }];

const included = [
  '100 heavy-duty 7 mil Mylar bags: 30 pint, 40 quart, 30 gallon',
  '100 matched oxygen absorbers: 30 × 100cc, 40 × 300cc, 30 × 500cc',
  '100 adhesive labels for batch and date identification',
  "PackFreshUSA's food-storage guide",
];

const stillNeeded = [
  { label: 'A way to verify the batch is fully dry before you seal it', href: '/troubleshooting/batch-not-dry' },
  { label: 'A heat sealer — Mylar bags are not resealable without one', href: '/guides/complete-batch-workflow' },
  { label: 'A decision about jars or PETE for anything you open often', href: '/compare/storage-containers' },
  { label: 'Somewhere cool, dark and dry to keep the sealed bags', href: '/troubleshooting/storage-failure' },
];

const highlights = [
  'Absorber sizes are matched to the bag sizes, so there is nothing to work out at packaging time.',
  'One order instead of four, with shipping included.',
  '7 mil Mylar — a heavier barrier than the 3.5–5 mil bags sold in most starter packs.',
  'One hundred packages: enough to run several foods and learn which sizes you actually use before buying bulk.',
];

const specs: [string, string][] = [
  ['Mylar bag thickness', '7 mil'],
  ['Bags included', '100 (30 pint · 40 quart · 30 gallon)'],
  ['Oxygen absorbers included', '100 (30 × 100cc · 40 × 300cc · 30 × 500cc)'],
  ['Labels included', '100 adhesive'],
  ['Documentation', 'PackFreshUSA food-storage guide'],
  ['Manufacturer', 'PackFreshUSA'],
  ['Shipping', 'Free, US only'],
];

const faq = [
  {
    q: 'Do I need a heat sealer?',
    a: 'Yes. Mylar bags have to be heat sealed to hold a barrier; folding or taping them does not work. Any impulse sealer or a household iron on a firm edge will close a 7 mil bag.',
  },
  {
    q: 'Which absorber size goes with which bag?',
    a: 'The kit is matched: 100cc absorbers with the pint bags, 300cc with the quart bags, 500cc with the gallon bags. That pairing is why the kit exists — it removes the size guesswork.',
  },
  {
    q: 'Can I package a batch that is still slightly damp?',
    a: 'No. Packaging cannot rescue an under-dried batch, and sealing residual moisture into a bag is how stored food goes soft or spoils. Verify dryness first.',
  },
  {
    q: 'How long does it ship?',
    a: 'Orders are placed with PackFreshUSA after purchase and ship directly to you. See shipping and returns for current handling times and the returns window.',
  },
  {
    q: 'Are the bags reusable?',
    a: 'A bag can be cut open and re-sealed lower down a few times, losing capacity each time. Plan on one absorber per seal — an absorber exposed to air is spent.',
  },
  {
    q: 'Is this a freeze dryer?',
    a: 'No. It is the packaging and labeling step that comes after drying. If you are still choosing a machine, start with the buyer guide.',
  },
];

// Product structured data deliberately omits `offers`. This is a static build:
// a price or availability baked in here would go stale the moment it changes in
// Shopify, and Shopify is the source of truth. See docs/COMMERCE-ARCHITECTURE.md
// for the build-hook prerequisite before adding offers.
const productSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: STARTER_KIT.title,
  description:
    'A first-batch packaging kit with 100 assorted 7 mil Mylar bags, 100 matched oxygen absorbers, 100 labels, and a food-storage guide.',
  image: gallery.map((img) => img.src),
  sku: STARTER_KIT.sku,
  brand: { '@type': 'Brand', name: 'PackFreshUSA' },
};

// AggregateRating is emitted only when real, published reviews exist.
if (reviews.aggregate) {
  productSchema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: reviews.aggregate.ratingValue,
    reviewCount: reviews.aggregate.reviewCount,
  };
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const trackProps = JSON.stringify({ product_handle: STARTER_KIT.handle, sku: STARTER_KIT.sku });
---
<PageLayout
  title="Freeze-Dryer Packaging Starter Kit — 100 Bags"
  description="A simple first-batch packaging kit with 100 assorted 7 mil Mylar bags, 100 matched oxygen absorbers, 100 labels, and a storage guide."
  path="/shop/freeze-dryer-packaging-starter-kit"
  breadcrumbs={[
    { label: 'Shop', href: '/shop' },
    { label: 'Packaging', href: '/shop#group-packaging' },
    { label: 'Freeze-Drying Packaging Starter Kit', href: '/shop/freeze-dryer-packaging-starter-kit' },
  ]}
  width="wrap"
  jsonLd={[productSchema, faqSchema]}
  commerce
>
  <div data-sp-view="product_view" data-sp-props={trackProps}>
    <div class="pdp-top">
      <!-- Gallery -->
      <div class="gallery">
        <figure class="gallery-main">
          <Img
            src={gallery[0].src}
            alt={gallery[0].alt}
            width={800}
            height={1000}
            sizes="(min-width: 900px) 40rem, 100vw"
            loading="eager"
            fetchpriority="high"
            class="gallery-img"
          />
          {gallery[0].source === 'manufacturer' && <figcaption>Photo: manufacturer</figcaption>}
        </figure>

        {gallery.length > 1 && (
          <ul class="gallery-thumbs">
            {gallery.map((img) => (
              <li>
                <Img src={img.src} alt={img.alt} width={160} height={200} class="gallery-thumb" />
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Buy box -->
      <div class="buybox">
        <span class="kicker">Sold by Sublime Pantry · Validation launch</span>
        <h1>Freeze-Drying Packaging Starter Kit</h1>
        <p class="buybox-dek">One matched set of bags, absorbers and labels for your first serious run of freeze-dried food.</p>

        <shopify-context type="product" handle={STARTER_KIT.handle}>
          <template>
            <div class="buybox-commerce" data-commerce-ready>
              <p class="buybox-price">
                <shopify-money query="product.selectedOrFirstAvailableVariant.price" format="money_with_currency"></shopify-money>
              </p>
              <p class="buybox-stock" shopify-attr--hidden="!product.selectedOrFirstAvailableVariant.availableForSale">
                <Icon name="check-circle" size={15} /> In stock
              </p>
              <p class="buybox-stock" shopify-attr--hidden="product.selectedOrFirstAvailableVariant.availableForSale">
                Currently out of stock. Shopify reopens purchasing as soon as inventory is available.
              </p>
              <button
                class="btn btn-primary buybox-button"
                type="button"
                onclick="document.getElementById('sublime-cart').addLine(event).showModal();"
                shopify-attr--disabled="!product.selectedOrFirstAvailableVariant.availableForSale"
                data-sp-cart-add
                data-sp-event="starter_kit_add_to_cart"
                data-sp-props={trackProps}
              >Add to cart</button>
            </div>
          </template>

          <div class="buybox-commerce" shopify-loading-placeholder>
            <p class="buybox-price">{STARTER_KIT.displayPrice}</p>
            <p class="buybox-stock"><Icon name="check-circle" size={15} /> In stock</p>
            <a class="btn btn-primary buybox-button" href={`https://${SHOPIFY_PUBLIC_DOMAIN}/products/${STARTER_KIT.handle}`} rel="noopener">Add to cart</a>
          </div>
        </shopify-context>

        <p class="buybox-ships"><Icon name="package" size={15} /> Ships free · US only</p>

        <div class="commerce-fallback" data-commerce-fallback hidden>
          <p>Live pricing and checkout are temporarily unavailable on this page.</p>
          <a class="btn btn-secondary" href={`https://${SHOPIFY_PUBLIC_DOMAIN}/products/${STARTER_KIT.handle}`} rel="noopener" data-sp-event="storefront_fallback_click" data-sp-props={trackProps}>View the kit on our Shopify store</a>
        </div>

        <LaunchOffer placement="product-page" />

        <!-- Row two used to read "Packed & shipped by us", which contradicted
             /shipping-returns: during the validation launch PackFreshUSA ships
             the kit directly, in their own packaging. A buy box that disagrees
             with the shipping page is the kind of small dishonesty a customer
             discovers at the doorstep. -->
        <ul class="trust-rows">
          <li><Icon name="package" size={17} /> Sourced spec sheet from PackFreshUSA</li>
          <li><Icon name="shopping-bag" size={17} /> Ships direct from our supplier, PackFreshUSA</li>
          <li><Icon name="undo-2" size={17} /> <a href="/shipping-returns">30-day returns</a></li>
          <li><Icon name="shield-check" size={17} /> Secure Shopify checkout · <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
        </ul>
      </div>
    </div>

    <div class="pdp-body">
      <section class="two-up">
        <div>
          <h2>What's in the box</h2>
          <ul>{included.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h2>What you'll still need</h2>
          <ul>{stillNeeded.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
        </div>
      </section>

      <section>
        <h2>Highlights</h2>
        <ul>{highlights.map((item) => <li>{item}</li>)}</ul>
      </section>

      <section>
        <h2>Specifications</h2>
        <div class="table-scroll">
          <table>
            <caption>Figures from the PackFreshUSA product documentation for this kit.</caption>
            <tbody>
              {specs.map(([label, value]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <h2>How to use it</h2>
        <p>The kit covers the second half of the batch workflow: <strong>dry &rarr; verify &rarr; package &rarr; seal &rarr; label &rarr; store</strong>. Packaging cannot rescue food that is still wet, so confirm the batch is fully dry first, then move quickly into moisture- and oxygen-resistant storage. Mylar bags must be heat sealed after filling.</p>
        {howTo.length > 0 && (
          <ol class="howto">
            {howTo.map((step) => (
              <li><strong>{step.name}.</strong> {step.text}</li>
            ))}
          </ol>
        )}
        <p><a class="btn-text" href="/guides/complete-batch-workflow">Read the complete batch workflow</a></p>
      </section>

      <section>
        <h2>Questions</h2>
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>

      <ProductReviews reviews={reviews} />

    </div>

    <div class="pdp-wide">
      <section>
        <div class="section-head">
          <h2>Related guides</h2>
          <a class="btn-text" href="/guides">All guides</a>
        </div>
        <div class="card-grid">
          {relatedGuides.map((entry) => (
            <Card
              href={articleHref(entry)}
              title={entry.data.title}
              dek={entry.data.description}
              kicker={entry.data.section ?? entry.data.kicker}
              image={entry.data.image?.src}
              imageAlt={entry.data.image?.alt}
            />
          ))}
        </div>
      </section>

      <div class="notice">
        <p><strong>Next after validation.</strong> Absorber refills, quart and gallon packaging, and candy pouches are staged in Shopify. They stay unlisted until each source configuration and fulfillment detail is verified.</p>
      </div>
    </div>
  </div>

  <StickyBuyBar product={STARTER_KIT} />
</PageLayout>

<style>
  .pdp-top { display: grid; gap: var(--s4); }
  @media (min-width: 900px) {
    .pdp-top { grid-template-columns: 7fr 5fr; gap: var(--s6); align-items: start; }
    .buybox { position: sticky; top: var(--s7); }
  }

  .gallery-main { margin: 0; }
  .gallery-main :global(.gallery-img) {
    width: 100%; aspect-ratio: 4 / 5; object-fit: contain; display: block;
    background: var(--brand-tint); border-radius: var(--radius);
  }

  .gallery-thumbs {
    list-style: none; margin: var(--s2) 0 0; padding: 0;
    display: flex; gap: var(--s1); flex-wrap: wrap;
  }
  .gallery-thumbs li { margin: 0; }
  .gallery-thumbs :global(.gallery-thumb) {
    width: 5rem; height: 6.25rem; object-fit: contain;
    background: var(--brand-tint); border: 1px solid var(--mist); border-radius: var(--radius);
  }

  .buybox h1 { margin: 0 0 var(--s2); font-size: clamp(1.9rem, 3.4vw, 2.6rem); }
  .buybox-dek { color: var(--ink-soft); }

  .buybox-commerce { margin: var(--s3) 0 var(--s2); }
  .buybox-price {
    margin: 0 0 var(--s1);
    font-family: var(--font-display); font-size: var(--price);
    font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .buybox-stock {
    margin: 0 0 var(--s2);
    display: flex; align-items: center; gap: .4rem;
    font-size: .92rem; color: var(--ok);
  }
  .buybox-button { width: 100%; }

  .buybox-ships {
    margin: 0 0 var(--s2);
    display: flex; align-items: center; gap: .4rem;
    font-size: .92rem; color: var(--ink-soft);
  }

  .trust-rows { list-style: none; margin: 0; padding: 0; }
  .trust-rows li {
    display: flex; align-items: center; gap: .55rem;
    padding: .55rem 0; border-top: 1px solid var(--mist);
    font-size: .92rem; color: var(--ink-soft);
  }

  .pdp-body { max-width: var(--measure); margin-top: var(--s6); }
  .pdp-wide { margin-top: var(--s5); padding-bottom: var(--s6); }
  .pdp-wide section { margin-bottom: var(--s5); }
  .pdp-body section { margin-bottom: var(--s5); }
  .two-up { display: grid; gap: var(--s4); }
  @media (min-width: 720px) { .two-up { grid-template-columns: 1fr 1fr; } }
  .two-up h2 { margin-top: 0; }

  .howto li { margin: var(--s2) 0; }

  .pdp-body details { border-top: 1px solid var(--mist); padding: var(--s2) 0; }
  .pdp-body details:last-of-type { border-bottom: 1px solid var(--mist); }
  .pdp-body summary { cursor: pointer; font-weight: 600; font-family: var(--font-display); font-size: 1.1rem; }
  .pdp-body details p { margin: var(--s1) 0 0; color: var(--ink-soft); }

  /* Room for the mobile buy bar so it never covers the last section. */
  @media (max-width: 639px) { .pdp-wide { padding-bottom: 7rem; } }
</style>
