---
import BaseLayout from '../../layouts/BaseLayout.astro';

const shopifyDomain = 'zd-store-01m146jmxxhw739y7t7y11s669-paky1ta3.myshopify.com';
const handle = 'freeze-dryer-packaging-starter-kit-100';
const productImage = 'https://cdn.shopify.com/s/files/1/0883/4875/4197/files/packfreshusa-7mil-mylar-box-set-100-pack.jpg?v=1788393303';
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Freeze-Drying Packaging Starter Kit — 100 Bags + Absorbers + Labels',
  description: 'A first-batch packaging kit with 100 assorted 7 mil Mylar bags, 100 matched oxygen absorbers, 100 labels, and a food-storage guide.',
  image: [productImage],
  sku: 'MSMBS7MIL001',
  brand: { '@type': 'Brand', name: 'PackFreshUSA' },
};
---
<BaseLayout
  title="Freeze-Dryer Packaging Starter Kit — 100 Bags"
  description="A simple first-batch packaging kit with 100 assorted 7 mil Mylar bags, 100 matched oxygen absorbers, 100 labels, and a storage guide."
  path="/shop/freeze-dryer-packaging-starter-kit"
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)}></script>
  <script type="module" src="https://cdn.shopify.com/storefront/web-components.js"></script>
  <shopify-store id="sublime-pantry-store" store-domain={shopifyDomain} country="US" language="en"></shopify-store>

  <main class="wrap product-page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/shop">Shop</a> <span aria-hidden="true">/</span> Starter kit</nav>

    <section class="product-hero">
      <div class="product-media">
        <img
          src={productImage}
          width="900"
          height="900"
          alt="PackFreshUSA 7 mil Mylar bag, oxygen absorber, and label box set used for the Sublime Pantry freeze-drying packaging starter kit"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="product-copy">
        <span class="kicker">Validation launch · current source-cost pricing</span>
        <h1>Freeze-Drying Packaging Starter Kit</h1>
        <p class="lede">Stop piecing together bags, absorber sizes, and labels one order at a time. This kit covers the packaging step for your first serious run of freeze-dried food with one matched set.</p>

        <shopify-context type="product" handle={handle}>
          <template>
            <div class="commerce-block">
              <div class="price"><shopify-money query="product.selectedOrFirstAvailableVariant.price" format="money_with_currency"></shopify-money></div>
              <button
                class="btn btn-primary buy-button"
                type="button"
                onclick="document.getElementById('starter-cart').addLine(event).showModal();"
                shopify-attr--disabled="!product.selectedOrFirstAvailableVariant.availableForSale"
                data-sp-event="starter_kit_add_to_cart"
              >Add starter kit to cart</button>
            </div>
          </template>
          <div class="commerce-loading" shopify-loading-placeholder>
            <span class="price">$59.99 USD</span>
            <span class="btn btn-primary buy-button disabled" aria-disabled="true">Loading purchase options…</span>
          </div>
        </shopify-context>

        <ul class="included">
          <li><strong>100 heavy-duty 7 mil Mylar bags</strong>: 30 pint, 40 quart, 30 gallon</li>
          <li><strong>100 matched oxygen absorbers</strong>: 30 × 100cc, 40 × 300cc, 30 × 500cc</li>
          <li><strong>100 adhesive labels</strong> for batch/date identification</li>
          <li><strong>PackFreshUSA food-storage guide</strong></li>
        </ul>
        <p class="fine">Checkout, taxes, payment, and order confirmation are handled securely by Shopify. Product availability is confirmed by Shopify before purchase.</p>
      </div>
    </section>

    <section class="proof-grid" aria-label="Why this kit exists">
      <article class="card"><span class="kicker">Matched sizes</span><h2>No absorber-size guessing.</h2><p>The bag mix is paired with 100cc, 300cc, and 500cc absorbers so the common sizes arrive together instead of as disconnected supplies.</p></article>
      <article class="card"><span class="kicker">Built for batches</span><h2>Enough to learn your workflow.</h2><p>One hundred packages gives a new owner room to run multiple foods, label batches, and discover which bag sizes they actually use before buying bulk.</p></article>
      <article class="card"><span class="kicker">Validation price</span><h2>$59.99 while we validate.</h2><p>The launch price matches the current PackFreshUSA retail merchandise cost. We are testing demand and fulfillment before moving to bulk inventory and a branded supply line.</p></article>
    </section>

    <section class="how card">
      <span class="kicker">The storage step</span>
      <h2>Dry → verify → package → seal → label → store.</h2>
      <p>Packaging cannot rescue food that is still wet. Confirm the batch is fully dry first, then move efficiently into moisture- and oxygen-resistant storage. Mylar bags must be heat sealed after filling.</p>
      <div class="links"><a class="btn btn-ghost" href="/guides/complete-batch-workflow">Read the complete batch workflow</a><a class="text-link" href="/freeze-drying-starter-checklist">Open the free starter checklist →</a></div>
    </section>

    <section class="fit">
      <div><span class="kicker">Good fit</span><h2>This kit is for you if…</h2><p>You already own a home freeze dryer, are about to run your first batches, or want one consolidated packaging restock rather than sourcing every component separately.</p></div>
      <div><span class="kicker">Not the point</span><h2>This is not a freeze dryer.</h2><p>It is the packaging and labeling system that comes after drying. If you are still choosing a machine, start with our buyer guide before buying supplies.</p><a href="/guides/which-freeze-dryer">Choose a freeze dryer →</a></div>
    </section>
  </main>

  <shopify-cart id="starter-cart" target="_top"></shopify-cart>

  <style>
    .product-page { padding-top: 2rem; padding-bottom: 4rem; }
    .crumbs { margin-bottom: 1.4rem; color: var(--ink-soft); font-size: .92rem; }
    .crumbs span { margin: 0 .45rem; }
    .product-hero { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
    .product-media { aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: #f4f6f7; display: grid; place-items: center; }
    .product-media img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .product-copy h1 { margin: .45rem 0 .85rem; }
    .product-copy .lede { color: var(--ink-soft); font-size: 1.1rem; max-width: 58ch; }
    .commerce-block, .commerce-loading { margin: 1.2rem 0 1.4rem; }
    .price { display: block; font-weight: 800; font-size: 1.55rem; margin-bottom: .75rem; }
    .included { padding-left: 1.25rem; }
    .included li { margin: .65rem 0; }
    .buy-button { min-width: 230px; }
    .disabled { opacity: .65; pointer-events: none; }
    .fine { color: var(--ink-soft); font-size: .85rem; }
    .proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 4rem 0 1rem; }
    .proof-grid .card, .how { padding: 1.4rem; }
    .proof-grid h2, .how h2, .fit h2 { margin: .35rem 0 .65rem; font-size: 1.35rem; }
    .proof-grid p, .how p, .fit p { color: var(--ink-soft); }
    .how { margin: 1rem 0; }
    .links { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin-top: 1rem; }
    .text-link { font-weight: 700; }
    .fit { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 3rem; }
    @media (max-width: 800px) { .product-hero, .fit { grid-template-columns: 1fr; } .proof-grid { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
