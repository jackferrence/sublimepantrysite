---
/**
 * The generic product page.
 *
 * One template for every catalog product. It had an exception — the boxed
 * Freeze-Drying Packaging Starter Kit kept a hand-built page, because it was a
 * supplier's set that we drop-shipped rather than something we packed. That
 * product is archived and every remaining item is assembled from our own
 * stock, so there is nothing left for a second template to express.
 *
 * Everything a buyer needs to decide is server-rendered: title, price,
 * availability, contents, what they still have to supply, and the questions.
 * Shopify's web components hydrate live price and add-to-cart on top.
 *
 * Availability comes from `stockedCatalog()`, which fails closed. A product
 * Shopify did not confirm as purchasable renders the unstocked state and emits
 * no add-to-cart control and no `<shopify-context>` that could hydrate one.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/Icon.astro';
import Newsletter from '../../components/Newsletter.astro';
import StickyBuyBar from '../../components/StickyBuyBar.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import EditorialToolLink from '../../components/EditorialToolLink.astro';
import SpecSheet from '../../components/blocks/SpecSheet.astro';
import {
  LINE_LABEL,
  SHIPPING,
  SHOPIFY_PUBLIC_DOMAIN,
  OWNERSHIP_LABEL,
  ownedEyebrow,
} from '../../lib/commerce';
import ProductReviews from '../../components/ProductReviews.astro';
import { getProductReviews } from '../../lib/reviews';
import { stockedCatalog, NOT_STOCKED_LABEL, stockNoteFor } from '../../lib/stock';
import { SUPPORT_EMAIL } from '../../lib/paths';
import { articleHref } from '../../lib/articles';

export async function getStaticPaths() {
  // Declared inside, not above: Astro extracts getStaticPaths into its own
  // module at build, so anything it closes over from the frontmatter is
  // undefined by the time it runs.
  const catalog = await stockedCatalog();
  return catalog.map((product) => ({ params: { handle: product.handle }, props: { product } }));
}

const { product } = Astro.props;

const articles = await getCollection('articles');
const related = product.relatedArticles
  .map((id) => articles.find((entry) => entry.id === id))
  .filter((entry): entry is (typeof articles)[number] => Boolean(entry));

/**
 * docs/CLAUDE-CODE-PROMPT.md T4.4: "Used in these guides" — distinct from
 * `related` above, which is a hand-curated editorial pointer. This is
 * derived: any published guide whose `testedProducts[]` (T2.1) names this
 * exact handle, meaning a real ComparisonTable/HonestyBlock on that guide
 * actually discusses this SKU. No guide sets `testedProducts` yet (T2.1 —
 * the fields are new and unused by any published content), so this
 * renders nothing today; it activates automatically the first time a
 * guide does.
 */
const usedInGuides = articles.filter(
  (entry) =>
    entry.data.pillar === 'guides' &&
    (entry.data.testedProducts ?? []).some((tp) => tp.productHandle === product.handle),
);

/**
 * Judge.me reviews, fetched at build for this product.
 *
 * Every product gets this, not one: the kit's hand-built page was the only
 * caller until 2026-09-09, so archiving it left the whole integration wired to
 * nothing. Judge.me renders nothing when a product has no published reviews —
 * ProductReviews omits the section entirely rather than showing an empty state
 * — so there is no placeholder risk in asking for all eight.
 */
const reviews = await getProductReviews(product);

const path = `/shop/${product.handle}`;
const trackProps = JSON.stringify({ product_handle: product.handle, sku: product.sku });
const productToolHref = product.line === 'snack'
  ? '/tools/trail-meal-cost'
  : product.category === 'Packaging'
    ? '/tools/absorber-calculator'
    : product.line === 'bundle'
      ? '/tools/batch-planner'
      : null;

/**
 * Product structured data, with offers.
 *
 * `availability` is the build-time answer from Shopify, the same one the visible
 * buy box renders — so the page and its structured data cannot disagree with
 * each other. They can both go stale between deploys if inventory moves in
 * Shopify without a rebuild; that is a deploy-cadence problem, and the honest
 * mitigation is the deploy hook noted in docs/COMMERCE-ARCHITECTURE.md, not a
 * more optimistic value here.
 */
const price = product.displayPrice.replace(/[^0-9.]/g, '');
const productSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.note,
  sku: product.sku,
  brand: { '@type': 'Brand', name: 'PackFreshUSA' },
  offers: {
    '@type': 'Offer',
    url: new URL(path, Astro.site).href,
    priceCurrency: 'USD',
    price,
    availability: product.inStock
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    seller: { '@type': 'Organization', name: 'Sublime Pantry' },
  },
};

// AggregateRating is emitted only when real, published reviews exist. Emitting
// it otherwise would be a rating claim with nothing behind it.
if (reviews.aggregate) {
  productSchema.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: reviews.aggregate.ratingValue,
    reviewCount: reviews.aggregate.reviewCount,
  };
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: product.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<PageLayout
  title={product.shortTitle}
  description={product.note}
  path={path}
  breadcrumbs={[
    { label: 'Shop', href: '/shop' },
    { label: LINE_LABEL[product.line], href: `/shop#group-${product.line}` },
    { label: product.shortTitle, href: path },
  ]}
  width="wrap"
  jsonLd={[productSchema, faqSchema]}
  commerce
>
  <div data-sp-view="product_view" data-sp-props={trackProps}>
    <div class="pdp-top">
      <ProductGallery images={product.images} productName={product.title} />
      <div class="buybox">
        <span class="kicker">{ownedEyebrow(product)}</span>
        <h1>{product.title}</h1>
        <p class="buybox-dek">{product.note}</p>

        {product.inStock ? (
          <div class="buybox-purchase">
            <shopify-context type="product" handle={product.handle}>
              <template>
                <div class="buybox-commerce" data-commerce-ready>
                  <p class="buybox-price">
                    <shopify-money query="product.selectedOrFirstAvailableVariant.price" format="money_with_currency"></shopify-money>
                  </p>
                  <p class="buybox-stock" shopify-attr--hidden="!product.selectedOrFirstAvailableVariant.availableForSale">
                    <Icon name="check-circle" size={15} /> In stock
                  </p>
                  <p class="buybox-stock buybox-stock-out" shopify-attr--hidden="product.selectedOrFirstAvailableVariant.availableForSale">
                    {NOT_STOCKED_LABEL}. Shopify reopens purchasing as soon as inventory is available.
                  </p>
                  <button
                    class="btn btn-primary buybox-button"
                    type="button"
                    onclick="document.getElementById('sublime-cart').addLine(event).showModal();"
                    shopify-attr--disabled="!product.selectedOrFirstAvailableVariant.availableForSale"
                    data-sp-cart-add
                    data-sp-event="product_add_to_cart"
                    data-sp-props={trackProps}
                  >Add to cart</button>
                </div>
              </template>

              <div class="buybox-commerce" shopify-loading-placeholder>
                <p class="buybox-price">{product.displayPrice}</p>
                <p class="buybox-stock">Checking availability…</p>
                <a class="btn btn-secondary buybox-button" href={`https://${SHOPIFY_PUBLIC_DOMAIN}/products/${product.handle}`} rel="noopener" data-sp-event="storefront_placeholder_click" data-sp-props={trackProps}>View in our store</a>
              </div>
            </shopify-context>

            <p class="buybox-ships"><Icon name="package" size={15} /> {SHIPPING.rule}</p>

            <div class="commerce-fallback" data-commerce-fallback hidden>
              <p>Live pricing and checkout are temporarily unavailable on this page.</p>
              <a class="btn btn-secondary" href={`https://${SHOPIFY_PUBLIC_DOMAIN}/products/${product.handle}`} rel="noopener" data-sp-event="storefront_fallback_click" data-sp-props={trackProps}>View this product on our Shopify store</a>
            </div>
          </div>
        ) : (
          <div class="buybox-commerce">
            <p class="buybox-price">{product.displayPrice}</p>
            <p class="buybox-stock buybox-stock-out">{NOT_STOCKED_LABEL}</p>
            <p class="buybox-note">{stockNoteFor(product)}</p>
            <p class="buybox-note"><a class="btn-text" href="#newsletter-heading">Join the newsletter</a></p>
          </div>
        )}

        <ul class="trust-rows">
          <li><Icon name="shopping-bag" size={17} /> {OWNERSHIP_LABEL}, packed here</li>
          <li><Icon name="undo-2" size={17} /> <a href="/shipping-returns">30-day returns</a></li>
          <li><Icon name="shield-check" size={17} /> Secure Shopify checkout · <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
        </ul>
      </div>
    </div>

    <div class="pdp-body">
      <section class="two-up">
        <div>
          <h2>What's included</h2>
          <ul>{product.whatsIncluded.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div>
          <h2>What you'll still need</h2>
          <ul>
            {product.whatYoullNeed.map((item) => (
              <li>{item.href ? <a href={item.href}>{item.label}</a> : item.label}</li>
            ))}
          </ul>
        </div>
      </section>

      {/* docs/CLAUDE-CODE-PROMPT.md T4.4/T3.7. Only rendered when at least
          one real spec exists (src/lib/commerce.ts's `specs` field — every
          value there is copied from a fact this same product already
          states above, nothing invented) — a product with none yet doesn't
          get a SpecSheet full of em dashes. */}
      {product.specs && Object.values(product.specs).some(Boolean) && (
        <section aria-labelledby="specs-heading">
          <h2 id="specs-heading">Specs</h2>
          <SpecSheet productHandle={product.handle} />
        </section>
      )}

      {usedInGuides.length > 0 && (
        <section aria-labelledby="used-in-guides-heading">
          <h2 id="used-in-guides-heading">Used in these guides</h2>
          <ul class="used-in-guides-list">
            {usedInGuides.map((entry) => (
              <li><a href={articleHref(entry)}>{entry.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      <section>
        <h2>Highlights</h2>
        <ul>{product.highlights.map((item) => <li>{item}</li>)}</ul>
      </section>

      <section class="pantry-rationale" aria-labelledby="pantry-rationale-heading">
        <span class="kicker">Editorial note</span>
        <h2 id="pantry-rationale-heading">Why this is in the pantry</h2>
        <p>This item covers a specific packaging job in a deliberately small catalog: {product.note}</p>
        <p><strong>Testing status:</strong> Sublime Pantry has not independently bench-tested this product. Counts, dimensions and compatibility statements come from the supplier record and the active Shopify listing unless a source is named beside the claim.</p>
      </section>

      {productToolHref && <EditorialToolLink href={productToolHref} />}

      <section>
        <h2>Questions</h2>
        {product.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>

      <ProductReviews reviews={reviews} />
    </div>

    {related.length > 0 && (
      <div class="pdp-wide">
        <section>
          <div class="section-head">
            <h2>Related reading</h2>
            <a class="btn-text" href="/guides">All guides</a>
          </div>
          <ol class="related-ledger">
            {related.map((entry) => (
              <li>
                <span class="kicker">{entry.data.section ?? entry.data.kicker}</span>
                <h3><a href={articleHref(entry)}>{entry.data.title}</a></h3>
                <p>{entry.data.description}</p>
              </li>
            ))}
          </ol>
        </section>
      </div>
    )}

    {!product.inStock && <Newsletter heading="Hear when this lands" />}
  </div>

  {product.inStock && <StickyBuyBar product={product} />}
</PageLayout>

<style>
  .pdp-top { display: grid; gap: var(--s4); }
  @media (min-width: 900px) {
    .pdp-top { grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 1fr); align-items: start; }
    .buybox { position: sticky; top: 6rem; }
  }

  .buybox h1 { margin: 0 0 var(--s2); font-size: clamp(1.9rem, 3.4vw, 2.6rem); }
  .buybox-dek { color: var(--ink-soft); }

  .buybox-commerce { margin: var(--s3) 0 var(--s2); }
  .buybox-price {
    margin: 0 0 var(--s1);
    font-family: var(--font-display); font-size: var(--price);
    font-variant-numeric: tabular-nums; color: var(--ink);
  }
  .buybox-stock {
    margin: 0 0 var(--s2);
    display: flex; align-items: center; gap: .4rem;
    font-size: .92rem; color: var(--ok);
  }
  .buybox-stock-out { color: var(--ink-soft); font-weight: 600; }
  .buybox-note { margin: 0 0 var(--s1); font-size: .92rem; color: var(--ink-soft); }
  .buybox-button { width: 100%; max-width: 22rem; }
  .buybox-ships {
    margin: 0 0 var(--s3);
    display: flex; align-items: center; gap: .4rem;
    font-size: .9rem; color: var(--ink-soft);
  }

  .pdp-body { margin-top: var(--s5); }
  .pdp-body section { margin-bottom: var(--s5); }
  .two-up { display: grid; gap: var(--s4); }
  @media (min-width: 720px) { .two-up { grid-template-columns: 1fr 1fr; gap: var(--s5); } }

  .pdp-wide { margin-top: var(--s5); }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s2); }
  .pantry-rationale { padding: var(--s4); border-left: 4px solid var(--brand); background: var(--color-semantic-warm); }
  .pantry-rationale h2 { margin-top: .35rem; }
  .used-in-guides-list { list-style: none; margin: 0; padding: 0; }
  .used-in-guides-list li { border-top: 1px solid var(--mist); padding: var(--s2) 0; }
  .used-in-guides-list li:last-child { border-bottom: 1px solid var(--mist); }
  .related-ledger { list-style: decimal-leading-zero; padding-left: 2.5rem; border-top: 2px solid var(--ink); }
  .related-ledger li { padding: var(--s3) 0 var(--s3) var(--s2); border-bottom: 1px solid var(--mist); }
  .related-ledger h3 { margin: .35rem 0; font-family: var(--font-body); font-size: 1.25rem; }
  .related-ledger h3 a { color: var(--ink); }
  .related-ledger p { margin: 0; max-width: 64ch; color: var(--ink-soft); }
</style>
