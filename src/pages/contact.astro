---
import PageLayout from '../layouts/PageLayout.astro';
import { SUPPORT_EMAIL } from '../lib/paths';
---
<PageLayout title="Contact" description="Contact Sublime Pantry: report an error, ask a batch question, or suggest a topic." path="/contact" breadcrumbs={[{ label: "Contact", href: "/contact" }]}>
  <span class="kicker">Contact</span>
  <h1>Get in touch</h1>
  <p>Report an error, ask about a batch problem we haven't covered, or tell us what to research next. Reader questions drive our editorial queue.</p>
  <p>Prefer your own mail client, or writing about an order or a return? Email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> — it reaches the same person. For a return, please write before sending anything back; the <a href="/shipping-returns">returns process</a> explains why.</p>

  <div class="contact-panel">
    <form name="contact" method="POST" action="/message-received" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact" />
      <p hidden aria-hidden="true"><label>Don't fill this out: <input name="bot-field" /></label></p>

      <div class="field-grid">
        <div class="field">
          <label for="c-name">Name</label>
          <input id="c-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="c-email">Email</label>
          <input id="c-email" name="email" type="email" required autocomplete="email" />
        </div>
      </div>

      <div class="field">
        <label for="c-message">Message</label>
        <textarea id="c-message" name="message" rows="6" required></textarea>
      </div>

      <button class="btn btn-primary" type="submit">Send message</button>
    </form>
  </div>
</PageLayout>

<style>
  .contact-panel { padding: var(--s4); margin-top: var(--s4); background: var(--surface); border: 1px solid var(--mist); }
  .field { margin-bottom: var(--s3); }
  .field label { display: block; margin-bottom: .35rem; font-size: .9rem; }
  .field-grid { display: grid; gap: var(--s3); }
  @media (min-width: 560px) { .field-grid { grid-template-columns: 1fr 1fr; } }
  textarea { min-height: 9rem; resize: vertical; }
</style>

<script is:inline>
  /**
   * Marks that this tab really submitted the contact form, so
   * /message-received can show a success state without asserting one to a
   * visitor who simply opened the URL.
   */
  (function () {
    var form = document.querySelector('form[name="contact"]');
    if (!form) return;
    form.addEventListener('submit', function () {
      try {
        sessionStorage.setItem('sp-contact-submitted', String(Date.now()));
      } catch (err) {
        /* private mode: /message-received shows its neutral state */
      }
    });
  })();
</script>
