---
/**
 * The tools hub.
 *
 * Entries come from `TOOLS`, so a calculator added to that list appears here
 * without touching this file. Each entry leads with the question the tool
 * settles rather than the tool's name, because a reader deciding whether to
 * open something is matching it against a question they already have.
 */
import PageLayout from '../layouts/PageLayout.astro';
import { liveTools } from '../lib/tools';

const tools = liveTools();
const featured = tools.find((tool) => tool.homepageEmbed) ?? tools[0];
const rest = tools.filter((tool) => tool !== featured);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Free freeze-drying tools',
    description: 'Free tools for recording and comparing home freeze-drying batches.',
    url: 'https://www.sublimepantry.com/tools/',
    isPartOf: { '@id': 'https://www.sublimepantry.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: tools.map((tool, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://www.sublimepantry.com${tool.href}`,
        name: tool.name,
      })),
    },
  },
];
---
<PageLayout
  title="Free freeze-drying tools"
  description="Free tools for home freeze-drying: record what each batch cost, compare runs, and keep the details worth repeating. No account, and records stay in your browser."
  path="/tools"
  breadcrumbs={[{ label: 'Tools', href: '/tools' }]}
  width="wrap"
  jsonLd={jsonLd}
>
  <span class="kicker">Tools</span>
  <h1>Answer the question, then keep the answer.</h1>
  <p class="lede">Private calculators and a batch record for decisions worth checking twice. Each answer keeps its formula, source date and known gaps beside the result.</p>

  {featured && <article class="featured-tool" aria-labelledby="featured-tool-heading">
    <span class="kicker">Current utility</span>
    <p class="tool-question">{featured.answers}</p>
    <h2 id="featured-tool-heading" class="tool-name"><a href={featured.href} data-sp-event="tool_full_open" data-sp-props={JSON.stringify({ tool: featured.slug })}>{featured.name}</a></h2>
    <p class="tool-summary">{featured.summary}</p>
    <p class="tool-provenance"><strong>Data basis:</strong> {featured.provenance}</p>
    <a class="btn btn-primary" href={featured.href} data-sp-event="tool_full_open" data-sp-props={JSON.stringify({ tool: featured.slug })}>Open the calculator</a>
  </article>}

  <ol class="tool-ledger">
    {rest.map((tool, index) => (
      <li class="tool">
        <span class="tool-index" aria-hidden="true">{String(index + 2).padStart(2, '0')}</span>
        <div>
        <p class="tool-question">{tool.answers}</p>
        <h2 class="tool-name"><a href={tool.href} data-sp-event="tool_full_open" data-sp-props={JSON.stringify({ tool: tool.slug })}>{tool.name}</a></h2>
        <p class="tool-summary">{tool.summary}</p>
        <p class="tool-provenance"><strong>Data basis:</strong> {tool.provenance}</p>
        </div>
        <a class="btn-text tool-open" href={tool.href} data-sp-event="tool_full_open" data-sp-props={JSON.stringify({ tool: tool.slug })}>Open <span aria-hidden="true">↗</span></a>
      </li>
    ))}
  </ol>

  <section class="tool-note" aria-labelledby="tool-note-heading">
    <h2 id="tool-note-heading">What leaves this page</h2>
    <p>The four calculators send no inputs or results, use no cookies and save nothing. Batch Log stores its disclosed records only in this browser and can export CSV. There is no account or server copy. See our <a href="/privacy">privacy policy</a>.</p>
  </section>
</PageLayout>

<style>
  .featured-tool { margin-top: var(--s5); max-width: 58rem; padding: var(--s5); background: var(--color-brand-ice); }
  .featured-tool .tool-question { font-size: clamp(1.6rem, 3vw, 2.35rem); max-width: 30ch; }
  .tool-ledger { list-style: none; margin: var(--s5) 0 0; padding: 0; max-width: 64rem; border-top: 2px solid var(--ink); }
  .tool { display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto; gap: var(--s3); padding: var(--s3) 0; border-bottom: 1px solid var(--mist); align-items: start; }
  .tool-index { color: var(--brand); font-variant-numeric: tabular-nums; }
  .tool-question {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
  }
  .tool-name { margin: var(--s1) 0 0; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; }
  .tool-name a { color: var(--brand); text-decoration: none; }
  .tool-name a:hover { text-decoration: underline; }
  .tool-summary { margin: var(--s1) 0 0; color: var(--ink-soft); }
  .tool-provenance { margin: .5rem 0 0; color: var(--ink-soft); font-size: .9rem; }
  .tool-open { white-space: nowrap; }

  .tool-note { margin-top: var(--s5); padding: var(--s4) 0; max-width: 54rem; border-top: 1px solid var(--ink); }
  .tool-note h2 { margin: 0 0 var(--s2); font-size: var(--h3); }
  .tool-note p { color: var(--ink-soft); max-width: 66ch; margin: 0; }
  @media (max-width: 639px) {
    .featured-tool { padding: var(--s3); }
    .tool { grid-template-columns: 2rem minmax(0, 1fr); gap: var(--s2); }
    .tool-open { grid-column: 2; }
  }
</style>
