---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import Img from '../components/Img.astro';
import Mark from '../components/Mark.astro';
import Newsletter from '../components/Newsletter.astro';
import { CATALOG } from '../lib/commerce';
import { heroImage as articleHero, articleHref, type Article } from '../lib/articles';
import { findAsset, largest, srcSet } from '../lib/assets';

// The homepage hero asks the library for a wide brand frame and takes null for
// an answer — today there is no `brand` asset, so the mark panel renders. It
// used to resolve `/images/hero.jpg` against a hard-coded alt reading "Hands
// loading prepared food trays into a home freeze dryer", which meant the first
// file dropped at that path would ship that sentence to screen readers whatever
// it actually showed. Asking by intent makes that impossible: alt arrives with
// the photograph or there is no photograph.
const hero = findAsset({ cls: 'brand', ratio: '16:9', context: 'editorial' });
const heroFrame = hero ? largest(hero, '16:9') : null;

const articles = await getCollection('articles');
const byId = new Map(articles.map((entry) => [entry.id, entry]));
const startHere = ['complete-batch-workflow', 'which-freeze-dryer', 'home-freeze-dryers']
  .map((id) => byId.get(id))
  .filter((entry): entry is Article => Boolean(entry));
---
<BaseLayout
  title="Home freeze-drying, batch by batch"
  description="Sublime Pantry helps home freeze-drying enthusiasts and cottage sellers run better batches: machine decisions, troubleshooting, storage that lasts, and the economics of selling what you dry."
  path="/"
>
  <section class="hero module">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="kicker">For home freeze-driers &amp; cottage sellers</span>
        <h1>Home freeze-drying, batch by batch</h1>
        <p class="lede">Machine decisions, batch troubleshooting, storage that actually lasts, and the real economics of selling what you dry. Every claim is sourced, nothing invented.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/freeze-drying-starter-checklist" data-sp-event="hero_checklist_cta">Get the free Starter Checklist</a>
          <a class="btn btn-secondary" href="/guides/which-freeze-dryer">Which freeze dryer should you buy?</a>
        </div>
      </div>

      <div class="hero-media">
        {hero && heroFrame ? (
          <Img
            src={heroFrame.src}
            srcset={srcSet(hero, '16:9')}
            alt={hero.alt}
            width={heroFrame.w}
            height={heroFrame.h}
            sizes="(min-width: 900px) 34rem, 100vw"
            loading="eager"
            fetchpriority="high"
            class="hero-img"
          />
        ) : (
          <div class="hero-panel"><Mark height={120} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="module" aria-labelledby="start-here">
    <div class="wrap">
      <div class="section-head">
        <h2 id="start-here">Start here</h2>
        <a class="btn-text" href="/guides">All guides</a>
      </div>
      <div class="card-grid">
        {startHere.map((entry) => (
          <Card
            href={articleHref(entry)}
            title={entry.data.title}
            dek={entry.data.description}
            kicker={entry.data.section ?? entry.data.kicker}
            image={articleHero(entry)?.src}
            imageAlt={articleHero(entry)?.alt}
            transitionName={`sp-title-${entry.id}`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="module" aria-labelledby="shop-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="shop-heading">Packaging we sell</h2>
        <a class="btn-text" href="/shop">All packaging</a>
      </div>
      <p class="section-lede">A deliberately small catalog for storing what you dry, shipped free while we validate fulfillment.</p>
      <div class="card-grid">
        {CATALOG.map((product) => (
          <Card
            href={product.detailsHref ?? '/shop'}
            title={product.title}
            dek={product.note}
            kicker={product.eyebrow}
            image={product.image}
            imageAlt={product.imageAlt}
            ratio="4/5"
            fit="contain"
            price={product.displayPrice}
            meta="Ships free · US"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="module" aria-labelledby="batch-log-heading">
    <div class="wrap">
      <div class="card batch-log">
        <span class="kicker">Free tool</span>
        <h2 id="batch-log-heading">The Batch Log &amp; Cost Tracker</h2>
        <p>Log every batch: food, load weight, cycle hours, packaging, and water-activity readings. See your real cost per batch and per bag. Data stays in your browser; export to CSV anytime.</p>
        <a class="btn btn-primary" href="/tools/batch-log" data-sp-event="tool_promo_click">Start logging batches</a>
      </div>
    </div>
  </section>

  <section class="module">
    <div class="prose">
      <Newsletter />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-grid { display: grid; gap: var(--s4); align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1fr 1fr; gap: var(--s6); } }

  .hero-copy h1 { margin: 0 0 var(--s3); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--s2); margin-top: var(--s3); }

  .hero-media :global(.hero-img) {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
    border-radius: var(--radius); display: block;
  }
  .hero-panel {
    aspect-ratio: 16 / 9;
    display: grid; place-items: center;
    background: var(--brand-tint);
    border-radius: var(--radius);
  }

  .section-lede { color: var(--ink-soft); max-width: 60ch; margin-top: calc(var(--s2) * -1); margin-bottom: var(--s3); }

  .batch-log { padding: var(--s4); }
  .batch-log h2 { margin: 0 0 var(--s2); }
  .batch-log p { color: var(--ink-soft); max-width: 60ch; }
</style>
