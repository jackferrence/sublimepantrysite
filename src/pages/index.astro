---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialListing from '../components/EditorialListing.astro';
import EditorialToolLink from '../components/EditorialToolLink.astro';
import Newsletter from '../components/Newsletter.astro';
import Img from '../components/Img.astro';
import Packshot from '../components/figures/Packshot.astro';
import { CATALOG, SHIPPING } from '../lib/commerce';
import { liveTools, homepageTool } from '../lib/tools';
const articles = await getCollection('articles');
const lead = articles.filter(e => e.id === 'complete-batch-workflow');
const featuredTool = homepageTool() ?? liveTools()[0];
const otherTools = liveTools().filter(t => t !== featuredTool);
const routes = [
  { n: '01', title: 'Choose the machine', body: 'Capacity, circuits, operating conditions and running costs, with published limits kept visible.', href: '/compare/home-freeze-dryers', label: 'Compare the machines' },
  { n: '02', title: 'Run and troubleshoot batches', body: 'Preparation, dryness checks, vacuum faults and the notes worth keeping between runs.', href: '/troubleshooting', label: 'Start with the batch' },
  { n: '03', title: 'Package and store the result', body: 'Choose a container, size the absorber and verify the seal after the food is fully dry.', href: '/guides/mylar-absorber-myths', label: 'Finish the packaging job' },
];
---
<BaseLayout title="A field guide to home freeze-drying" description="Source-cited guidance for home freeze-drying: plan a batch, solve a problem, compare equipment and package the result." path="/">
  <div class="wrap home-publication">
    <header class="publication-intro">
      <span class="kicker">The home freeze-drying field guide</span>
      <h1>A better handle<br />on every batch.</h1>
      <div class="intro-note"><p>Practical answers for the work between loading the trays and sealing the bag. Sources you can follow. Limits made clear.</p><a href="/editorial-standards">How we publish <span aria-hidden="true">↗</span></a></div>
    </header>
    <section aria-label="Current field guide"><EditorialListing entries={lead} leadId="complete-batch-workflow" /></section>
    <section class="pathways" aria-labelledby="pathways-heading">
      <div class="section-label"><span class="kicker">Find your next step</span><h2 id="pathways-heading">What is on<br />your bench?</h2></div>
      <ol>{routes.map(route => <li><span class="path-number">{route.n}</span><div><h3><a href={route.href}>{route.title} <span aria-hidden="true">↗</span></a></h3><p>{route.body}</p></div></li>)}</ol>
    </section>
    <section class="workbench" aria-labelledby="workbench-heading">
      <div><span class="kicker">The workbench</span><h2 id="workbench-heading">Put numbers<br />to the next step.</h2><p>Use your own batch details. Keep the assumptions beside the answer.</p><a class="btn-text" href="/tools">All free tools →</a></div>
      <div class="workbench-tools">{featuredTool && <EditorialToolLink href={featuredTool.href} />}<ul>{otherTools.map(tool => <li><a href={tool.href} data-sp-event="tool_promo_click">{tool.name}<span aria-hidden="true">↗</span></a></li>)}</ul></div>
    </section>
    <section class="shop-shelf" aria-labelledby="shop-heading">
      <div class="section-head"><div><span class="kicker">From our own stock</span><h2 id="shop-heading">Ready for packaging.</h2></div><a class="btn-text" href="/shop">Visit the small shop →</a></div>
      <p class="shop-note">Choose packaging after checking the food. A bag and an absorber do not finish an under-dried batch.</p>
      <ul class="product-shelf">{CATALOG.slice(0,3).map(product => <li><a class="product-picture" href={product.detailsHref ?? '/shop'}>{product.image ? <Img src={product.image} alt={product.imageAlt} width={600} height={600} /> : <Packshot sku={product.handle} title={product.shortTitle} />}</a><span class="kicker">Sold by Sublime Pantry</span><h3><a href={product.detailsHref ?? '/shop'}>{product.title}</a></h3><p>{product.displayPrice}</p></li>)}</ul>
      <p class="meta">{SHIPPING.shortNote}</p>
    </section>
    <section class="evidence-note" aria-labelledby="evidence-heading"><span class="kicker">A note on the evidence</span><div><h2 id="evidence-heading">Read the sources.<br />Know the limits.</h2><p>Written and edited by <a href="/about">Jack Ferrence</a>. Our machine comparisons assess published specifications and documentation. <strong>We have not bench-tested freeze dryers.</strong></p><p><a href="/review-methodology">Review methodology</a> · <a href="/corrections">Public corrections</a></p></div></section>
    <div id="newsletter"><Newsletter heading="Notes for the next batch." /></div>
  </div>
</BaseLayout>
<style>
.home-publication { padding-top:var(--s5); }
.publication-intro { display:grid; grid-template-columns:1.35fr 1fr; column-gap:var(--s6); align-items:end; }
.publication-intro>.kicker { grid-column:1/-1; margin-bottom:var(--s3); }
.publication-intro h1 { font-size:clamp(3.4rem,7.3vw,6.5rem); line-height:.98; letter-spacing:-.045em; margin:0; }
.intro-note { max-width:39ch; padding-bottom:.5rem; }.intro-note p { font-size:1.15rem; line-height:1.5; margin:0 0 var(--s2); }
.pathways { display:grid; grid-template-columns:1fr 1.7fr; gap:var(--s6); padding:var(--s6) 0; }
.section-label h2,.workbench h2,.evidence-note h2 { font-size:clamp(2rem,4vw,3.25rem); line-height:1.08; margin:var(--s2) 0; }
.pathways ol { list-style:none; padding:0; margin:0; }.pathways li { display:grid; grid-template-columns:2rem 1fr; gap:var(--s3); border-top:1px solid var(--mist); padding:var(--s3) 0; }.pathways li:first-child { border-top:2px solid var(--ink); }.path-number { font-size:.85rem; color:var(--brand); padding-top:.4rem; }.pathways h3 { font-size:1.65rem; margin:0 0 .5rem; }.pathways h3 a { color:var(--ink); text-decoration:none; }.pathways h3 a:hover { text-decoration:underline; }.pathways p { margin:0; color:var(--ink-soft); max-width:55ch; }
.workbench { display:grid; grid-template-columns:1fr 1.35fr; gap:var(--s6); border-top:1px solid var(--ink); padding:var(--s5) 0; }.workbench>div>p { max-width:35ch; color:var(--ink-soft); }.workbench-tools :global(.editorial-tool) { margin:0; border-top:0; padding-top:0; }.workbench-tools ul { list-style:none; padding:0; margin:0; }.workbench-tools li { border-bottom:1px solid var(--mist); }.workbench-tools li a { display:flex; justify-content:space-between; padding:1rem 0; text-decoration:none; }.workbench-tools li a:hover { text-decoration:underline; }
.shop-shelf { padding:var(--s5) 0; border-top:1px solid var(--ink); }.shop-shelf h2 { margin:.5rem 0 0; }.shop-note { max-width:65ch; color:var(--ink-soft); }.product-shelf { display:grid; grid-template-columns:1.2fr 1fr 1fr; gap:var(--s4); list-style:none; padding:0; margin:var(--s4) 0; }.product-picture { display:block; margin-bottom:var(--s2); background:var(--surface); }.product-picture :global(img) { display:block; width:100%; aspect-ratio:1; object-fit:contain; }.product-shelf h3 { font-family:var(--font-body); font-size:1.15rem; line-height:1.35; margin:.4rem 0; }.product-shelf h3 a { color:var(--ink); text-decoration:none; }.product-shelf h3 a:hover { text-decoration:underline; }.product-shelf p { margin:0; }
.evidence-note { display:grid; grid-template-columns:1fr 1.7fr; gap:var(--s6); border-top:1px solid var(--ink); padding:var(--s5) 0; }.evidence-note p { max-width:58ch; }
@media(max-width:700px) { .publication-intro,.pathways,.workbench,.evidence-note { grid-template-columns:1fr; gap:var(--s3); }.publication-intro>.kicker { margin:0; }.intro-note { max-width:45ch; }.product-shelf { grid-template-columns:1fr; gap:var(--s4); }.product-shelf li { display:grid; grid-template-columns:7rem 1fr; column-gap:var(--s2); }.product-picture { grid-row:1/4; margin:0; }.product-shelf .kicker { align-self:end; font-size:.65rem; }.shop-shelf .section-head { align-items:start; }.home-publication { padding-top:var(--s4); } }
</style>
