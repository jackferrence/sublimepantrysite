# Per-page OG cards, regenerated by scripts/generate-og.mjs on every build.
public/og/

# Playwright MCP session artifacts (screenshots, console logs, snapshots).
.playwright-mcp/

# Camera-resolution originals over 5 MB. Their WebP derivatives under
# public/images/library/ ARE committed, so the site and its tests build without
# them; only `node assets/build-derivatives.mjs` needs them back. See
# assets/README.md for where they are kept.
assets/originals/camp-pouch-rehydrated-chili.png
assets/originals/camp-pouch-freeze-dried-vegetables.png
assets/originals/freeze-dryer-pair-loaded-trays.jpeg

# netlify-cli local build cache.
.netlify/

# Playwright test run artifacts (tests/a11y — T5.1).
test-results/
playwright-report/

# Lighthouse CI run artifacts (T5.2).
.lighthouseci/

# T5.5 visual-review screenshots (scripts/screenshot-templates.mjs) — 38MB
# for one run across 5 templates x 4 widths x 2 schemes; regenerable on
# demand, not something to keep committing new versions of on every design
# change. The script that produces them is the durable artifact.
docs/screens/
