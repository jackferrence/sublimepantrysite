{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://www.sublimepantry.com/schemas/draft-content.schema.json",
  "title": "DraftContent",
  "description": "Evidence-only draft output. Must satisfy the Astro content collection schema at src/content.config.ts. Every source cited must trace back to the evidence packet — the drafting model has no web access and cannot introduce new sources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "description", "kicker", "pillar", "riskClass", "disclosure", "sources", "bodyHtml"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 8 },
    "description": { "type": "string", "minLength": 20 },
    "kicker": { "type": "string" },
    "pillar": { "type": "string", "enum": ["guides", "troubleshooting", "compare"] },
    "riskClass": { "type": "string", "enum": ["standard", "elevated"] },
    "author": { "type": "string", "default": "Jack Ferrence" },
    "disclosure": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "publisher", "tier", "accessDate"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "publisher": { "type": "string" },
          "tier": { "type": "string", "enum": ["primary", "secondary"] },
          "accessDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "comparisonCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "bodyHtml": { "type": "string", "minLength": 200 },
    "claimSourceMap": {
      "description": "Maps each sentence/claim in bodyHtml back to an evidence packet claim id, for the verify phase.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "excerptFromBody"],
        "properties": {
          "claimId": { "type": "string" },
          "excerptFromBody": { "type": "string" }
        }
      }
    }
  }
}
