# Sublime Pantry — environment variables.
#
# NONE of these may ever be referenced from client-side code or committed with
# real values. Set them in Netlify (Site configuration → Environment variables).
# Astro only exposes variables prefixed with PUBLIC_ to the browser; none here
# use that prefix, by design.

# --- Shopify Admin API (server-side only: netlify/functions/lead-capture.mjs) ---
# Custom app access token from Shopify Admin → Settings → Apps and sales
# channels → Develop apps. Required scopes: write_customers, read_customers.
SHOPIFY_SHOP_DOMAIN=zd-store-01m146jmxxhw739y7t7y11s669-paky1ta3.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Judge.me (build-time only: src/lib/reviews.ts) ---
# Judge.me Admin → Settings → Integrations → View API tokens.
# Use the PRIVATE token. It is read at build time in Node and never shipped.
# Leave unset to build with no review section (the current, correct state).
JUDGEME_SHOP_DOMAIN=zd-store-01m146jmxxhw739y7t7y11s669-paky1ta3.myshopify.com
JUDGEME_PRIVATE_TOKEN=
